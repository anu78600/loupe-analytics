{
  "id": "telecom",
  "name": "Telecom",
  "tagline": "Subscriber base, ARPU, churn, usage, recharges and network quality for operators and ISPs",
  "description": "Monthly subscriber snapshots and usage extracts from BSS/OSS and billing systems, prepaid recharge data, customer churn tables (such as the Telco customer-churn format) and cell-site quality reports with call drops and availability, including Indian telecom circles and prepaid/postpaid splits.",
  "icon": "radio-tower",
  "entity": "subscriber",
  "goals": ["growth", "retention", "revenue", "quality"],
  "fields": [
    { "id": "subscriber_id", "label": "Subscriber / account ID", "roles": ["identifier", "dimension"], "synonyms": ["subscriber id", "subscriber", "customer id", "customer", "msisdn", "mobile number", "account id", "account number", "connection id", "subscription id", "service number", "sim number", "imsi", "line id", "phone number", "user id", "subs id"], "exclude": ["count", "type", "status", "name", "since", "segment", "plan", "calls"], "weight": 3, "core": true, "description": "One subscriber (line or account); repeats once per snapshot in monthly data." },
    { "id": "snapshot_date", "label": "Month / snapshot date", "roles": ["datetime"], "synonyms": ["snapshot date", "month", "billing month", "bill month", "report month", "as of date", "period", "date", "billing date", "bill date", "usage month", "month end", "cycle date", "data date", "report date", "usage date"], "exclude": ["activation", "join", "joining", "churn", "disconnection", "birth", "start", "port", "recharge", "expiry"], "weight": 2.5, "core": true },
    { "id": "activation_date", "label": "Activation date", "roles": ["datetime"], "synonyms": ["activation date", "activated on", "activation", "join date", "joining date", "date of joining", "doj", "connection date", "subscription start", "subscription start date", "customer since", "start date", "signup date", "sign up date", "onboarding date", "service start date"], "exclude": ["churn", "disconnection", "end", "recharge", "deactivation"], "weight": 1.2 },
    { "id": "churn_date", "label": "Churn / disconnection date", "roles": ["datetime"], "synonyms": ["churn date", "disconnection date", "deactivation date", "termination date", "cancellation date", "port out date", "exit date", "end date", "date of churn", "disconnect date"], "exclude": ["activation", "start", "join"], "weight": 0.8 },
    { "id": "plan_type", "label": "Plan type (prepaid / postpaid)", "roles": ["dimension"], "synonyms": ["plan type", "connection type", "subscription type", "account type", "payment type", "prepaid postpaid", "pre post", "billing type", "customer type", "service plan type"], "exclude": ["name", "id", "amount", "multiple", "method", "mode", "device", "handset", "sim", "os"], "valueHints": ["prepaid", "postpaid", "pre-paid", "post-paid", "hybrid", "corporate", "enterprise", "consumer"], "weight": 1.5 },
    { "id": "contract_type", "label": "Contract term", "roles": ["dimension"], "synonyms": ["contract", "contract type", "contract term", "commitment", "contract length", "lock in", "lock in period", "tenure plan"], "exclude": ["id", "date", "end", "start", "value"], "valueHints": ["month-to-month", "month to month", "one year", "two year", "12 months", "24 months", "no contract", "monthly", "annual"], "weight": 1 },
    { "id": "plan_name", "label": "Plan / tariff", "roles": ["dimension"], "synonyms": ["plan", "plan name", "tariff", "tariff plan", "rate plan", "pack", "pack name", "package", "bundle", "offer", "price plan", "product"], "exclude": ["type", "id", "amount", "date"], "weight": 0.8 },
    { "id": "circle", "label": "Circle / region", "roles": ["geo", "dimension"], "synonyms": ["circle", "telecom circle", "region", "zone", "state", "service area", "lsa", "market", "cluster", "territory", "area", "city"], "exclude": ["code", "id"], "valueHints": ["up east", "up west", "rest of bengal", "rest of maharashtra", "north east", "mumbai", "delhi", "kolkata", "karnataka", "kerala", "punjab", "gujarat", "andhra pradesh", "tamil nadu", "rajasthan", "madhya pradesh"], "weight": 1.2 },
    { "id": "service_type", "label": "Service / technology", "roles": ["dimension"], "synonyms": ["service type", "service", "technology", "network type", "internet service", "connection technology", "access type", "line of business", "product line", "lob", "network"], "exclude": ["id", "status", "number", "date", "call", "area", "customer", "availability", "device", "handset", "payment", "contract"], "valueHints": ["4g", "5g", "3g", "2g", "lte", "volte", "fiber", "fibre", "fiber optic", "dsl", "broadband", "ftth", "mobile", "fixed line", "landline", "dth"], "weight": 1 },
    { "id": "subscriber_status", "label": "Subscriber status", "roles": ["dimension"], "synonyms": ["status", "subscriber status", "account status", "connection status", "sim status", "service status", "customer status", "subscription status"], "exclude": ["payment", "plan", "kyc", "multiple", "method", "billing", "paperless"], "valueHints": ["active", "inactive", "churned", "suspended", "barred", "disconnected", "deactivated", "ported out", "grace", "dormant"], "weight": 1.5 },
    { "id": "is_churned", "label": "Churned flag", "roles": ["boolean"], "synonyms": ["churn", "churned", "is churned", "churn flag", "attrition", "exited", "left", "disconnected", "ported out", "churn status", "is churn", "churn label"], "exclude": ["date", "reason", "score", "probability", "risk"], "weight": 2, "core": true },
    { "id": "revenue", "label": "Revenue / monthly bill", "roles": ["currency", "measure"], "synonyms": ["revenue", "monthly revenue", "total revenue", "billed amount", "bill amount", "billing amount", "invoice amount", "monthly charges", "monthly charge", "monthly bill", "charges", "amount", "arpu", "gross revenue", "net revenue", "usage revenue"], "exclude": ["recharge", "topup", "lifetime", "cumulative", "data", "voice", "sms", "roaming"], "weight": 2.5, "core": true, "description": "Revenue billed to the subscriber in the snapshot period (a per-subscriber ARPU column also works)." },
    { "id": "lifetime_charges", "label": "Lifetime / total charges", "roles": ["currency", "measure"], "synonyms": ["total charges", "lifetime charges", "lifetime revenue", "lifetime value", "ltv", "cumulative charges", "cumulative revenue", "total billed", "total billing"], "weight": 0.8 },
    { "id": "recharge_amount", "label": "Recharge amount", "roles": ["currency", "measure"], "synonyms": ["recharge amount", "recharge", "recharge value", "top up amount", "topup amount", "top up", "topup", "recharge mrp", "voucher amount", "recharge denomination", "total recharge amount", "rech amt"], "exclude": ["count", "number", "date", "frequency"], "weight": 1.5 },
    { "id": "recharge_count", "label": "Number of recharges", "roles": ["measure"], "synonyms": ["recharge count", "no of recharges", "number of recharges", "recharge frequency", "rech num", "topup count", "total recharge number", "recharges done"], "exclude": ["amount", "value", "date"], "weight": 0.8 },
    { "id": "data_usage_gb", "label": "Data usage (GB)", "roles": ["measure"], "synonyms": ["data usage", "data usage gb", "data used", "data consumption", "data volume", "data gb", "gb used", "mobile data", "internet usage", "data traffic", "total data", "data usage in gb", "payload", "data payload"], "exclude": ["revenue", "charge", "amount", "plan", "limit", "pack", "mb", "kb"], "weight": 1.5 },
    { "id": "voice_minutes", "label": "Voice minutes", "roles": ["measure"], "synonyms": ["voice minutes", "minutes", "mou", "minutes of use", "call minutes", "talk time", "voice usage", "total minutes", "outgoing minutes", "total day minutes", "usage minutes", "voice mou"], "exclude": ["revenue", "charge", "amount", "plan", "free", "limit", "remaining"], "weight": 1.5 },
    { "id": "sms_count", "label": "SMS sent", "roles": ["measure"], "synonyms": ["sms", "sms count", "messages", "text messages", "sms sent", "no of sms", "sms usage"], "exclude": ["revenue", "charge", "amount", "vmail", "voicemail"], "weight": 0.5 },
    { "id": "tenure_months", "label": "Tenure (months)", "roles": ["measure"], "synonyms": ["tenure", "tenure months", "tenure in months", "months on network", "customer tenure", "months with company", "months as customer", "subscription months", "months active"], "exclude": ["days", "plan"], "weight": 1.5 },
    { "id": "complaints", "label": "Complaints", "roles": ["measure"], "synonyms": ["complaints", "complaint count", "no of complaints", "number of complaints", "customer service calls", "care calls", "number customer service calls", "service tickets", "grievances", "service requests", "tickets raised"], "exclude": ["resolved", "closed", "date", "type", "reason"], "weight": 1 },
    { "id": "dropped_calls", "label": "Dropped calls", "roles": ["measure"], "synonyms": ["dropped calls", "call drops", "drops", "dropped", "call drop count", "dropped call count", "drop calls", "abnormal releases", "dropped voice calls"], "exclude": ["rate", "percent", "ratio"], "weight": 1.5 },
    { "id": "total_calls", "label": "Total calls", "roles": ["measure"], "synonyms": ["total calls", "calls", "call attempts", "calls attempted", "call count", "number of calls", "calls made", "call volume", "voice calls", "total day calls", "successful calls", "calls handled"], "exclude": ["dropped", "drop", "customer", "service", "care", "complaint", "minutes", "charge", "failed", "blocked"], "weight": 1.2 },
    { "id": "site_id", "label": "Cell site / tower", "roles": ["identifier", "dimension"], "synonyms": ["site id", "cell id", "tower id", "site", "cell site", "bts id", "enodeb id", "gnodeb id", "node id", "cell name", "site name", "tower", "site code", "cell"], "exclude": ["type", "availability", "count"], "weight": 1.5 },
    { "id": "availability_pct", "percentScale": 1, "label": "Site availability %", "roles": ["percentage", "rate"], "synonyms": ["availability", "site availability", "network availability", "cell availability", "uptime", "availability percent", "uptime percent", "service availability", "tch availability"], "exclude": ["data", "minutes", "count"], "weight": 1.2, "description": "Share of the period a site was in service; each row should cover the same length of time (e.g. one site-day)." }
  ],
  "valueClasses": {
    "plan_type": [
      { "id": "postpaid", "label": "Postpaid", "keywords": ["postpaid", "post-paid", "post paid", "postpay", "billed monthly", "contract"] },
      { "id": "prepaid", "label": "Prepaid", "keywords": ["prepaid", "pre-paid", "pre paid", "prepay", "pay as you go", "pay-as-you-go", "payg"] }
    ],
    "subscriber_status": [
      { "id": "churned", "label": "Churned / disconnected", "keywords": ["churned", "churn", "disconnected", "deactivated", "terminated", "ported out", "port out", "mnp out", "cancelled", "canceled", "closed", "left", "permanently inactive"] },
      { "id": "suspended", "label": "Suspended / inactive", "keywords": ["suspended", "barred", "inactive", "dormant", "grace", "grace period", "blocked", "soft barred", "hard barred", "on hold", "idle"] },
      { "id": "active", "label": "Active", "keywords": ["active", "live", "in service", "connected", "working", "activated"] }
    ]
  },
  "subDomains": [
    { "id": "subscribers", "name": "Subscriber base & usage", "description": "One row per subscriber per month (or other snapshot) with plan, revenue, usage, recharges and churn flag.", "signals": ["subscriber_id", "snapshot_date", "plan_type", "revenue", "data_usage_gb", "voice_minutes", "recharge_amount", "is_churned", "circle"], "grain": "subscriber-month" },
    { "id": "churn", "name": "Customer churn table", "description": "One row per subscriber with tenure, contract, monthly charges and whether they churned.", "signals": ["subscriber_id", "tenure_months", "contract_type", "revenue", "is_churned", "service_type", "lifetime_charges", "complaints"], "grain": "subscriber", "timeModel": "roster" },
    { "id": "network", "name": "Network quality", "description": "One row per cell site per day (or hour) with calls, drops, traffic and availability.", "signals": ["site_id", "snapshot_date", "circle", "dropped_calls", "total_calls", "availability_pct", "data_usage_gb"], "grain": "site-day" }
  ],
  "kpis": [
    { "id": "active_base", "name": "Active subscribers (any date)", "definition": "Distinct subscribers in context who have not churned, before picking the latest snapshot.", "formula": "Distinct subscribers excluding churned ones", "format": "integer", "direction": "higher", "tier": "detail", "priority": 50, "group": "Base", "hidden": true,
      "variants": [
        { "id": "flag", "label": "Not flagged as churned", "expr": { "agg": "countDistinct", "of": "subscriber_id", "where": { "field": "is_churned", "isFalse": true } } },
        { "id": "status", "label": "Status not churned", "expr": { "agg": "countDistinct", "of": "subscriber_id", "where": { "field": "subscriber_status", "notClass": "churned" } } },
        { "id": "churn_date", "label": "No churn date", "expr": { "agg": "countDistinct", "of": "subscriber_id", "where": { "field": "churn_date", "isNull": true } }, "caveat": "No churn flag or status, so subscribers without a churn date count as active." },
        { "id": "all", "label": "All subscribers", "expr": { "agg": "countDistinct", "of": "subscriber_id" }, "caveat": "No churn flag, status or date, so every subscriber counts as active." }
      ] },
    { "id": "subscribers", "name": "Subscribers", "aliases": ["Subscriber base", "Active subscribers", "Subs", "Total subscribers", "VLR subscribers"], "definition": "Active subscribers on the latest snapshot date in the period (closing base).", "formula": "Distinct subscribers not churned, on the latest snapshot date (semi-additive)", "format": "integer", "direction": "higher", "tier": "hero", "priority": 1, "group": "Base", "subDomains": ["subscribers", "churn"],
      "variants": [
        { "id": "latest", "label": "Latest snapshot", "expr": { "atLatest": "snapshot_date", "expr": { "ref": "active_base" } } },
        { "id": "single", "label": "Single snapshot", "expr": { "ref": "active_base" }, "caveat": "No snapshot date, so the file is treated as one point-in-time snapshot." }
      ],
      "pitfalls": ["The base is a closing balance: each period shows its latest snapshot; months are never added together."] },
    { "id": "revenue_total", "name": "Revenue", "definition": "Total revenue billed to subscribers in the period.", "formula": "Sum of revenue", "format": "currency", "direction": "higher", "tier": "hero", "priority": 2, "group": "Revenue", "subDomains": ["subscribers", "churn"],
      "variants": [{ "id": "sum", "label": "Sum of revenue", "expr": { "agg": "sum", "of": { "field": "revenue" } } }] },
    { "id": "avg_subscribers", "name": "Average subscribers", "aliases": ["Average subscriber base", "Average subs"], "definition": "Average number of subscribers per snapshot across the period.", "formula": "Average over snapshot dates of distinct subscribers", "format": "number", "direction": "higher", "tier": "supporting", "priority": 8, "group": "Base", "subDomains": ["subscribers", "churn"],
      "variants": [
        { "id": "per_snapshot", "label": "Average distinct subscribers per snapshot", "expr": { "per": "snapshot_date", "inner": { "agg": "countDistinct", "of": "subscriber_id" }, "reduce": "avg" } },
        { "id": "single", "label": "Distinct subscribers", "expr": { "agg": "countDistinct", "of": "subscriber_id" }, "caveat": "No snapshot date, so every subscriber in the file is counted once." }
      ] },
    { "id": "arpu", "name": "ARPU", "aliases": ["Average revenue per user", "Average revenue per subscriber", "ARPS", "Blended ARPU"], "definition": "Revenue per average subscriber over the selected period; for a single month this is monthly ARPU.", "formula": "Revenue ÷ average subscribers per snapshot (ratio of totals, not an average of individual bills)", "format": "currency", "direction": "higher", "tier": "hero", "priority": 3, "group": "Revenue", "subDomains": ["subscribers", "churn"],
      "variants": [{ "id": "ratio", "label": "Revenue ÷ average subscribers", "expr": { "op": "div", "args": [{ "ref": "revenue_total" }, { "ref": "avg_subscribers" }] } }],
      "pitfalls": ["Over a quarter or a year this is revenue per subscriber for the whole period; divide by the number of months for a monthly figure."] },
    { "id": "churned_subscribers", "name": "Churned subscribers", "aliases": ["Disconnections", "Deactivations", "Subscribers lost", "Churned subs"], "definition": "Distinct subscribers who churned in the period.", "formula": "Distinct subscribers flagged or marked as churned", "format": "integer", "direction": "lower", "tier": "supporting", "priority": 9, "group": "Churn", "subDomains": ["subscribers", "churn"],
      "variants": [
        { "id": "flag", "label": "Churn flag", "expr": { "agg": "countDistinct", "of": "subscriber_id", "where": { "field": "is_churned", "isTrue": true } } },
        { "id": "status", "label": "Churned status", "expr": { "agg": "countDistinct", "of": "subscriber_id", "where": { "field": "subscriber_status", "class": "churned" } } },
        { "id": "churn_date", "label": "Has a churn date", "expr": { "agg": "countDistinct", "of": "subscriber_id", "where": { "field": "churn_date", "notNull": true } }, "caveat": "No churn flag or status, so subscribers with a churn date count as churned." }
      ] },
    { "id": "unique_subscribers", "name": "Subscribers served", "definition": "Distinct subscribers that appear anywhere in the period, including those who churned.", "formula": "Count of distinct subscriber IDs", "format": "integer", "direction": "higher", "tier": "detail", "priority": 40, "group": "Base", "subDomains": ["subscribers", "churn"],
      "variants": [{ "id": "distinct", "label": "Distinct subscribers", "expr": { "agg": "countDistinct", "of": "subscriber_id" } }] },
    { "id": "churn_rate", "name": "Churn rate", "aliases": ["Churn %", "Churn", "Monthly churn", "Subscriber churn", "Churn rate %"], "definition": "Share of the period's subscribers who churned.", "formula": "Churned subscribers ÷ distinct subscribers in the period", "format": "percent", "direction": "lower", "tier": "hero", "priority": 4, "group": "Churn", "subDomains": ["subscribers", "churn"],
      "variants": [{ "id": "ratio", "label": "Churned ÷ subscribers served", "expr": { "op": "div", "args": [{ "ref": "churned_subscribers" }, { "ref": "unique_subscribers" }] } }],
      "benchmark": { "low": 0.01, "high": 0.03, "note": "Indicative monthly churn for postpaid mobile; prepaid runs several times higher, and longer windows read higher." },
      "pitfalls": ["Churn depends on the window: a month reads lower than a quarter or a year, so compare equal periods."] },
    { "id": "data_per_sub", "name": "Data usage per subscriber", "aliases": ["Data per sub", "Data usage per user", "GB per subscriber", "MB per subscriber"], "definition": "Data used per average subscriber in the period, in the file's unit (usually GB).", "formula": "Σ data usage ÷ average subscribers", "format": "decimal", "direction": "higher", "tier": "hero", "priority": 5, "group": "Usage", "subDomains": ["subscribers"],
      "variants": [{ "id": "ratio", "label": "Data usage ÷ average subscribers", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "data_usage_gb" } }, { "ref": "avg_subscribers" }] } }],
      "pitfalls": ["Check units: a column in MB reads 1,000 times larger than GB."] },
    { "id": "dropped_call_rate", "name": "Dropped call rate", "aliases": ["Call drop rate", "DCR", "Call drop %", "Dropped calls %"], "definition": "Share of calls that dropped before completion.", "formula": "Σ dropped calls ÷ Σ calls", "format": "percent", "direction": "lower", "tier": "hero", "priority": 6, "group": "Network", "subDomains": ["subscribers", "network"],
      "variants": [{ "id": "ratio", "label": "Dropped ÷ total calls", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "dropped_calls" } }, { "agg": "sum", "of": { "field": "total_calls" } }] } }],
      "benchmark": { "high": 0.02, "note": "Indicative ceiling: regulators such as TRAI cap network-wide call drops at about 2% or lower." },
      "pitfalls": ["A ratio of totals: never average per-site or per-day drop rates, which over-weights quiet sites."] },
    { "id": "mou_per_sub", "name": "Minutes of use per subscriber", "short": "MOU", "aliases": ["MoU per sub", "Minutes of usage per subscriber", "Minutes of use"], "definition": "Voice minutes per average subscriber in the period.", "formula": "Σ voice minutes ÷ average subscribers", "format": "number", "direction": "higher", "tier": "supporting", "priority": 7, "group": "Usage", "subDomains": ["subscribers"],
      "variants": [{ "id": "ratio", "label": "Minutes ÷ average subscribers", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "voice_minutes" } }, { "ref": "avg_subscribers" }] } }] },
    { "id": "data_traffic", "name": "Data traffic", "aliases": ["Data usage", "Data consumed", "Total data traffic", "Data volume"], "definition": "Total data used on the network in the period, in the file's unit (usually GB).", "formula": "Sum of data usage", "format": "number", "direction": "higher", "tier": "supporting", "priority": 10, "group": "Usage", "subDomains": ["subscribers", "network"],
      "variants": [{ "id": "sum", "label": "Sum of data usage", "expr": { "agg": "sum", "of": { "field": "data_usage_gb" } } }] },
    { "id": "new_subscribers", "name": "New subscribers", "aliases": ["Gross adds", "Gross additions", "New activations", "New connections"], "definition": "Subscribers whose first snapshot in the file falls in the period (gross adds).", "formula": "Subscribers whose earliest snapshot date is in the period", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 11, "group": "Base", "subDomains": ["subscribers"],
      "variants": [{ "id": "first_seen", "label": "First snapshot in period", "expr": { "newEntities": "subscriber_id", "date": "snapshot_date" } }],
      "pitfalls": ["Everyone in the file's first month looks new; trust gross adds from the second month on."] },
    { "id": "postpaid_mix", "name": "Postpaid mix", "aliases": ["Postpaid share", "Postpaid %", "Postpaid mix %"], "definition": "Postpaid share of the active subscriber base at the latest snapshot.", "formula": "Active postpaid subscribers ÷ active subscribers, on the latest snapshot date", "format": "percent", "direction": "neutral", "tier": "supporting", "priority": 12, "group": "Base", "subDomains": ["subscribers", "churn"],
      "variants": [
        { "id": "latest", "label": "Latest snapshot", "expr": { "atLatest": "snapshot_date", "expr": { "op": "div", "args": [{ "calc": { "ref": "active_base" }, "where": { "field": "plan_type", "class": "postpaid" } }, { "ref": "active_base" }] } } },
        { "id": "single", "label": "Single snapshot", "expr": { "op": "div", "args": [{ "calc": { "ref": "active_base" }, "where": { "field": "plan_type", "class": "postpaid" } }, { "ref": "active_base" }] }, "caveat": "No snapshot date, so the file is treated as one point-in-time snapshot." }
      ] },
    { "id": "avg_recharge_value", "name": "Average recharge value", "aliases": ["ARV", "Average recharge", "Recharge value"], "definition": "Average value of a prepaid recharge (top-up).", "formula": "Σ recharge amount ÷ number of recharges", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 13, "group": "Revenue", "subDomains": ["subscribers"],
      "variants": [
        { "id": "count_col", "label": "Recharge amount ÷ recharge count", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "recharge_amount" } }, { "agg": "sum", "of": { "field": "recharge_count" } }] } },
        { "id": "rows", "label": "Recharge amount ÷ rows with a recharge", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "recharge_amount" } }, { "agg": "count", "where": { "field": "recharge_amount", "cmp": "gt", "value": 0 } }] }, "caveat": "No recharge count, so each row with a recharge amount counts as one recharge." }
      ] },
    { "id": "complaints_per_1000", "name": "Complaints per 1,000 subscribers", "aliases": ["Complaints per 1000 subs", "Complaints per thousand subscribers"], "definition": "Complaints logged per 1,000 average subscribers in the period.", "formula": "Σ complaints ÷ average subscribers × 1,000", "format": "number", "direction": "lower", "tier": "supporting", "priority": 14, "group": "Experience", "subDomains": ["subscribers", "churn"],
      "variants": [{ "id": "ratio", "label": "Complaints ÷ average subscribers × 1,000", "expr": { "op": "mul", "args": [{ "op": "div", "args": [{ "agg": "sum", "of": { "field": "complaints" } }, { "ref": "avg_subscribers" }] }, { "num": 1000 }] } }] },
    { "id": "avg_tenure", "name": "Average tenure (months)", "aliases": ["AON", "Age on network", "Average age on network"], "definition": "Average months subscribers in the latest snapshot have been on the network.", "formula": "Average tenure on the latest snapshot date", "format": "decimal", "direction": "higher", "tier": "supporting", "priority": 15, "group": "Churn", "subDomains": ["subscribers", "churn"],
      "variants": [
