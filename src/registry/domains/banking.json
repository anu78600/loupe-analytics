    { "id": "default_flag", "label": "Default indicator", "roles": ["boolean"], "synonyms": ["default", "defaulted", "npa", "bad", "charged off", "written off", "write off"], "exclude": ["history", "previous", "prior", "on file", "cb", "date", "amount", "reason"], "weight": 1.5 },
    { "id": "collateral_value", "label": "Collateral value", "roles": ["currency", "measure"], "synonyms": ["collateral value", "security value", "property value", "asset value", "collateral amount", "market value", "valuation", "valuation amount", "gold value", "vehicle value", "collateral", "security"], "exclude": ["type", "id", "description", "ltv", "ratio", "loan", "funded", "disbursed", "sanctioned", "emi", "due", "paid", "overdue", "interest", "principal", "fee", "insurance", "provision", "requested", "collected"], "weight": 1 },
    { "id": "amount_due", "label": "Amount due (demand)", "roles": ["currency", "measure"], "synonyms": ["amount due", "due amount", "emi due", "demand", "demand amount", "installment due", "instalment due", "total due", "dues", "scheduled amount", "expected collection", "emi amount", "emi", "installment amount", "instalment amount", "billed amount", "installment"], "exclude": ["overdue", "collected", "paid", "received", "date", "count", "outstanding", "past", "funded", "loan", "sanctioned", "disbursed", "collateral", "requested", "fee", "insurance"], "weight": 1.5 },
    { "id": "amount_collected", "label": "Amount collected", "roles": ["currency", "measure"], "synonyms": ["amount collected", "collected amount", "collection amount", "collection", "collections", "amount paid", "paid amount", "payment received", "amount received", "received amount", "emi collected", "emi paid", "repayment amount", "total payment", "total pymnt", "recovery amount", "recovered amount"], "exclude": ["due", "demand", "date", "mode", "efficiency", "rate", "percent", "inv", "disbursed", "sanctioned", "funded", "loan", "overdue", "outstanding", "requested", "collateral", "fee"], "weight": 1.5 },
    { "id": "credit_score", "label": "Credit score", "roles": ["measure", "rate"], "synonyms": ["credit score", "cibil score", "cibil", "bureau score", "fico", "fico score", "experian score", "crif score", "credit rating score", "risk score", "score"], "exclude": ["behaviour", "behavior", "internal", "fraud"], "weight": 1.2 },
    { "id": "risk_grade", "label": "Risk grade", "roles": ["dimension"], "synonyms": ["grade", "loan grade", "risk grade", "credit grade", "sub grade", "risk band", "risk category", "internal rating", "rating"], "exclude": ["score", "employee", "staff"], "valueHints": ["low risk", "medium risk", "high risk", "grade a", "grade b", "grade c"], "weight": 0.8 },
    { "id": "income", "label": "Borrower income", "roles": ["currency", "measure"], "synonyms": ["annual income", "income", "applicant income", "monthly income", "person income", "borrower income", "gross income", "annual inc", "net monthly income", "salary"], "exclude": ["coapplicant", "co", "household", "interest", "fee"], "weight": 0.6 },
    { "id": "application_date", "label": "Application date", "roles": ["datetime"], "synonyms": ["application date", "applied date", "application datetime", "app date", "lead date", "login date", "submission date", "date applied", "date of application"], "exclude": ["decision", "approval", "disbursement", "sanction", "rejection"], "weight": 1.2 },
    { "id": "decision_date", "label": "Decision date", "roles": ["datetime"], "synonyms": ["decision date", "approval date", "approved date", "rejection date", "rejected date", "credit decision date", "underwriting date", "decisioned at", "decision datetime"], "exclude": ["application", "disbursement", "sanction", "applied"], "weight": 1 },
    { "id": "application_status", "label": "Application decision", "roles": ["dimension"], "synonyms": ["application status", "decision", "approval status", "underwriting decision", "credit decision", "loan decision", "approval", "lead status", "case status"], "exclude": ["account", "kyc", "payment", "emi", "collection", "date", "reason"], "valueHints": ["approved", "rejected", "declined", "pending", "sanctioned", "withdrawn", "in process", "under review"], "weight": 1.5 },
    { "id": "channel", "label": "Sourcing channel", "roles": ["dimension"], "synonyms": ["channel", "sourcing channel", "source", "lead source", "origination channel", "acquisition channel", "dsa", "dsa name", "connector", "sourcing"], "valueHints": ["branch", "dsa", "online", "digital", "direct", "connector", "partner", "dst", "web", "app", "referral"], "weight": 0.6 }
  ],
  "valueClasses": {
