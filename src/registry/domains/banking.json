    ],
    "asset_classification": [
      { "id": "npa", "label": "NPA (sub-standard, doubtful, loss)", "keywords": ["npa", "non performing", "nonperforming", "sub standard", "substandard", "doubtful", "loss", "stage 3", "d1", "d2", "d3"] },
      { "id": "sma", "label": "SMA / stage 2", "keywords": ["sma", "special mention", "sma 0", "sma 1", "sma 2", "stage 2", "watch"] },
      { "id": "standard", "label": "Standard", "keywords": ["standard", "regular", "performing", "stage 1", "std", "pass"] }
    ],
