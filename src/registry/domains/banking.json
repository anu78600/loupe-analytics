{
  "id": "banking",
  "name": "Banking & Lending",
  "tagline": "Loan book, disbursements, pricing, delinquency, NPAs, collections and approvals",
  "description": "Loan management system and core banking extracts for retail, MSME, gold-loan and microfinance portfolios: loan-level books with DPD and asset classification, disbursement registers, EMI demand and collection files and loan application pipelines, including Indian-market fields such as LAN, CIF, POS, DPD, SMA and NPA.",
  "icon": "landmark",
  "entity": "loan",
  "goals": ["growth", "asset quality", "collections"],
  "fields": [
    { "id": "loan_id", "label": "Loan account ID", "roles": ["identifier", "dimension"], "synonyms": ["loan id", "loan number", "loan no", "loan account number", "loan account no", "loan account", "lan", "account number", "account no", "account id", "agreement number", "agreement no", "contract number", "contract id", "facility id", "deal id", "loan reference"], "exclude": ["customer", "application", "branch", "product", "type", "amount", "status", "date", "officer", "purpose", "holder", "grade", "intent", "term", "percent"], "weight": 3, "core": true, "description": "Identifies each loan; repeats on every row when the file is a monthly snapshot or an instalment schedule." },
