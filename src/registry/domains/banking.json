    { "id": "state", "label": "State", "roles": ["geo", "dimension"], "synonyms": ["state", "branch state", "customer state", "borrower state", "addr state", "state ut"], "exclude": ["name", "id", "type", "segment", "status"], "weight": 0.8 },
    { "id": "disbursement_date", "label": "Disbursement date", "roles": ["datetime"], "synonyms": ["disbursement date", "disbursal date", "disbursed date", "date of disbursement", "disbursed on", "loan date", "booking date", "sanction date", "origination date", "open date", "account open date", "opening date", "start date", "issue date", "issue d", "funded date", "value date", "date"], "exclude": ["maturity", "closure", "closed", "close", "due", "payment", "collection", "as", "snapshot", "report", "reporting", "application", "birth", "last", "next", "npa", "default", "write", "decision", "approval", "end", "expiry"], "weight": 3, "core": true },
    { "id": "as_of_date", "label": "As-of / snapshot date", "roles": ["datetime"], "synonyms": ["as of date", "as on date", "as at date", "snapshot date", "report date", "reporting date", "position date", "balance date", "month end", "month end date", "eom date", "data date", "cut off date", "cutoff date", "period end date", "mis date", "extraction date", "business date"], "exclude": ["disbursement", "due", "payment", "maturity", "application"], "weight": 1.5 },
