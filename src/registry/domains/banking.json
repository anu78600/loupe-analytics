    { "id": "requested_amount", "label": "Requested amount", "roles": ["currency", "measure"], "synonyms": ["requested amount", "amount requested", "loan amount requested", "applied amount", "amount applied", "applied loan amount", "request amount", "proposed amount", "required amount", "loan required"], "exclude": ["approved", "sanctioned", "disbursed", "funded", "status", "term", "tenure", "grade"], "weight": 1 },
    { "id": "interest_rate", "label": "Interest rate", "roles": ["rate", "percentage"], "synonyms": ["interest rate", "rate of interest", "roi", "int rate", "loan int rate", "annual interest rate", "interest rate percent", "interest percent", "lending rate", "apr", "coupon rate", "coupon", "rate"], "exclude": ["penal", "penalty", "overdue", "late", "tax", "processing", "fee", "default", "approval", "rejection", "collection", "exchange"], "weight": 2, "description": "Stored either as points (10.5) or as a fraction (0.105); weighted averages keep the column's unit." },
