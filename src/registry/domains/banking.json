    { "id": "asset_classification", "label": "Asset classification", "roles": ["dimension"], "synonyms": ["asset classification", "asset class", "asset category", "classification", "npa status", "npa classification", "irac status", "asset quality", "account classification", "ecl stage", "ifrs stage", "sma status", "stage"], "exclude": ["application", "process", "lead"], "valueHints": ["standard", "sma-0", "sma-1", "sma-2", "sub-standard", "substandard", "doubtful", "loss", "npa", "stage 1", "stage 2", "stage 3"], "weight": 1.5 },
