      { "id": "rejected", "label": "Rejected", "keywords": ["rejected", "reject", "declined", "denied", "not approved", "turned down", "n", "no"] },
      { "id": "withdrawn", "label": "Withdrawn / cancelled", "keywords": ["withdrawn", "cancelled", "canceled", "dropped", "not interested", "abandoned"] },
      { "id": "approved", "label": "Approved", "keywords": ["approved", "sanctioned", "accepted", "disbursed", "conditionally approved", "y", "yes"] },
      { "id": "pending", "label": "Pending", "keywords": ["pending", "in process", "in progress", "under review", "submitted", "awaiting", "on hold", "hold", "query", "new", "open", "received"] }
    ]
  },
  "subDomains": [
    { "id": "loan_book", "name": "Loan book / portfolio", "description": "One row per loan, or per loan per month-end snapshot, with balances, pricing, DPD and status.", "signals": ["loan_id", "customer_id", "product", "disbursement_date", "loan_amount", "interest_rate", "outstanding", "dpd", "loan_status"], "grain": "loan or loan-month snapshot" },
    { "id": "collections", "name": "EMI demand & collections", "description": "One row per loan instalment or per loan per month with amount due, amount collected and arrears.", "signals": ["loan_id", "due_date", "amount_due", "amount_collected", "dpd", "dpd_bucket", "branch"], "grain": "loan instalment" },
    { "id": "applications", "name": "Loan applications", "description": "One row per application with requested amount, bureau score and the credit decision.", "signals": ["application_id", "application_date", "product", "requested_amount", "credit_score", "income", "application_status", "decision_date", "channel"], "grain": "application" }
  ],
  "kpis": [
    { "id": "disbursed_amount", "name": "Disbursed amount", "short": "Disbursed", "definition": "Value of loans disbursed, counting each loan once.", "formula": "Σ loan amount, one value per loan", "format": "currency", "direction": "higher", "tier": "hero", "priority": 1, "group": "Growth", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "per_loan", "label": "Loan amount, once per loan", "expr": { "per": "loan_id", "inner": { "agg": "max", "of": { "field": "loan_amount" } }, "reduce": "sum" } },
        { "id": "rows", "label": "Sum of loan amount", "expr": { "agg": "sum", "of": { "field": "loan_amount" } }, "caveat": "No loan ID, so every row's amount is added; check that loans are not repeated across months." }
      ],
      "pitfalls": ["In a monthly snapshot file each loan repeats every month; summing rows multiplies disbursements."] },
    { "id": "outstanding_total", "name": "Outstanding principal", "short": "AUM / POS", "definition": "Principal still owed on the latest snapshot date in the period.", "formula": "Σ outstanding principal on the latest as-of date (semi-additive)", "format": "currency", "direction": "higher", "tier": "hero", "priority": 2, "group": "Growth", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "latest", "label": "Latest snapshot", "expr": { "atLatest": "as_of_date", "expr": { "agg": "sum", "of": { "field": "outstanding" } } } },
        { "id": "single", "label": "Single snapshot", "expr": { "agg": "sum", "of": { "field": "outstanding" } }, "caveat": "No as-of date, so the file is treated as one point-in-time snapshot." }
      ],
      "pitfalls": ["Balances are semi-additive: add across loans on one date, never across months."] },
    { "id": "loans", "name": "Loans", "definition": "Number of distinct loan accounts in the period.", "formula": "Count of distinct loan IDs", "format": "integer", "direction": "higher", "tier": "hero", "priority": 3, "group": "Growth", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "distinct_ids", "label": "Distinct loan IDs", "expr": { "agg": "countDistinct", "of": "loan_id" } },
        { "id": "rows", "label": "Row count", "expr": { "agg": "count" }, "caveat": "No loan ID, so every row is counted as one loan. Check the grain." }
      ] },
    { "id": "npa_rate", "name": "Gross NPA ratio", "short": "GNPA %", "definition": "Share of outstanding principal in non-performing loans on the latest snapshot date.", "formula": "Outstanding on NPA loans ÷ total outstanding, latest as-of date", "format": "percent", "direction": "lower", "tier": "hero", "priority": 4, "group": "Asset quality", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "classification", "label": "NPA classification, latest snapshot", "expr": { "atLatest": "as_of_date", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "outstanding" }, "where": { "field": "asset_classification", "class": "npa" } }, { "agg": "sum", "of": { "field": "outstanding" } }] } } },
        { "id": "dpd", "label": "DPD > 90, latest snapshot", "expr": { "atLatest": "as_of_date", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "outstanding" }, "where": { "field": "dpd", "cmp": "gt", "value": 90 } }, { "agg": "sum", "of": { "field": "outstanding" } }] } }, "caveat": "No asset classification, so NPAs are loans more than 90 days past due." },
        { "id": "classification_single", "label": "NPA classification, single snapshot", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "outstanding" }, "where": { "field": "asset_classification", "class": "npa" } }, { "agg": "sum", "of": { "field": "outstanding" } }] }, "caveat": "No as-of date, so the file is treated as one snapshot." },
        { "id": "dpd_single", "label": "DPD > 90, single snapshot", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "outstanding" }, "where": { "field": "dpd", "cmp": "gt", "value": 90 } }, { "agg": "sum", "of": { "field": "outstanding" } }] }, "caveat": "No as-of date or asset classification: one snapshot, with NPAs taken as loans more than 90 days past due." }
      ],
      "pitfalls": ["Written-off loans should carry zero outstanding; if they still show a balance they distort both sides of the ratio.", "Gross NPA ignores provisions; net NPA (after provisions) is lower."] },
    { "id": "par_30", "name": "Portfolio at risk 30+", "short": "PAR 30", "definition": "Share of outstanding principal in loans more than 30 days past due on the latest snapshot date.", "formula": "Outstanding on loans with DPD > 30 ÷ total outstanding, latest as-of date", "format": "percent", "direction": "lower", "tier": "hero", "priority": 5, "group": "Asset quality", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "amount", "label": "By outstanding, latest snapshot", "expr": { "atLatest": "as_of_date", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "outstanding" }, "where": { "field": "dpd", "cmp": "gt", "value": 30 } }, { "agg": "sum", "of": { "field": "outstanding" } }] } } },
        { "id": "count", "label": "By loan count, latest snapshot", "expr": { "atLatest": "as_of_date", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "loan_id", "where": { "field": "dpd", "cmp": "gt", "value": 30 } }, { "agg": "countDistinct", "of": "loan_id" }] } }, "caveat": "No outstanding balance, so delinquency is measured by number of loans." },
        { "id": "amount_single", "label": "By outstanding, single snapshot", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "outstanding" }, "where": { "field": "dpd", "cmp": "gt", "value": 30 } }, { "agg": "sum", "of": { "field": "outstanding" } }] }, "caveat": "No as-of date, so the file is treated as one snapshot." },
        { "id": "count_single", "label": "By loan count, single snapshot", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "loan_id", "where": { "field": "dpd", "cmp": "gt", "value": 30 } }, { "agg": "countDistinct", "of": "loan_id" }] }, "caveat": "No as-of date or outstanding balance: one snapshot, measured by number of loans." }
      ],
      "benchmark": { "high": 0.05, "note": "Indicative for microfinance, where PAR 30 below about 5% is commonly treated as healthy; secured retail books usually run lower." },
      "pitfalls": ["Young loans have not had time to fall behind, so fast growth flatters PAR (seasoning); compare vintages at the same age."] },
    { "id": "collection_efficiency", "name": "Collection efficiency", "short": "CE %", "definition": "Share of the amount due that was actually collected.", "formula": "Σ amount collected ÷ Σ amount due", "format": "percent", "direction": "higher", "tier": "hero", "priority": 6, "group": "Collections", "subDomains": ["collections", "loan_book"],
      "variants": [{ "id": "ratio", "label": "Collected ÷ due", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "amount_collected" } }, { "agg": "sum", "of": { "field": "amount_due" } }] } }],
      "benchmark": { "low": 0.95, "high": 0.99, "note": "Indicative for Indian retail and microfinance lenders in normal conditions; definitions vary." },
      "pitfalls": ["Lenders differ on whether collections of old arrears count against this month's demand; that version can exceed 100%."] },
    { "id": "wavg_interest_rate", "name": "Weighted average interest rate", "short": "Avg rate", "definition": "Interest rate across the book weighted by loan amount, in the unit of the rate column (10.5 means 10.5% a year when rates are stored as points).", "formula": "Σ (rate × loan amount) ÷ Σ loan amount, one value per loan", "format": "decimal", "direction": "neutral", "tier": "supporting", "priority": 7, "group": "Pricing", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "per_loan", "label": "Amount-weighted, once per loan", "expr": { "op": "div", "args": [{ "per": "loan_id", "inner": { "agg": "max", "of": { "op": "mul", "args": [{ "field": "interest_rate" }, { "field": "loan_amount" }] } }, "reduce": "sum" }, { "per": "loan_id", "inner": { "agg": "max", "of": { "field": "loan_amount" }, "where": { "field": "interest_rate", "notNull": true } }, "reduce": "sum" }] } },
        { "id": "rows", "label": "Amount-weighted, per row", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "mul", "args": [{ "field": "interest_rate" }, { "field": "loan_amount" }] } }, { "agg": "sum", "of": { "field": "loan_amount" }, "where": { "field": "interest_rate", "notNull": true } }] }, "caveat": "No loan ID, so each row is weighted as a separate loan." }
      ],
      "pitfalls": ["A simple average of rates overweights small loans; this KPI weights each loan by its amount.", "Rates stored as points (10.5) and as fractions (0.105) must not be mixed in one column."] },
    { "id": "avg_loan_size", "name": "Average ticket size", "short": "ATS", "definition": "Average amount disbursed per loan.", "formula": "Disbursed amount ÷ loans (ratio of sums)", "format": "currency", "direction": "neutral", "tier": "supporting", "priority": 8, "group": "Growth", "subDomains": ["loan_book", "collections"],
      "variants": [{ "id": "ratio", "label": "Disbursed ÷ loans", "expr": { "op": "div", "args": [{ "ref": "disbursed_amount" }, { "ref": "loans" }] } }] },
    { "id": "par_90", "name": "90+ DPD ratio", "short": "90+ DPD", "definition": "Share of outstanding principal in loans more than 90 days past due on the latest snapshot date.", "formula": "Outstanding on loans with DPD > 90 ÷ total outstanding, latest as-of date", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 9, "group": "Asset quality", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "amount", "label": "By outstanding, latest snapshot", "expr": { "atLatest": "as_of_date", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "outstanding" }, "where": { "field": "dpd", "cmp": "gt", "value": 90 } }, { "agg": "sum", "of": { "field": "outstanding" } }] } } },
        { "id": "count", "label": "By loan count, latest snapshot", "expr": { "atLatest": "as_of_date", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "loan_id", "where": { "field": "dpd", "cmp": "gt", "value": 90 } }, { "agg": "countDistinct", "of": "loan_id" }] } }, "caveat": "No outstanding balance, so delinquency is measured by number of loans." },
        { "id": "amount_single", "label": "By outstanding, single snapshot", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "outstanding" }, "where": { "field": "dpd", "cmp": "gt", "value": 90 } }, { "agg": "sum", "of": { "field": "outstanding" } }] }, "caveat": "No as-of date, so the file is treated as one snapshot." },
        { "id": "count_single", "label": "By loan count, single snapshot", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "loan_id", "where": { "field": "dpd", "cmp": "gt", "value": 90 } }, { "agg": "countDistinct", "of": "loan_id" }] }, "caveat": "No as-of date or outstanding balance: one snapshot, measured by number of loans." }
      ] },
    { "id": "default_rate", "name": "Default rate (by count)", "short": "Default %", "definition": "Share of loans that defaulted or were written off.", "formula": "Loans with a default or written-off status ÷ loans with a status", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 10, "group": "Asset quality", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "status", "label": "Defaulted or written off ÷ loans", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "loan_id", "where": { "or": [{ "field": "loan_status", "class": "default" }, { "field": "loan_status", "class": "written_off" }] } }, { "agg": "countDistinct", "of": "loan_id", "where": { "field": "loan_status", "notNull": true } }] } },
        { "id": "flag", "label": "Default flag ÷ loans", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "loan_id", "where": { "field": "default_flag", "isTrue": true } }, { "agg": "countDistinct", "of": "loan_id", "where": { "field": "default_flag", "notNull": true } }] }, "caveat": "Uses the default flag in the file." },
        { "id": "status_default_only", "label": "Defaulted ÷ loans", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "loan_id", "where": { "field": "loan_status", "class": "default" } }, { "agg": "countDistinct", "of": "loan_id", "where": { "field": "loan_status", "notNull": true } }] }, "caveat": "No written-off status values found, so only loans marked as defaulted count." },
        { "id": "flag_rows", "label": "Default flag, per row", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "default_flag", "isTrue": true } }, { "agg": "count", "where": { "field": "default_flag", "notNull": true } }] }, "caveat": "No loan ID, so each row is treated as one loan." }
      ],
      "pitfalls": ["Depends on the observation window: older cohorts have had more time to default than recent ones."] },
    { "id": "approval_rate", "name": "Approval rate", "definition": "Share of decided applications that were approved.", "formula": "Approved applications ÷ applications with a decision (pending and withdrawn excluded)", "format": "percent", "direction": "neutral", "tier": "supporting", "priority": 11, "group": "Origination", "subDomains": ["applications"],
      "variants": [
        { "id": "distinct_ids", "label": "Approved ÷ decided applications", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "application_id", "where": { "field": "application_status", "class": "approved" } }, { "agg": "countDistinct", "of": "application_id", "where": { "and": [{ "field": "application_status", "notNull": true }, { "field": "application_status", "notClass": "pending" }, { "field": "application_status", "notClass": "withdrawn" }] } }] } },
        { "id": "rows", "label": "Approved ÷ decided rows", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "application_status", "class": "approved" } }, { "agg": "count", "where": { "and": [{ "field": "application_status", "notNull": true }, { "field": "application_status", "notClass": "pending" }, { "field": "application_status", "notClass": "withdrawn" }] } }] }, "caveat": "No application ID, so each row is treated as one application." }
      ],
      "pitfalls": ["A higher approval rate is not automatically good: it can mean looser credit standards and more defaults later."] },
    { "id": "borrowers", "name": "Borrowers", "definition": "Distinct customers with a loan in the period.", "formula": "Count of distinct customer IDs", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 12, "group": "Growth", "subDomains": ["loan_book", "collections"],
      "variants": [{ "id": "distinct", "label": "Distinct customer IDs", "expr": { "agg": "countDistinct", "of": "customer_id" } }] },
    { "id": "new_borrowers", "name": "New borrowers", "definition": "Customers whose first loan in the file was disbursed in the period.", "formula": "Customers with first disbursement date ≥ period start", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 13, "group": "Growth", "subDomains": ["loan_book", "collections"],
      "variants": [{ "id": "first_loan", "label": "First disbursement in period", "expr": { "newEntities": "customer_id", "date": "disbursement_date" } }],
      "pitfalls": ["Customers whose first loan predates this file look new. The longer the history, the more accurate this is."] },
    { "id": "avg_ltv", "name": "Average loan-to-value", "short": "LTV", "definition": "Loan amount as a share of collateral value at origination, weighted by loan size.", "formula": "Σ loan amount ÷ Σ collateral value, once per loan with both values", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 14, "group": "Asset quality", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "per_loan", "label": "Loan ÷ collateral, once per loan", "expr": { "op": "div", "args": [{ "per": "loan_id", "inner": { "agg": "max", "of": { "field": "loan_amount" }, "where": { "field": "collateral_value", "notNull": true } }, "reduce": "sum" }, { "per": "loan_id", "inner": { "agg": "max", "of": { "field": "collateral_value" }, "where": { "field": "loan_amount", "notNull": true } }, "reduce": "sum" }] } },
        { "id": "rows", "label": "Loan ÷ collateral, per row", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "loan_amount" }, "where": { "field": "collateral_value", "notNull": true } }, { "agg": "sum", "of": { "field": "collateral_value" }, "where": { "field": "loan_amount", "notNull": true } }] }, "caveat": "No loan ID, so each row is treated as one loan." }
      ],
      "pitfalls": ["Uses collateral value at the time recorded; property and gold prices move, so current LTV can differ a lot."] },
    { "id": "applications", "name": "Applications", "definition": "Number of loan applications received in the period.", "formula": "Count of distinct application IDs", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 15, "group": "Origination", "subDomains": ["applications"],
      "variants": [
        { "id": "distinct_ids", "label": "Distinct application IDs", "expr": { "agg": "countDistinct", "of": "application_id" } },
        { "id": "rows", "label": "Row count", "expr": { "agg": "count" }, "caveat": "No application ID, so every row is counted as one application." }
      ] },
    { "id": "collected_amount", "name": "Amount collected", "definition": "Instalments and repayments collected in the period.", "formula": "Sum of amount collected", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 16, "group": "Collections", "subDomains": ["collections", "loan_book"],
      "variants": [{ "id": "sum", "label": "Sum of amount collected", "expr": { "agg": "sum", "of": { "field": "amount_collected" } } }] },
    { "id": "avg_credit_score", "name": "Average credit score", "short": "Avg score", "definition": "Average bureau score of borrowers or applicants, counting each person once.", "formula": "Average over customers of their credit score", "format": "number", "direction": "higher", "tier": "supporting", "priority": 17, "group": "Origination",
      "variants": [
        { "id": "per_customer", "label": "Average per customer", "expr": { "per": "customer_id", "inner": { "agg": "avg", "of": { "field": "credit_score" } }, "reduce": "avg" } },
        { "id": "per_application", "label": "Average per application", "expr": { "per": "application_id", "inner": { "agg": "avg", "of": { "field": "credit_score" } }, "reduce": "avg" }, "caveat": "No customer ID, so each application counts once." },
        { "id": "rows", "label": "Average per row", "expr": { "agg": "avg", "of": { "field": "credit_score" } }, "caveat": "No customer or application ID, so each row counts once." }
      ],
      "pitfalls": ["Applicants with no bureau history (new-to-credit) often show as blank or a special code; they are left out or distort the average."] },
    { "id": "requested_amount_total", "name": "Amount requested", "definition": "Total loan amount applied for in the period.", "formula": "Sum of requested amount", "format": "currency", "direction": "higher", "tier": "detail", "priority": 40, "group": "Origination", "subDomains": ["applications"],
      "variants": [{ "id": "sum", "label": "Sum of requested amount", "expr": { "agg": "sum", "of": { "field": "requested_amount" } } }] },
    { "id": "amount_due_total", "name": "Amount due", "definition": "Instalments falling due (demand) in the period.", "formula": "Sum of amount due", "format": "currency", "direction": "neutral", "tier": "detail", "priority": 41, "group": "Collections", "subDomains": ["collections", "loan_book"],
      "variants": [{ "id": "sum", "label": "Sum of amount due", "expr": { "agg": "sum", "of": { "field": "amount_due" } } }] },
    { "id": "avg_decision_days", "name": "Average decision time", "short": "Decision TAT", "definition": "Average calendar days from application to credit decision.", "formula": "Average of (decision date − application date), one value per application", "format": "days", "direction": "lower", "tier": "detail", "priority": 42, "group": "Origination", "subDomains": ["applications"],
      "variants": [
        { "id": "per_application", "label": "Decision − application date, per application", "expr": { "per": "application_id", "inner": { "agg": "max", "of": { "daysBetween": ["application_date", "decision_date"] } }, "reduce": "avg" } },
        { "id": "rows", "label": "Decision − application date, per row", "expr": { "agg": "avg", "of": { "daysBetween": ["application_date", "decision_date"] } }, "caveat": "No application ID, so each row is treated as one application." }
      ] },
    { "id": "wavg_tenure", "name": "Weighted average tenure", "short": "Avg tenure", "definition": "Contractual tenure in months, weighted by loan amount.", "formula": "Σ (tenure × loan amount) ÷ Σ loan amount, one value per loan", "format": "decimal", "direction": "neutral", "tier": "detail", "priority": 43, "group": "Pricing", "subDomains": ["loan_book", "collections"],
      "variants": [
        { "id": "per_loan", "label": "Amount-weighted, once per loan", "expr": { "op": "div", "args": [{ "per": "loan_id", "inner": { "agg": "max", "of": { "op": "mul", "args": [{ "field": "tenure_months" }, { "field": "loan_amount" }] } }, "reduce": "sum" }, { "per": "loan_id", "inner": { "agg": "max", "of": { "field": "loan_amount" }, "where": { "field": "tenure_months", "notNull": true } }, "reduce": "sum" }] } },
        { "id": "rows", "label": "Amount-weighted, per row", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "mul", "args": [{ "field": "tenure_months" }, { "field": "loan_amount" }] } }, { "agg": "sum", "of": { "field": "loan_amount" }, "where": { "field": "tenure_months", "notNull": true } }] }, "caveat": "No loan ID, so each row is weighted as a separate loan." }
      ] }
  ],
  "charts": [
    { "id": "disbursement_trend", "title": "Disbursements over time", "kind": "area", "section": "trend", "x": { "time": "disbursement_date" }, "measures": ["disbursed_amount"], "reason": "One additive amount over a continuous time axis: a line with a soft fill shows both the shape and the volume of new lending.", "alternatives": ["line", "bar"], "size": { "w": 8, "h": 4 }, "priority": 1, "subDomains": ["loan_book", "collections"] },
    { "id": "outstanding_trend", "title": "Outstanding principal by month-end", "kind": "line", "section": "trend", "x": { "time": "as_of_date" }, "measures": ["outstanding_total"], "reason": "A closing balance per period (the latest snapshot in each period, never summed across months), so a line.", "alternatives": ["area"], "size": { "w": 4, "h": 4 }, "priority": 2, "subDomains": ["loan_book", "collections"] },
    { "id": "npa_trend", "title": "Gross NPA ratio over time", "kind": "line", "section": "trend", "x": { "time": "as_of_date" }, "measures": ["npa_rate"], "reason": "A ratio recomputed on each period's latest snapshot, drawn as a line and never summed.", "alternatives": ["bar"], "size": { "w": 6, "h": 4 }, "priority": 3, "subDomains": ["loan_book", "collections"] },
    { "id": "applications_trend", "title": "Applications over time", "kind": "bar", "section": "trend", "x": { "time": "application_date" }, "measures": ["applications"], "reason": "Applications per period are discrete counts, so columns from a zero baseline compare them honestly.", "alternatives": ["line", "area"], "size": { "w": 8, "h": 4 }, "priority": 1, "subDomains": ["applications"] },
    { "id": "disbursed_by_product", "title": "Disbursements by product", "kind": "hbar", "section": "breakdown", "x": { "field": "product" }, "measures": ["disbursed_amount"], "topN": 10, "others": true, "drill": ["product", "branch"], "reason": "One amount compared across named products: sorted horizontal bars keep labels readable. Top 10 plus Others.", "alternatives": ["bar", "treemap", "donut"], "size": { "w": 6, "h": 5 }, "priority": 1, "subDomains": ["loan_book", "collections"] },
    { "id": "outstanding_by_state", "title": "Outstanding by state", "kind": "geoTile", "section": "breakdown", "x": { "field": "state" }, "measures": ["outstanding_total"], "reason": "State-level exposure on a tile map keeps geography recognisable without letting large states dominate the ink.", "alternatives": ["hbar", "treemap"], "size": { "w": 6, "h": 5 }, "priority": 2, "subDomains": ["loan_book", "collections"] },
    { "id": "outstanding_by_bucket", "title": "Outstanding by DPD bucket", "kind": "bar", "section": "breakdown", "x": { "field": "dpd_bucket" }, "measures": ["outstanding_total"], "others": false, "reason": "DPD buckets are ordered stages of arrears: columns per bucket show how the book is ageing and where balances pile up.", "alternatives": ["donut", "hbar"], "size": { "w": 6, "h": 4 }, "priority": 3, "subDomains": ["loan_book", "collections"] },
    { "id": "par_by_branch", "title": "PAR 30 by branch", "kind": "hbar", "section": "drivers", "x": { "field": "branch" }, "measures": ["par_30"], "topN": 12, "others": false, "minGroupRows": 30, "reason": "Where delinquency concentrates: PAR 30 recomputed per branch, sorted, with branches under 30 rows hidden as too small.", "alternatives": ["bar", "geoTile"], "size": { "w": 6, "h": 5 }, "priority": 1, "subDomains": ["loan_book", "collections"] },
    { "id": "collection_by_branch", "title": "Collection efficiency by branch", "kind": "hbar", "section": "drivers", "x": { "field": "branch" }, "measures": ["collection_efficiency"], "topN": 12, "others": false, "minGroupRows": 30, "reason": "A rate compared across branches: sorted bars of the recomputed collection efficiency, with branches under 30 rows hidden.", "alternatives": ["bar"], "size": { "w": 6, "h": 5 }, "priority": 2, "subDomains": ["collections", "loan_book"] },
    { "id": "pricing_vs_risk", "title": "Interest rate vs NPA by product", "kind": "scatter", "section": "drivers", "x": { "field": "product" }, "measures": ["wavg_interest_rate", "npa_rate"], "reason": "Two measures per product: a scatter shows whether higher-priced products really carry more risk, without a dual axis.", "alternatives": ["table"], "size": { "w": 6, "h": 5 }, "priority": 3, "subDomains": ["loan_book", "collections"] },
    { "id": "approval_by_channel", "title": "Approval rate by channel", "kind": "bar", "section": "drivers", "x": { "field": "channel" }, "measures": ["approval_rate"], "others": false, "minGroupRows": 30, "reason": "A rate compared across a few sourcing channels: bars of the recomputed approval rate, channels with under 30 applications hidden.", "alternatives": ["hbar"], "size": { "w": 6, "h": 4 }, "priority": 1, "subDomains": ["applications"] },
    { "id": "branch_scorecard", "title": "Branch scorecard", "kind": "table", "section": "detail", "x": { "field": "branch" }, "measures": ["loans", "disbursed_amount", "outstanding_total", "par_30", "npa_rate", "collection_efficiency"], "topN": 25, "others": false, "reason": "Growth, asset quality and collections per branch side by side: a sortable table carries more than any single chart.", "alternatives": ["hbar"], "size": { "w": 12, "h": 6 }, "priority": 1, "subDomains": ["loan_book", "collections"] }
  ],
  "pitfalls": [
    "Balances are snapshots: add outstanding across loans on one date, never across months. A month-end loan file repeats every loan each month, so disbursements and loan counts must be taken once per loan.",
    "New loans have not had time to fall behind (seasoning), so a fast-growing book looks healthier than it is; compare delinquency by disbursement month at the same loan age.",
    "Closed and written-off loans drop out of the latest snapshot (survivorship), so asset quality can improve simply because bad loans were written off.",
    "NPA and delinquency ratios change with the definition: by amount or by count, gross or net of provisions, DPD > 90 or the regulator's classification. State which one you report.",
    "Branches and products with few loans swing wildly; treat ratios from fewer than about 30 loans as noise.",
    "Interest rates may be stored as points (10.5) or fractions (0.105); averages keep the column's unit, so check it before comparing with other reports."
  ]
}
