    { "id": "new_patients", "name": "New patients", "aliases": ["New patient registrations", "First visits"], "definition": "Patients whose first-ever visit or admission falls in the period.", "formula": "Patients with first admission date ≥ period start", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 13, "group": "Volume",
