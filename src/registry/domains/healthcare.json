      ],
      "benchmark": { "low": 0.05, "high": 0.1, "note": "Indicative: initial denial rates of about 5–10% are commonly cited for providers; above 10% usually signals coding or documentation problems." },
      "pitfalls": ["Pending claims are left out of the denominator, so recent periods move as claims are decided."] },
    { "id": "bed_occupancy", "name": "Bed occupancy rate", "short": "Occupancy", "aliases": ["Bed occupancy %", "BOR", "Occupancy %", "Bed occupancy rate %"], "definition": "Share of available bed capacity that was occupied.", "formula": "Σ occupied beds (bed-days) ÷ Σ available beds (bed-days), on rows that have both", "format": "percent", "direction": "neutral", "tier": "supporting", "priority": 9, "group": "Capacity", "subDomains": ["census"],
