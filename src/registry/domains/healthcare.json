      "benchmark": { "low": 0.75, "high": 0.85, "note": "Indicative: about 85% is widely cited as a practical ceiling for safe occupancy; well below 75% suggests idle capacity." },
      "pitfalls": ["A monthly average hides weekday peaks; sustained occupancy above about 85–90% is linked to access block and safety risk."] },
    { "id": "payments_received", "name": "Payments received", "aliases": ["Cash collected", "Payments collected"], "definition": "Amount paid or approved by payers and patients.", "formula": "Sum of paid / approved amount", "format": "currency", "direction": "higher", "tier": "detail", "priority": 43, "group": "Finance",
