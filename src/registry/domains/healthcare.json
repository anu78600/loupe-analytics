    { "id": "patient_satisfaction", "name": "Patient satisfaction", "short": "Satisfaction", "aliases": ["PSAT", "Patient satisfaction score", "Patient experience score"], "definition": "Average satisfaction score given by patients who responded, on the survey's own scale.", "formula": "Σ satisfaction score ÷ responses, one value per visit", "format": "decimal", "direction": "higher", "tier": "supporting", "priority": 12, "group": "Patient experience", "subDomains": ["outpatient", "encounters"],
