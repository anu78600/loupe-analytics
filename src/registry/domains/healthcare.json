    { "id": "avg_wait_time", "name": "Average wait time", "short": "Wait time", "aliases": ["OPD waiting time", "Door to doctor time"], "definition": "Average minutes a patient waits to be seen, per visit (in the units of the wait-time column).", "formula": "Σ wait time ÷ visits with a wait time, one value per visit", "format": "number", "direction": "lower", "tier": "supporting", "priority": 11, "group": "Patient experience", "subDomains": ["outpatient", "encounters"],
