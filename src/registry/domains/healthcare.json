    { "id": "claims", "name": "Claims", "aliases": ["Claims submitted", "Claims filed"], "definition": "Number of distinct claims submitted in the period.", "formula": "Count of distinct claim IDs", "format": "integer", "direction": "neutral", "tier": "supporting", "priority": 16, "group": "Claims", "subDomains": ["claims", "encounters"],
