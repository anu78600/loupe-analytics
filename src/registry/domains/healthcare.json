        { "id": "all", "label": "Paid ÷ billed", "expr": { "op": "div", "args": [{ "ref": "payments_received" }, { "ref": "gross_charges" }] }, "caveat": "No claim status, so bills still awaiting payment lower the rate in recent periods." }
      ],
