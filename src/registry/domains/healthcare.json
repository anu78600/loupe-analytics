    { "id": "claim_date", "label": "Claim submission date", "roles": ["datetime"], "synonyms": ["claim date", "claim submission date", "claim submitted date", "submission date", "submitted date", "date submitted", "claim received date", "received date", "filing date", "claim filed date", "intimation date"], "exclude": ["settlement", "settled", "paid", "payment", "approval", "approved", "admission", "discharge", "service", "denial", "visit", "appointment", "birth", "census"], "weight": 1.5 },
    { "id": "settlement_date", "label": "Settlement / payment date", "roles": ["datetime"], "synonyms": ["settlement date", "settled date", "date of settlement", "payment date", "paid date", "date paid", "remittance date", "adjudication date", "processed date", "decision date", "approval date", "closure date", "claim closed date"], "exclude": ["submission", "submitted", "admission", "discharge", "due", "visit", "appointment", "service", "birth", "census"], "weight": 1 },
    { "id": "claim_status", "label": "Claim status", "roles": ["dimension"], "synonyms": ["claim status", "status", "adjudication status", "claim state", "settlement status", "approval status", "claim outcome", "claim decision", "payment status", "remittance status"], "exclude": ["discharge", "patient", "appointment", "marital"], "valueHints": ["approved", "denied", "rejected", "pending", "paid", "settled", "submitted", "in process", "under review", "partially approved", "query raised"], "weight": 2 },
    { "id": "denial_reason", "label": "Denial reason", "roles": ["dimension", "text"], "synonyms": ["denial reason", "rejection reason", "reason for denial", "reason for rejection", "denial code", "rejection code", "denial category", "carc", "remark code", "deduction reason", "reason"], "exclude": ["visit", "admission", "discharge", "appointment", "cancellation", "diagnosis", "procedure", "icd", "cpt", "drg", "zip", "postal"], "weight": 1.2 },
    { "id": "census_date", "label": "Census date", "roles": ["datetime"], "synonyms": ["census date", "bed census date", "census datetime", "snapshot date", "as of date", "report date", "date"], "exclude": ["admission", "discharge", "scheduled", "appointment", "claim", "visit", "service", "birth", "death", "payment", "settlement"], "weight": 0.8 },
    { "id": "occupied_beds", "label": "Occupied beds / bed-days", "roles": ["measure"], "synonyms": ["occupied beds", "beds occupied", "occupied bed days", "bed days occupied", "occupied", "census", "midnight census", "inpatient census", "patients in beds", "patient days", "bed days", "inpatients"], "exclude": ["rate", "percent", "available", "total", "capacity"], "weight": 1.5 },
    { "id": "available_beds", "label": "Available beds / bed-days", "roles": ["measure"], "synonyms": ["available beds", "beds available", "available bed days", "total beds", "bed capacity", "beds", "bed count", "number of beds", "staffed beds", "operational beds", "licensed beds", "sanctioned beds", "capacity"], "exclude": ["occupied", "rate", "percent", "vacant", "free", "empty", "visit", "patient", "admission", "discharge", "bill", "charge"], "weight": 1.5 },
    { "id": "state", "label": "State / region", "roles": ["geo", "dimension"], "synonyms": ["state", "patient state", "hospital state", "provider state", "province", "region"], "exclude": ["name", "id", "code", "status"], "weight": 0.6 }
  ],
  "valueClasses": {
    "discharge_status": [
      { "id": "died", "label": "Died", "keywords": ["died", "expired", "death", "deceased", "dead", "mortality", "brought dead"] },
      { "id": "lama", "label": "Left against medical advice", "keywords": ["against medical advice", "lama", "dama", "ama", "left against", "discharged against", "absconded", "lwbs", "left without being seen"] },
      { "id": "transferred", "label": "Transferred / referred", "keywords": ["transferred", "transfer", "referred", "referral", "shifted"] },
      { "id": "discharged", "label": "Discharged alive", "keywords": ["discharged", "recovered", "home", "improved", "cured", "routine", "alive", "stable", "normal discharge"] }
    ],
    "admission_type": [
      { "id": "emergency", "label": "Emergency / unplanned", "keywords": ["emergency", "urgent", "er", "ed", "casualty", "trauma", "accident", "unplanned", "acute"] },
      { "id": "elective", "label": "Elective / planned", "keywords": ["elective", "planned", "scheduled", "routine", "day care", "daycare"] }
    ],
    "claim_status": [
      { "id": "denied", "label": "Denied", "keywords": ["denied", "reject", "declined", "denial", "repudiated", "disallowed", "not payable"] },
      { "id": "approved", "label": "Approved / paid", "keywords": ["approved", "paid", "settled", "accepted", "processed", "adjudicated", "completed", "closed", "cleared", "sanctioned", "partially approved", "partial"] },
      { "id": "pending", "label": "Pending", "keywords": ["pending", "submitted", "in process", "in progress", "under review", "in review", "query", "queried", "awaiting", "on hold", "open", "received", "appealed", "appeal", "resubmitted", "new", "outstanding"] }
    ]
  },
  "subDomains": [
    { "id": "encounters", "name": "Admissions & encounters", "description": "One row per inpatient admission or encounter (or per charge or diagnosis line within it).", "signals": ["patient_id", "encounter_id", "admission_date", "discharge_date", "department", "diagnosis", "admission_type", "discharge_status", "billed_amount"], "grain": "admission or encounter" },
    { "id": "outpatient", "name": "Outpatient visits & appointments", "description": "One row per clinic visit or scheduled appointment, often with wait time, attendance and feedback.", "signals": ["patient_id", "admission_date", "department", "doctor", "admission_type", "no_show", "wait_time", "satisfaction"], "grain": "visit or appointment" },
    { "id": "claims", "name": "Claims & billing", "description": "One row per insurance, TPA or government-scheme claim with its status and amounts.", "signals": ["claim_id", "claim_date", "claim_status", "patient_id", "payer", "billed_amount", "paid_amount", "denial_reason", "settlement_date"], "grain": "claim" },
    { "id": "census", "name": "Bed census", "description": "Occupied and available beds per ward per day (or bed-days per period).", "signals": ["census_date", "ward", "occupied_beds", "available_beds", "facility"], "grain": "ward-day snapshot" }
  ],
  "kpis": [
    { "id": "admissions", "name": "Admissions / encounters", "short": "Admissions", "aliases": ["IP admissions", "Inpatient admissions", "Encounters", "Patient visits", "OPD visits", "A&E attendances", "Emergency attendances"], "definition": "Number of distinct admissions or visits in the period.", "formula": "Count of distinct encounter IDs", "format": "integer", "direction": "neutral", "tier": "hero", "priority": 1, "group": "Volume", "subDomains": ["encounters", "outpatient"],
      "variants": [
        { "id": "distinct_ids", "label": "Distinct encounter IDs", "expr": { "agg": "countDistinct", "of": "encounter_id" } },
        { "id": "rows", "label": "Row count (no encounter ID)", "expr": { "agg": "count" }, "caveat": "No encounter ID column, so every row is counted as one encounter. Check the grain." }
      ] },
    { "id": "patients", "name": "Patients", "aliases": ["Patient count", "Unique patients", "Number of patients"], "definition": "Distinct patients seen in the period.", "formula": "Count of distinct patient IDs", "format": "integer", "direction": "neutral", "tier": "hero", "priority": 2, "group": "Volume",
      "variants": [
        { "id": "distinct", "label": "Distinct patient IDs", "expr": { "agg": "countDistinct", "of": "patient_id" } },
        { "id": "names", "label": "Distinct patient names", "expr": { "agg": "countDistinct", "of": "patient_name" }, "caveat": "No patient ID, so patients are counted by name: namesakes merge and spelling variants split." }
      ] },
    { "id": "alos", "name": "Average length of stay", "short": "ALOS", "aliases": ["Average LOS", "Mean length of stay"], "definition": "Average number of days a completed stay lasts, from admission to discharge.", "formula": "Σ (discharge date − admission date) ÷ discharged stays, one value per stay", "format": "days", "direction": "lower", "tier": "hero", "priority": 3, "group": "Length of stay", "subDomains": ["encounters"],
      "variants": [
        { "id": "per_stay_dates", "label": "Discharge − admission date, per stay", "expr": { "per": "encounter_id", "inner": { "agg": "max", "of": { "daysBetween": ["admission_date", "discharge_date"] } }, "reduce": "avg" } },
        { "id": "per_stay_los", "label": "Length-of-stay column, per stay", "expr": { "per": "encounter_id", "inner": { "agg": "max", "of": { "field": "los_days" } }, "reduce": "avg" }, "caveat": "No discharge date, so the supplied length-of-stay column is used as is." },
        { "id": "rows_dates", "label": "Discharge − admission date, per row", "expr": { "agg": "avg", "of": { "daysBetween": ["admission_date", "discharge_date"] } }, "caveat": "No encounter ID, so each row is treated as one stay." },
        { "id": "rows_los", "label": "Length-of-stay column, per row", "expr": { "agg": "avg", "of": { "field": "los_days" } }, "caveat": "Uses the supplied length-of-stay column with each row treated as one stay." }
      ],
      "benchmark": { "low": 4, "high": 7, "note": "Indicative for acute inpatient care in many health systems; specialty and case mix move it a lot." },
      "pitfalls": ["Same-day and day-care cases count as 0 days and pull the average down; compare inpatient stays separately.", "Patients still admitted have no discharge date and are left out, so recent periods lean towards short stays.", "A few very long stays move the average a lot; check the length-of-stay distribution."] },
    { "id": "readmission_rate", "name": "Readmission rate", "aliases": ["Readmission %", "Readmissions %", "30-day readmission rate"], "definition": "Share of admissions flagged as a readmission (typically an unplanned return within 30 days of a previous discharge).", "formula": "Admissions flagged as readmitted ÷ admissions", "format": "percent", "direction": "lower", "tier": "hero", "priority": 4, "group": "Quality & outcomes", "subDomains": ["encounters"],
      "variants": [
        { "id": "distinct_ids", "label": "Flagged encounters ÷ encounters", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "encounter_id", "where": { "field": "readmitted", "isTrue": true } }, { "agg": "countDistinct", "of": "encounter_id" }] } },
        { "id": "rows", "label": "Flagged rows ÷ rows", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "readmitted", "isTrue": true } }, { "agg": "count" }] }, "caveat": "No encounter ID, so each row is treated as one admission." }
      ],
      "benchmark": { "low": 0.1, "high": 0.2, "note": "Indicative 30-day all-cause range for older adult inpatients; younger and elective cohorts usually run lower." },
      "pitfalls": ["Systems flag differently: some mark the return admission, others the original discharge, and windows (7, 30 or 90 days) vary. Never compare across definitions.", "Planned returns (chemotherapy, staged surgery) inflate the rate unless excluded."] },
    { "id": "mortality_rate", "name": "In-hospital mortality rate", "short": "Mortality", "aliases": ["Mortality %", "Death rate", "Crude mortality rate"], "definition": "Share of completed stays that ended in the patient's death.", "formula": "Stays with outcome = died ÷ stays with a recorded outcome", "format": "percent", "direction": "lower", "tier": "hero", "priority": 5, "group": "Quality & outcomes", "subDomains": ["encounters"],
      "variants": [
        { "id": "outcome", "label": "Died ÷ stays with an outcome", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "encounter_id", "where": { "field": "discharge_status", "class": "died" } }, { "agg": "countDistinct", "of": "encounter_id", "where": { "field": "discharge_status", "notNull": true } }] } },
        { "id": "flag", "label": "Death flag ÷ encounters", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "encounter_id", "where": { "field": "died", "isTrue": true } }, { "agg": "countDistinct", "of": "encounter_id" }] }, "caveat": "Uses the death flag over all encounters, including patients still in hospital." },
        { "id": "outcome_rows", "label": "Died rows ÷ rows with an outcome", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "discharge_status", "class": "died" } }, { "agg": "count", "where": { "field": "discharge_status", "notNull": true } }] }, "caveat": "No encounter ID, so each row is treated as one stay." },
        { "id": "flag_rows", "label": "Death flag rows ÷ rows", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "died", "isTrue": true } }, { "agg": "count" }] }, "caveat": "No encounter ID or outcome column, so each flagged row is one death and every row is one stay." }
      ],
      "pitfalls": ["A crude rate, not risk-adjusted: units that treat sicker patients (ICU, oncology, trauma) always look worse.", "Deaths after transfer or after discharge are not captured."] },
    { "id": "gross_charges", "name": "Billed charges", "short": "Charges", "aliases": ["Gross billing", "Total charges", "Hospital revenue"], "definition": "Total amount billed for care in the period, before payer discounts, denials and write-offs.", "formula": "Sum of billed amount", "format": "currency", "direction": "higher", "tier": "hero", "priority": 6, "group": "Finance",
      "variants": [{ "id": "sum", "label": "Sum of billed amount", "expr": { "agg": "sum", "of": { "field": "billed_amount" } } }],
      "pitfalls": ["Billed charges are list prices: actual revenue is what payers and patients pay after contractual discounts and denials."] },
    { "id": "avg_cost_per_encounter", "name": "Average cost per encounter", "short": "Cost / encounter", "aliases": ["Cost per patient", "Cost per visit", "Average cost per patient"], "definition": "Cost of care per admission or visit.", "formula": "Σ cost of care ÷ encounters (ratio of sums, not an average of row costs)", "format": "currency", "direction": "lower", "tier": "supporting", "priority": 7, "group": "Finance", "subDomains": ["encounters", "outpatient"],
      "variants": [
        { "id": "cost", "label": "Cost of care ÷ encounters", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "cost" } }, { "ref": "admissions" }] } },
        { "id": "charges", "label": "Billed charges ÷ encounters", "expr": { "op": "div", "args": [{ "ref": "gross_charges" }, { "ref": "admissions" }] }, "caveat": "No cost column, so this is the average billed charge per encounter, which usually exceeds the true cost of care." }
      ],
      "pitfalls": ["Driven by case mix: a shift towards surgical or ICU cases raises it without any loss of efficiency."] },
    { "id": "claim_denial_rate", "name": "Claim denial rate", "short": "Denial rate", "aliases": ["Denial %", "Claims denial %"], "definition": "Share of decided claims that the payer denied or rejected.", "formula": "Denied claims ÷ claims with a decision (pending claims excluded)", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 8, "group": "Claims", "subDomains": ["claims", "encounters"],
      "variants": [
