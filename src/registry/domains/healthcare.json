    { "id": "collection_rate", "name": "Collection rate", "aliases": ["Net collection rate", "Gross collection rate"], "definition": "Share of billed charges actually paid, on bills or claims that have been decided.", "formula": "Payments received ÷ billed charges, excluding claims still pending", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 10, "group": "Finance",
