{
  "id": "insurance",
  "name": "Insurance",
  "tagline": "Premium, policies in force, renewals, claims, loss ratio and settlement for insurers and brokers",
  "description": "Policy registers and premium bordereaux from policy-admin systems (Guidewire, Duck Creek, Majesco, insurer and broker portals) and claims registers for motor, health, life and property lines, including IRDAI-style settlement and repudiation statuses, IDV and sum insured.",
  "icon": "shield-check",
  "entity": "policy",
  "goals": ["growth", "profit", "retention", "risk"],
  "fields": [
    { "id": "policy_id", "label": "Policy number", "roles": ["identifier", "dimension"], "synonyms": ["policy id", "policy number", "policy no", "policy", "policy ref", "policy reference", "certificate number", "certificate no", "policy code", "contract number", "contract id", "policy num", "cover note number"], "exclude": ["type", "status", "start", "end", "date", "state", "holder", "premium", "term", "year", "csl", "deductable", "deductible", "limit", "annual"], "weight": 3, "core": true, "description": "Identifies each policy; repeats on every claim or premium row of that policy." },
    { "id": "policy_start_date", "label": "Policy start / inception date", "roles": ["datetime"], "synonyms": ["policy start date", "start date", "inception date", "effective date", "policy effective date", "issue date", "policy issue date", "bind date", "policy bind date", "commencement date", "risk start date", "policy date", "written date", "underwriting date", "policy inception date", "date of issue"], "exclude": ["claim", "loss", "incident", "accident", "end", "expiry", "expiration", "renewal", "reported", "settled", "birth", "snapshot", "valuation"], "weight": 2.5, "core": true },
    { "id": "policy_end_date", "label": "Policy end / expiry date", "roles": ["datetime"], "synonyms": ["policy end date", "end date", "expiry date", "expiration date", "maturity date", "risk end date", "policy expiry date", "policy expiry", "renewal date", "policy expiration date", "valid till", "valid upto"], "exclude": ["claim", "loss", "start", "inception", "issue"], "weight": 1.5 },
    { "id": "as_of_date", "label": "As-of / snapshot date", "roles": ["datetime"], "synonyms": ["as of date", "as at date", "snapshot date", "valuation date", "extraction date", "extract date", "month end", "reporting date", "data date", "inforce date"], "weight": 0.8 },
    { "id": "product_line", "label": "Product / line of business", "roles": ["dimension"], "synonyms": ["product", "product line", "line of business", "lob", "product name", "plan name", "plan", "policy type", "coverage type", "cover type", "insurance type", "class of business", "segment", "scheme", "product category", "business line"], "exclude": ["id", "code", "claim", "csl", "deductible", "deductable", "limit", "number", "premium", "bind", "annual", "state", "date", "holder", "status", "collision", "incident", "vehicle", "fuel", "body", "customer", "insured"], "valueHints": ["motor", "health", "life", "term", "home", "property", "travel", "fire", "marine", "auto", "commercial", "liability", "crop", "personal accident", "group health", "endowment", "ulip", "two wheeler", "private car"], "weight": 1.5 },
    { "id": "premium_written", "label": "Written premium", "roles": ["currency", "measure"], "synonyms": ["premium", "gross written premium", "gwp", "written premium", "premium amount", "total premium", "annual premium", "policy premium", "gross premium", "premium written", "policy annual premium", "net premium", "final premium"], "exclude": ["earned", "unearned", "rate", "per", "tax", "gst", "due", "commission"], "weight": 2.5, "core": true },
    { "id": "premium_earned", "label": "Earned premium", "roles": ["currency", "measure"], "synonyms": ["earned premium", "premium earned", "net earned premium", "nep", "gross earned premium", "gep", "earned"], "exclude": ["unearned"], "weight": 1.5 },
    { "id": "sum_insured", "label": "Sum insured", "roles": ["currency", "measure"], "synonyms": ["sum insured", "sum assured", "coverage amount", "cover amount", "insured amount", "insured value", "idv", "insured declared value", "policy limit", "coverage limit", "face amount", "face value", "limit", "umbrella limit", "total sum insured"], "exclude": ["claim", "premium"], "weight": 1.5 },
    { "id": "channel", "label": "Sales channel", "roles": ["dimension"], "synonyms": ["channel", "sales channel", "distribution channel", "source", "source of business", "intermediary type", "agent type", "business channel", "acquisition channel"], "exclude": ["id", "code", "name", "collision", "incident", "vehicle", "claim", "payment", "premium"], "valueHints": ["agency", "agent", "broker", "bancassurance", "direct", "online", "digital", "corporate agent", "web aggregator", "pos", "telesales", "branch", "dealer"], "weight": 1 },
    { "id": "agent", "label": "Agent / intermediary", "roles": ["dimension"], "synonyms": ["agent", "agent name", "agent code", "agent id", "intermediary", "intermediary name", "intermediary code", "advisor", "broker name", "producer", "sales person", "relationship manager"], "exclude": ["type", "commission", "insured", "customer"], "weight": 0.8 },
    { "id": "policy_status", "label": "Policy status", "roles": ["dimension"], "synonyms": ["policy status", "contract status", "renewal status", "policy condition", "inforce status", "coverage status", "current status"], "exclude": ["claim", "payment", "kyc", "marital", "state", "csl", "deductible", "deductable", "number", "premium", "limit", "bind", "annual", "date", "holder", "term", "type"], "valueHints": ["active", "in force", "inforce", "lapsed", "cancelled", "renewed", "not renewed", "expired", "surrendered", "matured", "paid up", "terminated"], "weight": 1.5 },
    { "id": "is_renewed", "label": "Renewed flag", "roles": ["boolean"], "synonyms": ["renewed", "is renewed", "renewal flag", "renewed flag", "retained", "was renewed"], "exclude": ["date", "premium", "status"], "weight": 1 },
    { "id": "region", "label": "Region / state", "roles": ["geo", "dimension"], "synonyms": ["region", "state", "zone", "policy state", "insured state", "location", "branch", "city", "territory"], "exclude": ["id", "code"], "weight": 0.8 },
    { "id": "customer_id", "label": "Policyholder", "roles": ["identifier", "dimension"], "synonyms": ["customer id", "policyholder id", "policy holder id", "insured id", "client id", "member id", "proposer id", "customer number", "policyholder", "insured name", "customer name", "client", "customer", "proposer name", "proposer", "policyholder name", "policy holder name"], "exclude": ["type", "age", "segment", "state", "zip", "sex", "gender", "education", "occupation", "hobbies", "relationship", "income"], "weight": 1 },
    { "id": "commission", "label": "Commission / brokerage", "roles": ["currency", "measure"], "synonyms": ["commission", "commission amount", "brokerage", "acquisition cost", "agent commission", "commission paid", "brokerage amount", "commission payable"], "exclude": ["rate", "percent"], "weight": 0.8 },
    { "id": "claim_id", "label": "Claim number", "roles": ["identifier", "dimension"], "synonyms": ["claim id", "claim number", "claim no", "claim ref", "claim reference", "claim", "intimation number", "claim code", "claim num", "file number", "claim file number"], "exclude": ["amount", "status", "date", "type", "reason", "paid", "value", "count", "total", "injury", "property", "vehicle"], "weight": 2.5, "core": true },
    { "id": "loss_date", "label": "Loss / incident date", "roles": ["datetime"], "synonyms": ["loss date", "date of loss", "incident date", "accident date", "date of accident", "event date", "occurrence date", "date of incident", "admission date", "date of admission", "hospitalization date", "dol"], "exclude": ["reported", "settled", "policy", "discharge"], "weight": 1.5 },
    { "id": "reported_date", "label": "Claim reported date", "roles": ["datetime"], "synonyms": ["reported date", "claim date", "claim reported date", "intimation date", "claim intimation date", "notification date", "fnol date", "date reported", "claim registration date", "registration date", "registered date", "claim filed date", "filing date", "claim submission date", "submission date", "claim lodged date"], "exclude": ["loss", "incident", "accident", "settled", "paid", "closed", "policy"], "weight": 2 },
    { "id": "settled_date", "label": "Claim settled date", "roles": ["datetime"], "synonyms": ["settled date", "settlement date", "claim settlement date", "paid date", "payment date", "closed date", "close date", "closure date", "date settled", "claim closed date", "decision date", "claim paid date", "date of settlement"], "exclude": ["loss", "incident", "reported", "intimation", "policy", "premium", "due"], "weight": 1.5 },
    { "id": "claim_amount", "label": "Claim amount", "roles": ["currency", "measure"], "synonyms": ["claim amount", "claimed amount", "amount claimed", "total claim amount", "gross claim amount", "claim value", "loss amount", "estimated loss", "incurred amount", "incurred", "reserve", "claim reserve", "requested amount", "bill amount", "claim"], "exclude": ["paid", "settled", "approved", "rejected", "sanctioned", "deductible", "deductable", "premium"], "weight": 2, "core": true },
    { "id": "paid_amount", "label": "Claim paid amount", "roles": ["currency", "measure"], "synonyms": ["paid amount", "claim paid", "claims paid", "amount paid", "settled amount", "settlement amount", "approved amount", "net paid", "paid", "payout", "claim payout", "amount settled", "sanctioned amount", "net claim paid", "paid loss"], "exclude": ["premium", "commission", "date", "claimed", "requested", "injury", "property", "vehicle", "medical"], "weight": 2, "core": true },
    { "id": "claim_status", "label": "Claim status", "roles": ["dimension"], "synonyms": ["claim status", "claim state", "settlement status", "claim decision", "decision", "outcome", "claim outcome", "claim stage"], "exclude": ["policy", "payment", "fraud"], "valueHints": ["paid", "settled", "rejected", "repudiated", "denied", "open", "pending", "closed", "approved", "under review", "withdrawn", "partially paid"], "weight": 2 },
    { "id": "claim_type", "label": "Claim / loss type", "roles": ["dimension"], "synonyms": ["claim type", "loss type", "peril", "cause of loss", "incident type", "claim category", "loss cause", "benefit type", "treatment type", "nature of loss", "claim reason"], "exclude": ["id", "status"], "weight": 1 },
    { "id": "fraud_flag", "label": "Fraud flag", "roles": ["boolean"], "synonyms": ["fraud", "fraud flag", "is fraud", "fraud reported", "fraudulent", "suspected fraud", "fraud indicator", "siu referral", "fraud suspected", "potential fraud"], "exclude": ["score", "probability", "reason", "type"], "weight": 1.5 }
  ],
  "valueClasses": {
    "policy_status": [
      { "id": "lapsed", "label": "Lapsed / expired", "keywords": ["lapsed", "lapse", "expired", "not renewed", "non renewed", "nonrenewed", "discontinued", "not taken up"] },
      { "id": "cancelled", "label": "Cancelled / surrendered", "keywords": ["cancelled", "canceled", "cancel", "surrendered", "terminated", "void", "voided", "rescinded", "free look cancellation", "freelook", "withdrawn"] },
      { "id": "renewed", "label": "Renewed", "keywords": ["renewed", "rollover", "rolled over", "renewal done"] },
      { "id": "active", "label": "Active / in force", "keywords": ["active", "in force", "inforce", "in-force", "issued", "live", "current", "paid up", "premium paying", "new business", "new"] }
    ],
    "claim_status": [
      { "id": "rejected", "label": "Rejected / repudiated", "keywords": ["rejected", "repudiated", "denied", "declined", "disallowed", "not admissible", "inadmissible", "closed without payment", "closed no payment", "cwp"] },
      { "id": "paid", "label": "Paid / settled", "keywords": ["paid", "settled", "approved", "partially paid", "partial payment", "fully paid", "disbursed", "closed paid", "closed", "payment done", "sanctioned"] },
      { "id": "open", "label": "Open / pending", "keywords": ["open", "pending", "under review", "in progress", "reported", "registered", "intimated", "under investigation", "investigation", "reopened", "awaiting documents", "query raised", "outstanding", "new", "submitted", "in process"] }
    ]
  },
  "subDomains": [
    { "id": "policies", "name": "Policy register & premium", "description": "One row per policy (or premium transaction) with dates, product, premium, sum insured and status.", "signals": ["policy_id", "policy_start_date", "policy_end_date", "product_line", "premium_written", "sum_insured", "policy_status", "channel"], "grain": "policy" },
    { "id": "claims", "name": "Claims register", "description": "One row per claim with report and settlement dates, claimed and paid amounts, status and type.", "signals": ["claim_id", "policy_id", "reported_date", "settled_date", "claim_amount", "paid_amount", "claim_status", "claim_type", "fraud_flag"], "grain": "claim" },
    { "id": "policy_claims", "name": "Policies with claims", "description": "One row per policy carrying its premium and claim amounts, so loss ratio and claim frequency can be computed.", "signals": ["policy_id", "policy_start_date", "premium_written", "claim_amount", "paid_amount", "product_line", "loss_date", "claim_type", "fraud_flag"], "grain": "policy (with claims)" }
  ],
  "kpis": [
    { "id": "gwp", "name": "Gross written premium", "short": "GWP", "aliases": ["Gross premium", "Written premium", "Premium written", "GDPI", "Total premium"], "definition": "Total premium on policies written in the period.", "formula": "Sum of written premium", "format": "currency", "direction": "higher", "tier": "hero", "priority": 1, "group": "Premium", "subDomains": ["policies", "policy_claims"],
      "variants": [{ "id": "sum", "label": "Sum of written premium", "expr": { "agg": "sum", "of": { "field": "premium_written" } } }],
      "pitfalls": ["If premium repeats on every claim row of a policy, keep policies and claims in separate tables or premium is double-counted."] },
    { "id": "policies", "name": "Policies written", "aliases": ["Policies issued", "Policy count", "Number of policies", "NOP"], "definition": "Distinct policies written (incepted) in the period.", "formula": "Count of distinct policy numbers", "format": "integer", "direction": "higher", "tier": "hero", "priority": 2, "group": "Premium", "subDomains": ["policies", "policy_claims"],
      "variants": [
        { "id": "distinct", "label": "Distinct policy numbers", "expr": { "agg": "countDistinct", "of": "policy_id" } },
        { "id": "rows", "label": "Row count (no policy number)", "expr": { "agg": "count" }, "caveat": "No policy number column, so every row is counted as one policy." }
      ] },
    { "id": "policies_in_force", "name": "Policies in force", "aliases": ["In-force policies", "Active policies"], "definition": "Active policies on the latest snapshot date in the period.", "formula": "Distinct active policies on the latest as-of date (semi-additive)", "format": "integer", "direction": "higher", "tier": "hero", "priority": 3, "group": "Portfolio", "subDomains": ["policies"],
      "variants": [
        { "id": "latest", "label": "Latest snapshot", "expr": { "atLatest": "as_of_date", "expr": { "agg": "countDistinct", "of": "policy_id", "where": { "field": "policy_status", "class": "active" } } } },
        { "id": "status", "label": "Active status", "expr": { "agg": "countDistinct", "of": "policy_id", "where": { "field": "policy_status", "class": "active" } }, "caveat": "No as-of date, so each policy's status is read as of the file extract." }
      ],
      "pitfalls": ["In-force counts are snapshots: never add them across months."] },
    { "id": "renewal_rate", "name": "Renewal rate", "aliases": ["Renewal %", "Renewal ratio", "Persistency", "Persistency ratio"], "definition": "Share of policies due for renewal that were renewed.", "formula": "Renewed policies ÷ (renewed + lapsed policies)", "format": "percent", "direction": "higher", "tier": "hero", "priority": 4, "group": "Retention", "subDomains": ["policies"],
      "variants": [
        { "id": "status", "label": "Renewed ÷ (renewed + lapsed)", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "policy_id", "where": { "field": "policy_status", "class": "renewed" } }, { "agg": "countDistinct", "of": "policy_id", "where": { "or": [{ "field": "policy_status", "class": "renewed" }, { "field": "policy_status", "class": "lapsed" }] } }] } },
        { "id": "flag", "label": "Renewed flag", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "policy_id", "where": { "field": "is_renewed", "isTrue": true } }, { "agg": "countDistinct", "of": "policy_id", "where": { "field": "is_renewed", "notNull": true } }] }, "caveat": "Uses the renewal flag; policies with a blank flag are left out." },
        { "id": "not_active", "label": "Renewed ÷ policies no longer active", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "policy_id", "where": { "field": "policy_status", "class": "renewed" } }, { "agg": "countDistinct", "of": "policy_id", "where": { "and": [{ "field": "policy_status", "notClass": "active" }, { "field": "policy_status", "notClass": "cancelled" }, { "field": "policy_status", "notNull": true }] } }] }, "caveat": "No lapsed status found, so every policy that is neither active nor cancelled is treated as due for renewal." }
      ],
      "pitfalls": ["Policies still mid-term are not yet due, so they sit in neither side of the ratio."] },
    { "id": "loss_ratio", "name": "Loss ratio", "aliases": ["Claims ratio", "Claim ratio", "Loss ratio %", "Incurred claims ratio", "ICR"], "definition": "Claims paid as a share of earned premium.", "formula": "Claims paid ÷ earned premium", "format": "percent", "direction": "lower", "tier": "hero", "priority": 1, "group": "Profitability", "subDomains": ["policy_claims"],
      "variants": [
        { "id": "earned", "label": "Claims paid ÷ earned premium", "expr": { "op": "div", "args": [{ "ref": "claims_paid" }, { "ref": "earned_premium" }] } },
        { "id": "written", "label": "Claims paid ÷ written premium", "expr": { "op": "div", "args": [{ "ref": "claims_paid" }, { "ref": "gwp" }] }, "caveat": "No earned premium column, so written premium is used; this understates the loss ratio while the book is growing." }
      ],
      "benchmark": { "low": 0.6, "high": 0.8, "note": "Indicative for non-life lines; health and motor often run higher, property lower." },
      "pitfalls": ["Paid claims lag the losses: recent periods look profitable until open claims are settled; an incurred view adds outstanding reserves."] },
    { "id": "claims_reported", "name": "Claims reported", "aliases": ["Claims", "Claims intimated", "Claims registered", "Number of claims", "Claim count"], "definition": "Number of distinct claims reported.", "formula": "Count of distinct claim numbers", "format": "integer", "direction": "neutral", "tier": "hero", "priority": 1, "group": "Claims", "subDomains": ["claims", "policy_claims"],
      "variants": [
        { "id": "distinct", "label": "Distinct claim numbers", "expr": { "agg": "countDistinct", "of": "claim_id" } },
        { "id": "amount_rows", "label": "Rows with a claim amount", "expr": { "agg": "count", "where": { "field": "claim_amount", "cmp": "gt", "value": 0 } }, "caveat": "No claim number, so each row with a claim amount counts as one claim." }
      ] },
    { "id": "claims_paid", "name": "Claims paid", "aliases": ["Paid claims", "Claim payout", "Claims paid amount", "Claims settled amount"], "definition": "Total amount paid on claims.", "formula": "Sum of claim paid amount", "format": "currency", "direction": "neutral", "tier": "hero", "priority": 2, "group": "Claims", "subDomains": ["claims", "policy_claims"],
      "variants": [
        { "id": "paid_col", "label": "Sum of paid amount", "expr": { "agg": "sum", "of": { "field": "paid_amount" } } },
        { "id": "status", "label": "Claimed amount on paid claims", "expr": { "agg": "sum", "of": { "field": "claim_amount" }, "where": { "field": "claim_status", "class": "paid" } }, "caveat": "No paid-amount column, so the claimed amount on paid claims is used." },
        { "id": "claimed", "label": "Claimed (incurred) amount", "expr": { "agg": "sum", "of": { "field": "claim_amount" } }, "caveat": "No paid amount or claim status, so claimed (incurred) amounts are used; they can overstate what was actually paid." }
      ] },
    { "id": "claim_settlement_ratio", "name": "Claim settlement ratio", "aliases": ["Claim settlement %", "Settlement ratio"], "definition": "Share of decided claims that were paid.", "formula": "Paid or settled claims ÷ (paid + rejected claims)", "format": "percent", "direction": "higher", "tier": "hero", "priority": 3, "group": "Claims", "subDomains": ["claims", "policy_claims"],
      "variants": [
        { "id": "decided", "label": "Paid ÷ (paid + rejected)", "expr": { "op": "div", "args": [{ "calc": { "ref": "claims_reported" }, "where": { "field": "claim_status", "class": "paid" } }, { "calc": { "ref": "claims_reported" }, "where": { "or": [{ "field": "claim_status", "class": "paid" }, { "field": "claim_status", "class": "rejected" }] } }] } },
        { "id": "not_open", "label": "Paid ÷ claims not open", "expr": { "op": "div", "args": [{ "calc": { "ref": "claims_reported" }, "where": { "field": "claim_status", "class": "paid" } }, { "calc": { "ref": "claims_reported" }, "where": { "and": [{ "field": "claim_status", "notClass": "open" }, { "field": "claim_status", "notNull": true }] } }] }, "caveat": "No rejected claims found, so the denominator is every claim that is not open." }
      ],
      "benchmark": { "low": 0.9, "high": 0.99, "note": "Indicative: published life-insurance settlement ratios by number of claims are usually in the 90s; other lines vary more." },
      "pitfalls": ["Pending claims are left out of both sides, so a large open backlog can flatter the ratio; read it with open claims."] },
    { "id": "avg_settlement_days", "name": "Average settlement time", "aliases": ["Claim settlement TAT", "Settlement TAT", "Days to settle"], "definition": "Average days from claim report to settlement, for paid claims.", "formula": "Average of (settled date − reported date) in days, for paid claims", "format": "days", "direction": "lower", "tier": "hero", "priority": 4, "group": "Claims", "subDomains": ["claims", "policy_claims"],
      "variants": [
        { "id": "status", "label": "Settled − reported (paid claims)", "expr": { "agg": "avg", "of": { "daysBetween": ["reported_date", "settled_date"] }, "where": { "field": "claim_status", "class": "paid" } } },
        { "id": "dates", "label": "Settled − reported (all closed claims)", "expr": { "agg": "avg", "of": { "daysBetween": ["reported_date", "settled_date"] } }, "caveat": "No status column, so every claim with both dates is included, rejections too." },
        { "id": "from_loss", "label": "Settled − loss date (paid claims)", "expr": { "agg": "avg", "of": { "daysBetween": ["loss_date", "settled_date"] }, "where": { "field": "claim_status", "class": "paid" } }, "caveat": "No reported date, so time is measured from the date of loss." }
      ],
      "pitfalls": ["Open claims are not in the average until they settle, so recent periods look faster than they are."] },
    { "id": "avg_claim_severity", "name": "Average claim severity", "aliases": ["Claim severity", "Average claim size", "Average claim amount"], "definition": "Average amount paid per paid claim.", "formula": "Claims paid ÷ number of paid claims", "format": "currency", "direction": "lower", "tier": "hero", "priority": 5, "group": "Claims", "subDomains": ["claims", "policy_claims"],
      "variants": [
        { "id": "status", "label": "Paid amount ÷ paid claims", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "paid_amount" }, "where": { "field": "claim_status", "class": "paid" } }, { "agg": "countDistinct", "of": "claim_id", "where": { "field": "claim_status", "class": "paid" } }] } },
        { "id": "paid_rows", "label": "Paid amount ÷ rows with a payment", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "paid_amount" } }, { "agg": "count", "where": { "field": "paid_amount", "cmp": "gt", "value": 0 } }] }, "caveat": "No status or claim number, so each row with a positive paid amount counts as one paid claim." },
        { "id": "reported", "label": "Claimed amount ÷ claims", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "claim_amount" } }, { "ref": "claims_reported" }] }, "caveat": "No paid amount, so this is the average claimed amount, not the average paid." }
      ],
      "pitfalls": ["A few large losses dominate severity; compare periods with large losses capped or listed separately."] },
    { "id": "earned_premium", "name": "Earned premium", "aliases": ["Net earned premium", "NEP", "Premium earned"], "definition": "Premium earned for cover provided in the period.", "formula": "Sum of earned premium", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 7, "group": "Premium", "subDomains": ["policies", "policy_claims"],
      "variants": [{ "id": "sum", "label": "Sum of earned premium", "expr": { "agg": "sum", "of": { "field": "premium_earned" } } }] },
    { "id": "avg_premium", "name": "Average premium", "aliases": ["Average premium per policy", "Average policy premium"], "definition": "Written premium per policy.", "formula": "Gross written premium ÷ policies", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 8, "group": "Premium", "subDomains": ["policies", "policy_claims"],
      "variants": [{ "id": "ratio", "label": "GWP ÷ policies", "expr": { "op": "div", "args": [{ "ref": "gwp" }, { "ref": "policies" }] } }] },
