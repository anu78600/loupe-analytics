{
  "id": "real_estate",
  "name": "Real Estate",
  "tagline": "Listings, sales, prices per sq ft, rent rolls, occupancy and collections for property businesses",
  "description": "Brokerage, developer and portal exports (MLS, 99acres, MagicBricks, Housing.com, Zillow-style price data, CRM sales registers) and rent rolls from property-management systems such as Yardi, AppFolio or Buildium, including carpet or built-up area, locality and BHK.",
  "icon": "building-2",
  "entity": "property",
  "goals": ["growth", "pricing", "occupancy", "cash flow"],
  "fields": [
    { "id": "property_id", "label": "Property / listing ID", "roles": ["identifier", "dimension"], "synonyms": ["property id", "listing id", "listing number", "listing no", "mls number", "mls id", "mls", "property code", "property number", "property ref", "property reference", "listing reference", "listing ref", "zpid", "inventory id", "prop id"], "exclude": ["unit", "tenant", "lease", "agent", "type", "name", "value", "price", "status"], "weight": 3, "core": true, "description": "Identifies each property or listing; a property relisted later can appear again." },
    { "id": "listing_date", "label": "Listing date", "roles": ["datetime"], "synonyms": ["listing date", "listed date", "list date", "listed on", "listed at", "date listed", "listing start date", "on market date", "date on market", "posted date", "posted on", "launch date", "listing created", "date added"], "exclude": ["sale", "sold", "close", "closing", "closed", "expiry", "expiration", "withdrawn", "lease", "move", "end", "registration", "transfer"], "weight": 2.5, "core": true },
    { "id": "sale_date", "label": "Sale / closing date", "roles": ["datetime"], "synonyms": ["sale date", "sold date", "date sold", "sold on", "close date", "closing date", "closed date", "date of sale", "deal date", "deal closed date", "registration date", "registry date", "date of transfer", "transfer date", "settlement date", "booking date"], "exclude": ["list", "listing", "listed", "lease", "move", "expiry", "posted", "check", "arrival"], "weight": 2.5, "core": true },
    { "id": "list_price", "label": "List / asking price", "roles": ["currency", "measure"], "synonyms": ["list price", "listing price", "asking price", "original list price", "listed price", "ask price", "expected price", "quoted price", "price", "property price", "advertised price", "current price", "lp", "olp"], "exclude": ["sold", "sale", "close", "closing", "final", "per", "sqft", "sqm", "sq", "psf", "rent", "rental", "reduction", "change", "cut", "unit", "room"], "weight": 2.5, "core": true },
    { "id": "sale_price", "label": "Sale / closing price", "roles": ["currency", "measure"], "synonyms": ["sale price", "sold price", "sales price", "selling price", "close price", "closing price", "final price", "transaction price", "transaction value", "deal value", "deal price", "sale value", "sale amount", "agreement value", "consideration value", "registered value", "price paid", "saleprice"], "exclude": ["list", "listing", "asking", "original", "per", "sqft", "sqm", "sq", "psf", "rent", "rental", "expected", "unit", "claim"], "weight": 2.5, "core": true },
    { "id": "area_sqft", "label": "Area (sq ft)", "roles": ["measure"], "synonyms": ["area", "area sqft", "area sq ft", "sqft", "sq ft", "square feet", "square footage", "built up area", "builtup area", "carpet area", "super area", "super built up area", "saleable area", "living area", "floor area", "size sqft", "gla", "sqft living", "living sqft", "total sqft", "gr liv area"], "exclude": ["price", "per", "rate", "psf", "lot", "land", "plot", "acre", "name", "code", "type", "rent"], "weight": 2, "core": true, "description": "Keep one area basis (carpet, built-up or super built-up) across the file." },
    { "id": "price_per_sqft", "label": "Price per sq ft", "roles": ["rate", "currency"], "synonyms": ["price per sqft", "price per sq ft", "price per square foot", "price per square feet", "rate per sqft", "rate per sq ft", "price psf", "psf", "ppsf", "per sqft rate", "price sqft", "rate psf", "average price per sqft"], "weight": 1.5 },
    { "id": "property_type", "label": "Property type", "roles": ["dimension"], "synonyms": ["property type", "type", "home type", "unit type", "asset type", "property category", "building type", "bldg type", "property sub type", "property subtype", "type of property", "category", "asset class", "use type"], "exclude": ["transaction", "sale", "listing", "lease", "room", "tenant", "id"], "valueHints": ["apartment", "flat", "villa", "independent house", "builder floor", "plot", "condo", "townhouse", "single family", "multi family", "studio", "penthouse", "office", "retail", "shop", "warehouse", "commercial", "residential", "detached", "semi-detached", "terraced"], "weight": 1.5 },
    { "id": "bedrooms", "label": "Bedrooms / BHK", "roles": ["measure", "dimension"], "synonyms": ["bedrooms", "beds", "bedroom", "bhk", "no of bedrooms", "number of bedrooms", "bedroom count", "br", "configuration"], "exclude": ["bath", "bathroom", "price"], "weight": 1 },
    { "id": "bathrooms", "label": "Bathrooms", "roles": ["measure", "dimension"], "synonyms": ["bathrooms", "baths", "bath", "no of bathrooms", "number of bathrooms", "full bath", "bathroom count"], "exclude": ["bed", "bedroom"], "weight": 0.8 },
    { "id": "city", "label": "City", "roles": ["geo", "dimension"], "synonyms": ["city", "town", "city name", "metro", "town city", "municipality"], "weight": 1 },
    { "id": "locality", "label": "Locality / neighbourhood", "roles": ["dimension", "geo", "text"], "synonyms": ["locality", "neighbourhood", "neighborhood", "area name", "location", "sector", "suburb", "micro market", "submarket", "sub market", "community", "subdivision", "colony", "project location", "zipcode", "postcode"], "exclude": ["id", "code", "type"], "weight": 1.2 },
    { "id": "state", "label": "State", "roles": ["geo", "dimension"], "synonyms": ["state", "state name", "province", "county", "region"], "weight": 0.8 },
    { "id": "project", "label": "Project / building", "roles": ["dimension"], "synonyms": ["project", "project name", "building", "building name", "property name", "property", "development", "society", "society name", "complex", "tower", "estate", "community name", "site"], "exclude": ["id", "type", "value", "price", "manager", "status"], "weight": 1 },
    { "id": "agent", "label": "Agent / broker", "roles": ["dimension"], "synonyms": ["agent", "agent name", "listing agent", "selling agent", "buyer agent", "broker", "broker name", "realtor", "sales agent", "sales executive", "salesperson", "relationship manager", "channel partner", "listing broker", "list agent", "agency"], "exclude": ["commission", "fee", "phone", "email"], "weight": 1.2 },
    { "id": "listing_status", "label": "Listing status", "roles": ["dimension"], "synonyms": ["listing status", "property status", "sale status", "deal status", "mls status", "availability", "availability status", "inventory status", "current status", "standard status", "status"], "exclude": ["occupancy", "lease", "tenant", "rent", "payment", "unit"], "valueHints": ["sold", "active", "available", "withdrawn", "expired", "pending", "under contract", "closed", "unsold", "coming soon", "contingent", "off market", "for sale"], "weight": 2 },
    { "id": "days_on_market", "label": "Days on market", "roles": ["measure"], "synonyms": ["days on market", "dom", "cdom", "cumulative days on market", "days listed", "listing age", "days to sell", "days on site", "age of listing", "days active"], "weight": 1.5 },
    { "id": "commission", "label": "Commission / brokerage", "roles": ["currency", "measure"], "synonyms": ["commission", "commission amount", "brokerage", "brokerage amount", "agent commission", "gross commission", "gci", "brokerage fee", "commission earned"], "exclude": ["rate", "percent", "split"], "weight": 1 },
    { "id": "unit_id", "label": "Unit ID", "roles": ["identifier", "dimension"], "synonyms": ["unit id", "unit number", "unit no", "unit code", "unit name", "flat number", "flat no", "apartment number", "apartment no", "suite", "suite number", "door number", "space id", "unit ref"], "exclude": ["price", "cost", "sold", "quantity", "type", "status", "rent", "area", "sqft"], "weight": 2.5, "core": true, "description": "Identifies each rentable unit in a rent roll." },
    { "id": "snapshot_date", "label": "Rent roll / snapshot date", "roles": ["datetime"], "synonyms": ["as of date", "as at date", "snapshot date", "report date", "rent roll date", "rent month", "billing month", "period", "month", "statement date", "billing period", "month end", "posting month"], "weight": 1 },
    { "id": "occupancy_status", "label": "Occupancy status", "roles": ["dimension"], "synonyms": ["occupancy status", "occupancy", "unit status", "lease status", "tenancy status", "vacancy status", "occupied", "rent status", "unit occupancy", "status"], "exclude": ["listing", "sale", "payment", "mls"], "valueHints": ["occupied", "vacant", "notice", "on notice", "rented", "leased", "vacant rented", "vacant unrented", "notice unrented", "model", "down", "under renovation"], "weight": 2 },
    { "id": "tenant", "label": "Tenant", "roles": ["dimension", "identifier"], "synonyms": ["tenant", "tenant name", "tenant id", "lessee", "lessee name", "resident", "resident name", "occupant", "renter", "licensee"], "weight": 1 },
    { "id": "monthly_rent", "label": "Monthly rent", "roles": ["currency", "measure"], "synonyms": ["monthly rent", "rent", "rent amount", "contract rent", "lease rent", "current rent", "base rent", "rent per month", "rental", "rental amount", "monthly rental", "actual rent", "scheduled rent", "rent pm", "lease amount"], "exclude": ["due", "collected", "received", "paid", "balance", "outstanding", "arrears", "annual", "yearly", "deposit", "market", "asking", "sqft", "date"], "weight": 2.5, "core": true },
    { "id": "rent_due", "label": "Rent billed / due", "roles": ["currency", "measure"], "synonyms": ["rent due", "amount due", "billed", "billed amount", "rent billed", "rent charged", "invoiced amount", "demand", "demand amount", "total due", "amount billed", "rent receivable"], "exclude": ["collected", "received", "paid", "date", "market", "asking", "potential", "advertised"], "weight": 1.5 },
    { "id": "rent_collected", "label": "Rent collected", "roles": ["currency", "measure"], "synonyms": ["rent collected", "collected", "amount collected", "rent received", "received", "amount received", "rent paid", "payments received", "collections", "receipts", "total paid"], "exclude": ["due", "billed", "date", "deposit"], "weight": 1.5 },
    { "id": "property_value", "label": "Property value", "roles": ["currency", "measure"], "synonyms": ["property value", "market value", "valuation", "current value", "appraised value", "appraisal value", "asset value", "fair value", "fair market value", "purchase price", "acquisition cost", "acquisition price", "book value", "cost basis", "investment value"], "exclude": ["rent", "rental", "lease", "deposit"], "weight": 1.5 },
    { "id": "market_rent", "label": "Market rent", "roles": ["currency", "measure"], "synonyms": ["market rent", "asking rent", "advertised rent", "potential rent", "gross potential rent", "gpr", "list rent", "street rent"], "weight": 0.8, "description": "Rent the unit could achieve today, used to measure loss to lease." },
    { "id": "lease_start", "label": "Lease start date", "roles": ["datetime"], "synonyms": ["lease start", "lease start date", "lease from", "move in", "move in date", "tenancy start", "tenancy start date", "agreement start date", "commencement date", "lease commencement", "start date"], "exclude": ["end", "expiry", "to"], "weight": 1.5 },
    { "id": "lease_end", "label": "Lease end date", "roles": ["datetime"], "synonyms": ["lease end", "lease end date", "lease to", "lease expiry", "lease expiration", "expiry date", "expiration date", "tenancy end", "agreement end date", "move out", "move out date", "end date"], "exclude": ["start", "from", "commencement"], "weight": 1.5 },
    { "id": "operating_expense", "label": "Operating expenses", "roles": ["currency", "measure"], "synonyms": ["operating expenses", "operating expense", "opex", "expenses", "property expenses", "maintenance cost", "maintenance", "repairs", "repairs and maintenance", "service charges", "hoa fees"], "weight": 0.8 }
  ],
  "valueClasses": {
    "listing_status": [
      { "id": "sold", "label": "Sold / closed", "keywords": ["sold", "closed", "sale closed", "deal closed", "registered", "registration done", "booked", "completed", "settled", "transferred", "possession given"] },
      { "id": "withdrawn", "label": "Withdrawn / expired", "keywords": ["withdrawn", "expired", "cancelled", "canceled", "off market", "terminated", "delisted", "inactive", "lapsed", "removed", "deactivated"] },
      { "id": "pending", "label": "Under contract", "keywords": ["pending", "under contract", "under offer", "contingent", "sale agreed", "token received", "token paid", "reserved", "on hold", "agreement signed", "active under contract"] },
      { "id": "active", "label": "Active / available", "keywords": ["active", "available", "for sale", "listed", "new listing", "coming soon", "price reduced", "back on market", "unsold", "live", "open"] }
    ],
    "occupancy_status": [
      { "id": "vacant", "label": "Vacant", "keywords": ["vacant", "unoccupied", "not occupied", "empty", "available", "unleased", "unlet", "to let", "vacant rented", "vacant unrented", "vacant ready", "vacant not ready"] },
      { "id": "occupied", "label": "Occupied", "keywords": ["occupied", "leased", "rented", "let", "tenanted", "on notice", "notice", "notice rented", "notice unrented", "occupied no notice", "in place", "under lease"] }
    ]
  },
  "subDomains": [
    { "id": "listings", "name": "Listings & sales", "description": "One row per listing or sale with dates, asking and achieved prices.", "signals": ["property_id", "listing_date", "sale_date", "list_price", "sale_price", "area_sqft", "listing_status", "property_type", "locality"], "grain": "listing" },
    { "id": "prices", "name": "Property prices", "description": "One row per property with price, size and location but no listing dates, as in housing-price datasets and portal scrapes.", "signals": ["list_price", "area_sqft", "bedrooms", "bathrooms", "property_type", "locality", "price_per_sqft"], "grain": "property" },
    { "id": "rentals", "name": "Rent roll & leases", "description": "One row per unit (optionally per rent-roll date) with tenant, occupancy, rent and collections.", "signals": ["unit_id", "tenant", "occupancy_status", "monthly_rent", "rent_due", "rent_collected", "lease_start", "lease_end", "project"], "grain": "unit (per rent-roll date)" }
  ],
  "kpis": [
    { "id": "sales_volume", "name": "Sales volume", "definition": "Total value of the properties sold.", "formula": "Sum of sale price on sold listings", "format": "currency", "direction": "higher", "tier": "hero", "priority": 1, "group": "Sales", "subDomains": ["listings"],
      "variants": [
        { "id": "status", "label": "Sale price on sold listings", "expr": { "agg": "sum", "of": { "field": "sale_price" }, "where": { "field": "listing_status", "class": "sold" } } },
        { "id": "sale_date", "label": "Sale price where a sale date exists", "expr": { "agg": "sum", "of": { "field": "sale_price" }, "where": { "field": "sale_date", "notNull": true } }, "caveat": "No status column, so a listing counts as sold when it has a sale date." },
        { "id": "all", "label": "All sale prices", "expr": { "agg": "sum", "of": { "field": "sale_price" } }, "caveat": "No status or sale date, so every row with a sale price is treated as a completed sale." }
      ],
      "pitfalls": ["Trend sales by sale date, not listing date, so each sale lands in the month it closed."] },
    { "id": "properties_sold", "name": "Properties sold", "definition": "Number of distinct properties that sold.", "formula": "Count of distinct property IDs with a sold status", "format": "integer", "direction": "higher", "tier": "hero", "priority": 2, "group": "Sales", "subDomains": ["listings"],
      "variants": [
        { "id": "status", "label": "Distinct sold properties", "expr": { "agg": "countDistinct", "of": "property_id", "where": { "field": "listing_status", "class": "sold" } } },
        { "id": "sale_date", "label": "Distinct properties with a sale date", "expr": { "agg": "countDistinct", "of": "property_id", "where": { "field": "sale_date", "notNull": true } }, "caveat": "No status column, so a property counts as sold when it has a sale date." },
        { "id": "sale_price", "label": "Distinct properties with a sale price", "expr": { "agg": "countDistinct", "of": "property_id", "where": { "field": "sale_price", "notNull": true } }, "caveat": "No status or sale date, so any property with a sale price counts as sold." },
        { "id": "rows", "label": "Sold rows (no property ID)", "expr": { "agg": "count", "where": { "field": "listing_status", "class": "sold" } }, "caveat": "No property ID, so each sold row counts as one property." }
      ] },
    { "id": "avg_sale_price", "name": "Average sale price", "definition": "Average price achieved per sale.", "formula": "Sum of sale price ÷ number of sales (sold listings with a price)", "format": "currency", "direction": "higher", "tier": "hero", "priority": 3, "group": "Pricing", "subDomains": ["listings", "prices"],
      "variants": [
        { "id": "status", "label": "Average sale price on sold listings", "expr": { "agg": "avg", "of": { "field": "sale_price" }, "where": { "field": "listing_status", "class": "sold" } } },
        { "id": "all", "label": "Average of all sale prices", "expr": { "agg": "avg", "of": { "field": "sale_price" } }, "caveat": "No status column, so every row with a sale price is treated as a sale." },
        { "id": "asking", "label": "Average list price", "expr": { "agg": "avg", "of": { "field": "list_price" } }, "caveat": "No sale price column, so this is the average listed (asking) price." }
      ],
      "pitfalls": ["A few premium sales pull the average up; read it next to the median sale price."] },
    { "id": "price_per_sqft", "name": "Price per sq ft", "short": "PSF", "definition": "Achieved price per square foot across sold properties.", "formula": "Σ sale price ÷ Σ area over sold listings that have both (area-weighted, never an average of per-listing rates)", "format": "currency", "direction": "neutral", "tier": "hero", "priority": 4, "group": "Pricing", "subDomains": ["listings", "prices"],
      "variants": [
        { "id": "sold", "label": "Σ sale price ÷ Σ area (sold)", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "sale_price" }, "where": { "and": [{ "field": "listing_status", "class": "sold" }, { "field": "area_sqft", "notNull": true }] } }, { "agg": "sum", "of": { "field": "area_sqft" }, "where": { "and": [{ "field": "listing_status", "class": "sold" }, { "field": "sale_price", "notNull": true }] } }] } },
        { "id": "priced", "label": "Σ sale price ÷ Σ area (rows with both)", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "sale_price" }, "where": { "field": "area_sqft", "notNull": true } }, { "agg": "sum", "of": { "field": "area_sqft" }, "where": { "field": "sale_price", "notNull": true } }] }, "caveat": "No status column, so every row with a sale price and an area is included." },
        { "id": "rate_col", "label": "Per-sq-ft rate weighted by area", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "mul", "args": [{ "field": "price_per_sqft" }, { "field": "area_sqft" }] } }, { "agg": "sum", "of": { "field": "area_sqft" }, "where": { "field": "price_per_sqft", "notNull": true } }] }, "caveat": "Built from the per-sq-ft rate column, weighted by each property's area." },
        { "id": "asking", "label": "Σ list price ÷ Σ area", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "list_price" }, "where": { "field": "area_sqft", "notNull": true } }, { "agg": "sum", "of": { "field": "area_sqft" }, "where": { "field": "list_price", "notNull": true } }] }, "caveat": "No sale price, so this is the asking price per sq ft, not the price achieved." }
      ],
      "pitfalls": ["Mixing carpet, built-up and super built-up area in one column makes price per sq ft incomparable."] },
    { "id": "avg_days_on_market", "name": "Average days on market", "short": "DOM", "definition": "Average days a sold property spent on the market, from listing to sale.", "formula": "Average of (sale date − listing date) in days, for sold listings", "format": "days", "direction": "lower", "tier": "hero", "priority": 5, "group": "Velocity", "subDomains": ["listings"],
      "variants": [
        { "id": "dates_status", "label": "Sale date − listing date (sold)", "expr": { "agg": "avg", "of": { "daysBetween": ["listing_date", "sale_date"] }, "where": { "field": "listing_status", "class": "sold" } } },
        { "id": "dates", "label": "Sale date − listing date", "expr": { "agg": "avg", "of": { "daysBetween": ["listing_date", "sale_date"] } }, "caveat": "No status column, so every listing with both dates is included." },
        { "id": "dom_status", "label": "Days-on-market column (sold)", "expr": { "agg": "avg", "of": { "field": "days_on_market" }, "where": { "field": "listing_status", "class": "sold" } }, "caveat": "Uses the days-on-market column as reported by the source." },
        { "id": "dom", "label": "Days-on-market column", "expr": { "agg": "avg", "of": { "field": "days_on_market" } }, "caveat": "Uses the days-on-market column for every listing, including unsold ones still counting up." }
      ],
      "pitfalls": ["Relisting resets the listing date and hides the true time on market; prefer cumulative days on market when the source has it."] },
    { "id": "sale_to_list", "name": "Sale-to-list ratio", "definition": "Achieved sale price as a share of the asking price, on sold listings.", "formula": "Σ sale price ÷ Σ list price over sold listings with both prices", "format": "percent", "direction": "higher", "tier": "hero", "priority": 6, "group": "Pricing", "subDomains": ["listings"],
      "variants": [
        { "id": "status", "label": "Σ sale ÷ Σ list price (sold)", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "sale_price" }, "where": { "and": [{ "field": "listing_status", "class": "sold" }, { "field": "list_price", "notNull": true }] } }, { "agg": "sum", "of": { "field": "list_price" }, "where": { "and": [{ "field": "listing_status", "class": "sold" }, { "field": "sale_price", "notNull": true }] } }] } },
        { "id": "priced", "label": "Σ sale ÷ Σ list price (rows with both)", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "sale_price" }, "where": { "field": "list_price", "notNull": true } }, { "agg": "sum", "of": { "field": "list_price" }, "where": { "field": "sale_price", "notNull": true } }] }, "caveat": "No status column, so every row with both prices is included." }
      ],
      "benchmark": { "low": 0.95, "high": 1.0, "note": "Indicative for balanced residential markets; above 100% signals competitive bidding, well below signals over-pricing." },
      "pitfalls": ["Use the original list price: comparing against the last reduced price hides price cuts."] },
    { "id": "listings", "name": "Listings", "definition": "Number of distinct properties listed in the period.", "formula": "Count of distinct property IDs", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 7, "group": "Inventory", "subDomains": ["listings", "prices"],
      "variants": [
        { "id": "distinct", "label": "Distinct property IDs", "expr": { "agg": "countDistinct", "of": "property_id" } },
        { "id": "rows", "label": "Row count (no property ID)", "expr": { "agg": "count" }, "caveat": "No property ID column, so every row is counted as one listing." }
      ] },
    { "id": "absorption_rate", "name": "Absorption rate", "definition": "Share of the period's listings that have sold.", "formula": "Properties sold ÷ listings", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 8, "group": "Velocity", "subDomains": ["listings"],
      "variants": [{ "id": "ratio", "label": "Properties sold ÷ listings", "expr": { "op": "div", "args": [{ "ref": "properties_sold" }, { "ref": "listings" }] } }],
      "pitfalls": ["Read by listing date this is each cohort's sell-through; recent cohorts look low until they have had time to sell."] },
    { "id": "median_sale_price", "name": "Median sale price", "definition": "Middle sale price: half of sales closed above it and half below.", "formula": "Median of sale price on sold listings", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 9, "group": "Pricing", "subDomains": ["listings", "prices"],
      "variants": [
        { "id": "status", "label": "Median sale price (sold)", "expr": { "agg": "median", "of": { "field": "sale_price" }, "where": { "field": "listing_status", "class": "sold" } } },
        { "id": "all", "label": "Median of all sale prices", "expr": { "agg": "median", "of": { "field": "sale_price" } }, "caveat": "No status column, so every row with a sale price is treated as a sale." },
        { "id": "asking", "label": "Median list price", "expr": { "agg": "median", "of": { "field": "list_price" } }, "caveat": "No sale price column, so this is the median listed (asking) price." }
      ] },
    { "id": "active_listings", "name": "Active listings", "definition": "Listings from the period that are still on the market.", "formula": "Distinct property IDs whose current status is active", "format": "integer", "direction": "neutral", "tier": "supporting", "priority": 10, "group": "Inventory", "subDomains": ["listings"],
      "variants": [{ "id": "status", "label": "Active status", "expr": { "calc": { "ref": "listings" }, "where": { "field": "listing_status", "class": "active" } } }],
      "pitfalls": ["Status is as of the export date, so this counts listings still active today, not inventory at each month end."] },
    { "id": "withdrawal_rate", "name": "Withdrawal rate", "definition": "Share of listings withdrawn or expired without selling.", "formula": "Withdrawn or expired listings ÷ listings", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 11, "group": "Velocity", "subDomains": ["listings"],
      "variants": [{ "id": "status", "label": "Withdrawn ÷ listings", "expr": { "op": "div", "args": [{ "calc": { "ref": "listings" }, "where": { "field": "listing_status", "class": "withdrawn" } }, { "ref": "listings" }] } }] },
    { "id": "commission_earned", "name": "Commission earned", "definition": "Commission or brokerage earned on sales.", "formula": "Sum of commission on sold listings", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 12, "group": "Revenue", "subDomains": ["listings"],
      "variants": [
        { "id": "status", "label": "Commission on sold listings", "expr": { "agg": "sum", "of": { "field": "commission" }, "where": { "field": "listing_status", "class": "sold" } } },
        { "id": "all", "label": "All commission", "expr": { "agg": "sum", "of": { "field": "commission" } }, "caveat": "No status column, so commission on every row is included." }
      ] },
    { "id": "avg_area", "name": "Average area (sq ft)", "definition": "Average size of the listed properties.", "formula": "Average of area over properties that have one", "format": "number", "direction": "neutral", "tier": "detail", "priority": 41, "group": "Inventory", "subDomains": ["listings", "prices"],
      "variants": [{ "id": "avg", "label": "Average area", "expr": { "agg": "avg", "of": { "field": "area_sqft" } } }] },
    { "id": "occupancy_rate", "name": "Occupancy rate", "definition": "Share of units occupied on the latest rent-roll date in the period.", "formula": "Occupied units ÷ total units on the latest snapshot date (semi-additive)", "format": "percent", "direction": "higher", "tier": "hero", "priority": 1, "group": "Leasing", "subDomains": ["rentals"],
      "variants": [
        { "id": "latest", "label": "Latest rent roll", "expr": { "atLatest": "snapshot_date", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "unit_id", "where": { "field": "occupancy_status", "class": "occupied" } }, { "agg": "countDistinct", "of": "unit_id" }] } } },
        { "id": "single", "label": "Single rent roll", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "unit_id", "where": { "field": "occupancy_status", "class": "occupied" } }, { "agg": "countDistinct", "of": "unit_id" }] }, "caveat": "No snapshot date, so the file is treated as one point-in-time rent roll." }
      ],
      "benchmark": { "low": 0.9, "high": 0.97, "note": "Indicative for stabilised residential portfolios; varies by market and asset type." },
      "pitfalls": ["Occupancy is a snapshot: each period shows its latest rent roll; months are never added or averaged."] },
    { "id": "rent_collection_rate", "name": "Rent collection rate", "definition": "Share of the rent billed in the period that was collected.", "formula": "Σ rent collected ÷ Σ rent billed", "format": "percent", "direction": "higher", "tier": "hero", "priority": 2, "group": "Collections", "subDomains": ["rentals"],
      "variants": [
        { "id": "billed", "label": "Collected ÷ billed", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "rent_collected" } }, { "agg": "sum", "of": { "field": "rent_due" } }] } },
        { "id": "contract_occupied", "label": "Collected ÷ contract rent (occupied units)", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "rent_collected" } }, { "agg": "sum", "of": { "field": "monthly_rent" }, "where": { "field": "occupancy_status", "class": "occupied" } }] }, "caveat": "No billed column, so contracted rent on occupied units is used as the amount due." },
        { "id": "contract", "label": "Collected ÷ contract rent", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "rent_collected" } }, { "agg": "sum", "of": { "field": "monthly_rent" } }] }, "caveat": "No billed or occupancy column, so contracted rent on every unit is used as the amount due." }
      ],
      "pitfalls": ["Arrears paid late land in the month they are received and can push that month above 100%."] },
    { "id": "gross_rental_yield", "name": "Gross rental yield", "definition": "Annual rent as a share of property value.", "formula": "Σ (monthly rent × 12) ÷ Σ property value, over rows that have both", "format": "percent", "direction": "higher", "tier": "hero", "priority": 3, "group": "Returns", "subDomains": ["rentals"],
      "variants": [{ "id": "ratio", "label": "Annual rent ÷ property value", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "mul", "args": [{ "field": "monthly_rent" }, { "num": 12 }] }, "where": { "field": "property_value", "notNull": true } }, { "agg": "sum", "of": { "field": "property_value" }, "where": { "field": "monthly_rent", "notNull": true } }] } }],
      "pitfalls": ["Value must sit at the same grain as rent: a building value repeated on every unit row understates the yield."] },
    { "id": "rent_roll", "name": "Monthly rent roll", "definition": "Contracted monthly rent on occupied units at the latest snapshot.", "formula": "Σ monthly rent on occupied units on the latest rent-roll date (semi-additive)", "format": "currency", "direction": "higher", "tier": "hero", "priority": 4, "group": "Leasing", "subDomains": ["rentals"],
      "variants": [
        { "id": "latest", "label": "Latest rent roll, occupied units", "expr": { "atLatest": "snapshot_date", "expr": { "agg": "sum", "of": { "field": "monthly_rent" }, "where": { "field": "occupancy_status", "class": "occupied" } } } },
        { "id": "single", "label": "Single rent roll, occupied units", "expr": { "agg": "sum", "of": { "field": "monthly_rent" }, "where": { "field": "occupancy_status", "class": "occupied" } }, "caveat": "No snapshot date, so the file is treated as one point-in-time rent roll." },
        { "id": "latest_all", "label": "Latest rent roll, all units", "expr": { "atLatest": "snapshot_date", "expr": { "agg": "sum", "of": { "field": "monthly_rent" } } }, "caveat": "No occupancy status, so rent on every unit is included." },
        { "id": "all", "label": "All units", "expr": { "agg": "sum", "of": { "field": "monthly_rent" } }, "caveat": "No snapshot date or occupancy status, so the file is read as one rent roll and every unit's rent is included." }
      ] },
    { "id": "vacancy_rate", "name": "Vacancy rate", "definition": "Share of units vacant on the latest rent-roll date in the period.", "formula": "Vacant units ÷ total units on the latest snapshot date (semi-additive)", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 5, "group": "Leasing", "subDomains": ["rentals"],
      "variants": [
        { "id": "latest", "label": "Latest rent roll", "expr": { "atLatest": "snapshot_date", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "unit_id", "where": { "field": "occupancy_status", "class": "vacant" } }, { "agg": "countDistinct", "of": "unit_id" }] } } },
        { "id": "single", "label": "Single rent roll", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "unit_id", "where": { "field": "occupancy_status", "class": "vacant" } }, { "agg": "countDistinct", "of": "unit_id" }] }, "caveat": "No snapshot date, so the file is treated as one point-in-time rent roll." }
      ],
      "pitfalls": ["Occupancy and vacancy need not add to 100%: down, model and other non-revenue units sit in neither."] },
    { "id": "total_units", "name": "Units", "definition": "Distinct rentable units on the latest rent-roll date.", "formula": "Distinct unit IDs on the latest snapshot date (semi-additive)", "format": "integer", "direction": "neutral", "tier": "supporting", "priority": 6, "group": "Leasing", "subDomains": ["rentals"],
      "variants": [
        { "id": "latest", "label": "Latest rent roll", "expr": { "atLatest": "snapshot_date", "expr": { "agg": "countDistinct", "of": "unit_id" } } },
        { "id": "single", "label": "Single rent roll", "expr": { "agg": "countDistinct", "of": "unit_id" }, "caveat": "No snapshot date, so the file is treated as one point-in-time rent roll." }
      ] },
    { "id": "rent_arrears", "name": "Rent arrears", "definition": "Rent billed in the period that has not been collected.", "formula": "Σ rent billed − Σ rent collected", "format": "currency", "direction": "lower", "tier": "supporting", "priority": 7, "group": "Collections", "subDomains": ["rentals"],
      "variants": [{ "id": "diff", "label": "Billed − collected", "expr": { "op": "sub", "args": [{ "agg": "sum", "of": { "field": "rent_due" } }, { "agg": "sum", "of": { "field": "rent_collected" } }] } }] },
    { "id": "avg_rent_per_unit", "name": "Average rent per occupied unit", "definition": "Average contracted monthly rent of an occupied unit at the latest snapshot.", "formula": "Rent on occupied units ÷ occupied units, on the latest rent-roll date", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 8, "group": "Leasing", "subDomains": ["rentals"],
      "variants": [
        { "id": "latest", "label": "Latest rent roll", "expr": { "atLatest": "snapshot_date", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "monthly_rent" }, "where": { "field": "occupancy_status", "class": "occupied" } }, { "agg": "countDistinct", "of": "unit_id", "where": { "field": "occupancy_status", "class": "occupied" } }] } } },
        { "id": "single", "label": "Single rent roll", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "monthly_rent" }, "where": { "field": "occupancy_status", "class": "occupied" } }, { "agg": "countDistinct", "of": "unit_id", "where": { "field": "occupancy_status", "class": "occupied" } }] }, "caveat": "No snapshot date, so the file is treated as one point-in-time rent roll." }
      ] },
    { "id": "noi", "name": "Net operating income", "short": "NOI", "definition": "Rent collected minus property operating expenses (cash basis).", "formula": "Σ rent collected − Σ operating expenses", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 9, "group": "Returns", "subDomains": ["rentals"],
      "variants": [
        { "id": "collected", "label": "Collected − expenses", "expr": { "op": "sub", "args": [{ "agg": "sum", "of": { "field": "rent_collected" } }, { "agg": "sum", "of": { "field": "operating_expense" } }] } },
        { "id": "billed", "label": "Billed − expenses", "expr": { "op": "sub", "args": [{ "agg": "sum", "of": { "field": "rent_due" } }, { "agg": "sum", "of": { "field": "operating_expense" } }] }, "caveat": "No collections column, so rent billed is used instead of cash received." }
      ],
      "pitfalls": ["NOI excludes loan repayments, capital spend and depreciation; it is not cash flow after financing."] },
    { "id": "loss_to_lease", "name": "Loss to lease", "definition": "How far contracted rents on occupied units sit below market rents at the latest snapshot.", "formula": "(Σ market rent − Σ contract rent) ÷ Σ market rent, on occupied units with both, on the latest rent-roll date", "format": "percent", "direction": "lower", "tier": "detail", "priority": 41, "group": "Leasing", "subDomains": ["rentals"],
      "variants": [
        { "id": "latest", "label": "Latest rent roll, occupied units", "expr": { "atLatest": "snapshot_date", "expr": { "op": "div", "args": [{ "op": "sub", "args": [{ "agg": "sum", "of": { "field": "market_rent" }, "where": { "and": [{ "field": "occupancy_status", "class": "occupied" }, { "field": "monthly_rent", "notNull": true }] } }, { "agg": "sum", "of": { "field": "monthly_rent" }, "where": { "and": [{ "field": "occupancy_status", "class": "occupied" }, { "field": "market_rent", "notNull": true }] } }] }, { "agg": "sum", "of": { "field": "market_rent" }, "where": { "and": [{ "field": "occupancy_status", "class": "occupied" }, { "field": "monthly_rent", "notNull": true }] } }] } } },
        { "id": "single", "label": "Single rent roll, occupied units", "expr": { "op": "div", "args": [{ "op": "sub", "args": [{ "agg": "sum", "of": { "field": "market_rent" }, "where": { "and": [{ "field": "occupancy_status", "class": "occupied" }, { "field": "monthly_rent", "notNull": true }] } }, { "agg": "sum", "of": { "field": "monthly_rent" }, "where": { "and": [{ "field": "occupancy_status", "class": "occupied" }, { "field": "market_rent", "notNull": true }] } }] }, { "agg": "sum", "of": { "field": "market_rent" }, "where": { "and": [{ "field": "occupancy_status", "class": "occupied" }, { "field": "monthly_rent", "notNull": true }] } }] }, "caveat": "No snapshot date, so the file is treated as one point-in-time rent roll." },
        { "id": "all", "label": "All units with both rents", "expr": { "op": "div", "args": [{ "op": "sub", "args": [{ "agg": "sum", "of": { "field": "market_rent" }, "where": { "field": "monthly_rent", "notNull": true } }, { "agg": "sum", "of": { "field": "monthly_rent" }, "where": { "field": "market_rent", "notNull": true } }] }, { "agg": "sum", "of": { "field": "market_rent" }, "where": { "field": "monthly_rent", "notNull": true } }] }, "caveat": "No snapshot date or occupancy status, so every unit with both rents is included." }
      ],
      "pitfalls": ["Market rent is an estimate; a stale market-rent column overstates or hides the gap."] },
    { "id": "avg_lease_term", "name": "Average lease term (months)", "definition": "Average contracted lease length in months.", "formula": "Average of (lease end − lease start) in days ÷ 30.44", "format": "decimal", "direction": "neutral", "tier": "detail", "priority": 40, "group": "Leasing", "subDomains": ["rentals"],
      "variants": [{ "id": "dates", "label": "Lease end − lease start", "expr": { "op": "div", "args": [{ "agg": "avg", "of": { "daysBetween": ["lease_start", "lease_end"] } }, { "num": 30.4375 }] } }] }
  ],
  "charts": [
    { "id": "sales_trend", "title": "Sales volume over time", "kind": "area", "section": "trend", "x": { "time": "sale_date" }, "measures": ["sales_volume"], "reason": "One value measure over continuous time, bucketed by sale date so each sale lands in the month it closed; the soft fill shows volume without hiding the shape.", "alternatives": ["line", "bar"], "size": { "w": 8, "h": 4 }, "priority": 1, "subDomains": ["listings"] },
    { "id": "sold_trend", "title": "Properties sold per month", "kind": "bar", "section": "trend", "x": { "time": "sale_date", "grain": "month" }, "measures": ["properties_sold"], "reason": "Sales counts per month are discrete totals, so columns from a zero baseline compare them honestly.", "alternatives": ["line"], "size": { "w": 4, "h": 4 }, "priority": 2, "subDomains": ["listings"] },
    { "id": "psf_trend", "title": "Price per sq ft over time", "kind": "line", "section": "trend", "x": { "time": "sale_date" }, "measures": ["price_per_sqft"], "reason": "Price per sq ft is a ratio, so it is recomputed per period (Σ price ÷ Σ area) and drawn as a line, never summed.", "alternatives": ["bar"], "size": { "w": 6, "h": 4 }, "priority": 3, "subDomains": ["listings"] },
    { "id": "psf_by_locality", "title": "Price per sq ft by locality", "kind": "hbar", "section": "breakdown", "x": { "field": "locality" }, "measures": ["price_per_sqft"], "topN": 12, "others": false, "minGroupRows": 20, "drill": ["city", "locality", "project"], "reason": "A ratio compared across many localities: sorted bars of the recomputed price per sq ft, with localities under 20 listings hidden as too small to trust.", "alternatives": ["bar", "table"], "size": { "w": 6, "h": 5 }, "priority": 1, "subDomains": ["listings", "prices"] },
    { "id": "volume_by_type", "title": "Sales volume by property type", "kind": "donut", "section": "breakdown", "x": { "field": "property_type" }, "measures": ["sales_volume"], "topN": 6, "others": true, "reason": "Part-to-whole across a handful of property types: a donut shows the split at a glance.", "alternatives": ["hbar", "treemap"], "size": { "w": 4, "h": 4 }, "priority": 2, "subDomains": ["listings"] },
    { "id": "dom_by_type", "title": "Days on market by property type", "kind": "hbar", "section": "drivers", "x": { "field": "property_type" }, "measures": ["avg_days_on_market"], "topN": 10, "others": false, "minGroupRows": 20, "reason": "Which property types sell slowest: average days on market per type, sorted, with types under 20 listings hidden.", "alternatives": ["bar"], "size": { "w": 4, "h": 4 }, "priority": 1, "subDomains": ["listings"] },
    { "id": "psf_distribution", "title": "Distribution of price per sq ft", "kind": "histogram", "section": "drivers", "x": { "bins": { "op": "div", "args": [{ "field": "sale_price" }, { "field": "area_sqft" }] }, "count": 12, "format": "currency", "label": "Price per sq ft band" }, "measures": ["properties_sold"], "reason": "How achieved prices per sq ft spread across sold properties: a histogram counts properties per band instead of averaging their rates.", "alternatives": ["bar"], "size": { "w": 6, "h": 4 }, "priority": 2, "subDomains": ["listings"] },
    { "id": "price_distribution", "title": "Distribution of listed prices", "kind": "histogram", "section": "drivers", "x": { "bins": { "field": "list_price" }, "count": 12, "format": "currency", "label": "List price band" }, "measures": ["listings"], "reason": "How listed prices are distributed: a histogram of properties per price band shows where supply sits.", "alternatives": ["bar"], "size": { "w": 6, "h": 4 }, "priority": 2, "subDomains": ["prices"] },
    { "id": "agent_table", "title": "Agent performance", "kind": "table", "section": "detail", "x": { "field": "agent" }, "measures": ["sales_volume", "properties_sold", "avg_days_on_market", "sale_to_list"], "topN": 25, "others": false, "reason": "Several measures per agent: a sortable table carries more than any single chart.", "alternatives": ["hbar"], "size": { "w": 12, "h": 6 }, "priority": 1, "subDomains": ["listings"] },
    { "id": "occupancy_trend", "title": "Occupancy over time", "kind": "line", "section": "trend", "x": { "time": "snapshot_date" }, "measures": ["occupancy_rate"], "reason": "Occupancy is a snapshot ratio: each period shows its latest rent roll as a line, never summed across months.", "alternatives": ["area", "bar"], "size": { "w": 8, "h": 4 }, "priority": 1, "subDomains": ["rentals"] },
    { "id": "unit_status_mix", "title": "Units by occupancy status", "kind": "donut", "section": "breakdown", "x": { "field": "occupancy_status" }, "measures": ["total_units"], "topN": 6, "others": true, "reason": "Part-to-whole across a few statuses (occupied, vacant, notice, down): a donut shows the mix on the latest rent roll.", "alternatives": ["hbar"], "size": { "w": 4, "h": 4 }, "priority": 1, "subDomains": ["rentals"] },
    { "id": "occupancy_by_building", "title": "Occupancy by building", "kind": "hbar", "section": "drivers", "x": { "field": "project" }, "measures": ["occupancy_rate"], "topN": 15, "others": false, "minGroupRows": 20, "reason": "A rate compared across buildings: sorted bars of the occupancy recomputed on each building's latest rent roll, with buildings under 20 rows hidden as too small.", "alternatives": ["bar", "table"], "size": { "w": 6, "h": 5 }, "priority": 1, "subDomains": ["rentals"] }
  ],
  "pitfalls": [
    "Price per sq ft, sale-to-list and yields are ratios of totals: never average per-listing rates, which over-weights small units.",
    "A property relisted or listed by two agents appears more than once; count properties with DISTINCT IDs and expect days on market to reset on relisting.",
    "Occupancy, units and rent roll are snapshots: read them on the latest rent-roll date in each period, never sum them across months.",
    "Area must use one basis (carpet, built-up or super built-up) throughout, or prices per sq ft are not comparable.",
    "Recent listing cohorts look slow and under-sold simply because they have had less time on the market."
  ]
}
