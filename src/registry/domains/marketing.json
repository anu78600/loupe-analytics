{
  "id": "marketing",
  "name": "Marketing",
  "tagline": "Spend, reach, clicks, leads, conversions and return on ad spend by campaign and channel",
  "description": "Campaign reports from Google Ads, Meta Ads Manager, LinkedIn Campaign Manager, email and affiliate tools, plus lead or contact exports from HubSpot, Salesforce, Zoho CRM and LeadSquared.",
  "icon": "megaphone",
  "entity": "campaign",
  "goals": ["growth", "efficiency"],
  "fields": [
    { "id": "date", "label": "Date", "roles": ["datetime"], "synonyms": ["date", "day", "report date", "reporting date", "reporting starts", "date start", "stat date", "stats date", "campaign date", "activity date", "week", "month", "period"], "exclude": ["created", "create", "lead", "mql", "sql", "converted", "conversion", "won", "close", "closed", "birth", "end", "stop", "signup", "modified", "updated"], "weight": 2.5, "core": true },
    { "id": "campaign", "label": "Campaign", "roles": ["dimension"], "synonyms": ["campaign", "campaign name", "campaign title", "ad campaign", "utm campaign", "campaign label", "initiative", "programme", "program"], "exclude": ["type", "objective", "status", "budget", "group", "set", "start", "end", "delivery"], "weight": 2.5, "core": true },
    { "id": "ad_group", "label": "Ad set / ad group", "roles": ["dimension"], "synonyms": ["ad group", "ad set", "adset", "adgroup", "ad group name", "ad set name", "line item", "campaign group", "campaign group name"], "exclude": ["id", "status", "budget"], "weight": 1 },
    { "id": "ad_name", "label": "Ad / creative", "roles": ["dimension", "text"], "synonyms": ["ad", "ad name", "ad title", "creative", "creative name", "ad creative", "headline"], "exclude": ["group", "set", "spend", "cost", "type", "format", "platform", "network", "id"], "weight": 0.6 },
    { "id": "channel", "label": "Channel", "roles": ["dimension"], "synonyms": ["channel", "marketing channel", "platform", "ad platform", "network", "ad network", "source", "original source", "latest source", "utm source", "traffic source", "source medium", "medium", "utm medium", "media", "publisher", "lead source", "acquisition channel", "partner"], "exclude": ["campaign", "id"], "valueHints": ["google ads", "google", "meta", "facebook", "instagram", "linkedin", "email", "affiliate", "youtube", "tiktok", "twitter", "bing", "microsoft ads", "seo", "organic", "referral", "display", "search", "social", "sms", "whatsapp", "programmatic", "direct", "paid search", "paid social", "newsletter", "influencer", "webinar"], "weight": 2, "core": true },
    { "id": "campaign_type", "label": "Campaign type / objective", "roles": ["dimension"], "synonyms": ["campaign type", "campaign objective", "objective", "goal", "ad type", "ad format", "format", "network type", "advertising channel type", "campaign subtype"], "valueHints": ["search", "display", "video", "shopping", "performance max", "pmax", "awareness", "traffic", "engagement", "leads", "sales", "retargeting", "remarketing", "prospecting", "brand", "app installs"], "weight": 0.8 },
    { "id": "impressions", "label": "Impressions", "roles": ["measure"], "synonyms": ["impressions", "impr", "imps", "impression count", "ad impressions", "served impressions"], "exclude": ["share", "per", "cost", "cpm", "rate", "unique", "lost", "frequency", "top", "absolute"], "weight": 2, "core": true },
    { "id": "clicks", "label": "Clicks", "roles": ["measure"], "synonyms": ["clicks", "link clicks", "clicks all", "click count", "outbound clicks", "website clicks", "clk"], "exclude": ["per", "cost", "cpc", "rate", "ctr", "through", "unique", "share"], "weight": 2, "core": true },
    { "id": "spend", "label": "Spend", "roles": ["currency", "measure"], "synonyms": ["spend", "ad spend", "amount spent", "spent", "cost", "media spend", "media cost", "ad cost", "spend amount", "investment", "media investment", "budget spent"], "exclude": ["per", "cpc", "cpm", "cpa", "cpl", "rate", "revenue", "value", "conversion", "click", "lead", "result", "acquisition", "purchase", "average"], "weight": 2.5, "core": true },
    { "id": "leads", "label": "Leads", "roles": ["measure"], "synonyms": ["leads", "lead count", "form fills", "form submissions", "form submits", "lead form submissions", "signups", "sign ups", "registrations", "enquiries", "inquiries", "on facebook leads", "contacts"], "exclude": ["per", "cost", "cpl", "rate", "status", "stage", "source", "id", "date", "score", "owner", "value", "quality", "name", "email"], "weight": 2, "core": true },
    { "id": "conversions", "label": "Conversions", "roles": ["measure"], "synonyms": ["conversions", "conv", "all conversions", "conversion count", "results", "purchases", "orders", "transactions", "acquisitions", "goal completions", "customers", "deals won"], "exclude": ["rate", "per", "cost", "value", "cpa", "cvr", "revenue", "amount", "date", "lag", "time"], "weight": 2, "core": true },
    { "id": "revenue", "label": "Revenue", "description": "Revenue or conversion value attributed to the campaign or lead.", "roles": ["currency", "measure"], "synonyms": ["revenue", "conversion value", "conv value", "total conversion value", "purchase value", "purchases conversion value", "attributed revenue", "sales", "sales value", "income", "won revenue", "deal value", "deal amount", "amount"], "exclude": ["per", "cost", "spend", "spent", "roas", "rate", "target", "share", "average"], "weight": 2, "core": true },
    { "id": "lead_id", "label": "Lead ID", "roles": ["identifier", "dimension"], "synonyms": ["lead id", "lead number", "lead", "contact id", "prospect id", "record id", "lead email", "contact email", "email", "email address", "lead name", "contact name"], "exclude": ["source", "status", "stage", "owner", "score", "date", "type", "count", "cost"], "weight": 2.5 },
    { "id": "lead_date", "label": "Lead created date", "roles": ["datetime"], "synonyms": ["lead date", "lead created date", "lead created", "created date", "create date", "created on", "created at", "date created", "enquiry date", "inquiry date", "submitted at", "submission date", "form submitted date"], "exclude": ["mql", "sql", "converted", "conversion", "won", "close", "closed", "customer", "last", "modified", "updated", "birth", "start", "end", "report", "reporting", "stop"], "weight": 2 },
    { "id": "lead_stage", "label": "Lead stage", "roles": ["dimension"], "synonyms": ["lead status", "lead stage", "lifecycle stage", "lead lifecycle stage", "stage", "status", "funnel stage", "lead state", "qualification status", "pipeline stage"], "exclude": ["campaign", "ad", "delivery", "payment", "date", "reason"], "valueHints": ["mql", "sql", "customer", "opportunity", "lead", "new", "qualified", "unqualified", "disqualified", "won", "lost", "marketing qualified lead", "sales qualified lead", "subscriber"], "weight": 2 },
    { "id": "is_converted", "label": "Converted flag", "roles": ["boolean"], "synonyms": ["converted", "is converted", "is customer", "became customer", "won", "is won", "purchased", "has purchased", "conversion flag", "closed won"], "weight": 1 },
    { "id": "mql_date", "label": "MQL date", "roles": ["datetime"], "synonyms": ["mql date", "became mql date", "became a marketing qualified lead date", "marketing qualified date", "mql at", "date became mql", "mql timestamp"], "exclude": ["start", "end", "report", "reporting", "created", "create", "close", "customer"], "weight": 1 },
    { "id": "sql_date", "label": "SQL date", "roles": ["datetime"], "synonyms": ["sql date", "became sql date", "became a sales qualified lead date", "sales qualified date", "sql at", "date became sql", "sal date"], "exclude": ["start", "end", "report", "reporting", "created", "create", "close", "customer", "marketing"], "weight": 1 },
    { "id": "won_date", "label": "Customer / won date", "roles": ["datetime"], "synonyms": ["became a customer date", "customer date", "won date", "converted date", "conversion date", "close date", "closed won date", "date converted", "first purchase date"], "exclude": ["mql", "sql", "start", "end", "report", "reporting", "created", "create", "marketing"], "weight": 1 }
  ],
  "valueClasses": {
    "lead_stage": [
      { "id": "lost", "label": "Disqualified / lost", "keywords": ["disqualified", "unqualified", "lost", "closed lost", "junk", "spam", "invalid", "not interested", "not converted", "closed not converted", "bad fit", "dead", "rejected", "duplicate"] },
      { "id": "customer", "label": "Customer / won", "keywords": ["customer", "won", "closed won", "converted", "purchased", "paid", "enrolled", "deal won", "evangelist"] },
      { "id": "mql", "label": "Marketing qualified (MQL)", "keywords": ["mql", "marketing qualified", "marketing qualified lead", "marketing accepted", "mal"] },
      { "id": "sql", "label": "Sales qualified (SQL)", "keywords": ["sql", "sales qualified", "sales qualified lead", "sales accepted", "sal", "qualified", "opportunity", "proposal", "negotiation", "demo"] },
      { "id": "new", "label": "New / working", "keywords": ["new", "lead", "open", "subscriber", "contacted", "attempted to contact", "working", "in progress", "nurture", "nurturing", "recycled", "raw", "unworked"] }
    ]
  },
  "subDomains": [
    { "id": "campaigns", "name": "Campaign performance", "description": "Spend and results per campaign (or ad set) and day from ad platforms or a marketing report.", "signals": ["date", "campaign", "impressions", "clicks", "spend", "conversions", "revenue"], "grain": "campaign day" },
    { "id": "leads", "name": "Lead funnel", "description": "One row per lead or contact with source, created date and lifecycle stage from a CRM or marketing-automation export.", "signals": ["lead_id", "lead_date", "lead_stage", "channel", "mql_date", "sql_date", "won_date", "is_converted"], "grain": "lead" }
  ],
  "kpis": [
    { "id": "spend_total", "name": "Spend", "definition": "Total marketing and advertising spend.", "formula": "Sum of spend", "format": "currency", "direction": "neutral", "tier": "hero", "priority": 1, "group": "Spend", "subDomains": ["campaigns"],
      "variants": [{ "id": "sum", "label": "Sum of spend", "expr": { "agg": "sum", "of": { "field": "spend" } } }] },
    { "id": "leads_total", "name": "Leads", "definition": "Leads generated: form fills, sign-ups and enquiries.", "formula": "Sum of leads (campaign data) or count of distinct leads (lead data)", "format": "integer", "direction": "higher", "tier": "hero", "priority": 2, "group": "Results", "subDomains": ["campaigns", "leads"],
      "variants": [
        { "id": "sum", "label": "Sum of leads", "expr": { "agg": "sum", "of": { "field": "leads" } } },
        { "id": "distinct", "label": "Distinct lead IDs", "expr": { "agg": "countDistinct", "of": "lead_id" }, "caveat": "Lead-level file: each distinct lead ID counts as one lead." }
      ] },
    { "id": "conversions_total", "name": "Conversions", "definition": "Purchases, sign-ups or other goal completions credited to the campaigns.", "formula": "Sum of conversions", "format": "integer", "direction": "higher", "tier": "hero", "priority": 3, "group": "Results", "subDomains": ["campaigns"],
      "variants": [{ "id": "sum", "label": "Sum of conversions", "expr": { "agg": "sum", "of": { "field": "conversions" } } }],
      "pitfalls": ["Each platform counts conversions under its own attribution window and model; totals across platforms over-count."] },
    { "id": "revenue_total", "name": "Revenue", "definition": "Revenue or conversion value attributed to the campaigns.", "formula": "Sum of revenue", "format": "currency", "direction": "higher", "tier": "hero", "priority": 4, "group": "Results", "subDomains": ["campaigns"],
      "variants": [{ "id": "sum", "label": "Sum of revenue", "expr": { "agg": "sum", "of": { "field": "revenue" } } }],
      "pitfalls": ["Platforms each claim credit for the same sale; attributed revenue summed across channels usually exceeds booked revenue."] },
    { "id": "roas", "name": "Return on ad spend", "short": "ROAS", "definition": "Revenue generated per unit of spend.", "formula": "Revenue ÷ spend", "format": "ratio", "direction": "higher", "tier": "hero", "priority": 5, "group": "Efficiency", "subDomains": ["campaigns"],
      "variants": [{ "id": "ratio", "label": "Revenue ÷ spend", "expr": { "op": "div", "args": [{ "ref": "revenue_total" }, { "ref": "spend_total" }] } }],
      "benchmark": { "low": 2, "high": 6, "note": "Indicative for performance campaigns; break-even ROAS is roughly 1 ÷ gross margin, so low-margin businesses need more." } },
    { "id": "cpa", "name": "Cost per acquisition", "short": "CPA", "definition": "Spend per conversion.", "formula": "Spend ÷ conversions", "format": "currency", "direction": "lower", "tier": "hero", "priority": 6, "group": "Efficiency", "subDomains": ["campaigns"],
      "variants": [{ "id": "ratio", "label": "Spend ÷ conversions", "expr": { "op": "div", "args": [{ "ref": "spend_total" }, { "ref": "conversions_total" }] } }] },
    { "id": "cpl", "name": "Cost per lead", "short": "CPL", "definition": "Spend per lead generated.", "formula": "Spend ÷ leads", "format": "currency", "direction": "lower", "tier": "supporting", "priority": 7, "group": "Efficiency", "subDomains": ["campaigns"],
      "variants": [{ "id": "ratio", "label": "Spend ÷ leads", "expr": { "op": "div", "args": [{ "ref": "spend_total" }, { "ref": "leads_total" }] } }],
      "pitfalls": ["Cheap leads are not good leads: read CPL next to lead-to-conversion rate."] },
    { "id": "ctr", "name": "Click-through rate", "short": "CTR", "definition": "Share of impressions that led to a click.", "formula": "Clicks ÷ impressions", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 8, "group": "Engagement", "subDomains": ["campaigns"],
      "variants": [{ "id": "ratio", "label": "Clicks ÷ impressions", "expr": { "op": "div", "args": [{ "ref": "clicks_total" }, { "ref": "impressions_total" }] } }],
      "benchmark": { "low": 0.005, "high": 0.05, "note": "Indicative: display and social usually sit near the bottom of this range and paid search near the top; compare within a channel." },
      "pitfalls": ["Platforms define clicks differently (all clicks vs link clicks); keep one definition per comparison."] },
    { "id": "cpc", "name": "Cost per click", "short": "CPC", "definition": "Average spend per click.", "formula": "Spend ÷ clicks", "format": "currency", "direction": "lower", "tier": "supporting", "priority": 9, "group": "Efficiency", "subDomains": ["campaigns"],
      "variants": [{ "id": "ratio", "label": "Spend ÷ clicks", "expr": { "op": "div", "args": [{ "ref": "spend_total" }, { "ref": "clicks_total" }] } }] },
    { "id": "conversion_rate", "name": "Conversion rate", "short": "CVR", "definition": "Share of clicks that turned into a conversion.", "formula": "Conversions ÷ clicks", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 10, "group": "Engagement", "subDomains": ["campaigns"],
      "variants": [{ "id": "ratio", "label": "Conversions ÷ clicks", "expr": { "op": "div", "args": [{ "ref": "conversions_total" }, { "ref": "clicks_total" }] } }],
      "pitfalls": ["View-through conversions have no click, so platforms that include them can show conversion rates above what clicks alone explain."] },
    { "id": "roi", "name": "Marketing ROI", "short": "ROI", "definition": "Revenue earned over and above spend, per unit of spend.", "formula": "(Revenue − spend) ÷ spend", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 11, "group": "Efficiency", "subDomains": ["campaigns"],
      "variants": [{ "id": "ratio", "label": "(Revenue − spend) ÷ spend", "expr": { "op": "div", "args": [{ "op": "sub", "args": [{ "ref": "revenue_total" }, { "ref": "spend_total" }] }, { "ref": "spend_total" }] } }],
      "pitfalls": ["This ROI is on revenue, not profit; once product and delivery costs are counted the true return is much lower."] },
    { "id": "lead_to_conversion", "name": "Lead-to-conversion rate", "definition": "Conversions per lead generated.", "formula": "Conversions ÷ leads", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 12, "group": "Engagement", "subDomains": ["campaigns"],
      "variants": [{ "id": "ratio", "label": "Conversions ÷ leads", "expr": { "op": "div", "args": [{ "ref": "conversions_total" }, { "ref": "leads_total" }] } }] },
    { "id": "impressions_total", "name": "Impressions", "definition": "Times the ads were shown.", "formula": "Sum of impressions", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 13, "group": "Reach", "subDomains": ["campaigns"],
      "variants": [{ "id": "sum", "label": "Sum of impressions", "expr": { "agg": "sum", "of": { "field": "impressions" } } }] },
    { "id": "clicks_total", "name": "Clicks", "definition": "Clicks on the ads.", "formula": "Sum of clicks", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 14, "group": "Reach", "subDomains": ["campaigns"],
      "variants": [{ "id": "sum", "label": "Sum of clicks", "expr": { "agg": "sum", "of": { "field": "clicks" } } }] },
    { "id": "cpm", "name": "Cost per thousand impressions", "short": "CPM", "definition": "Spend per 1,000 impressions.", "formula": "Spend ÷ impressions × 1,000", "format": "currency", "direction": "lower", "tier": "supporting", "priority": 15, "group": "Efficiency", "subDomains": ["campaigns"],
      "variants": [{ "id": "ratio", "label": "Spend ÷ impressions × 1,000", "expr": { "op": "mul", "args": [{ "op": "div", "args": [{ "ref": "spend_total" }, { "ref": "impressions_total" }] }, { "num": 1000 }] } }] },
    { "id": "active_campaigns", "name": "Active campaigns", "definition": "Campaigns that spent money in the period.", "formula": "Count of distinct campaigns with spend above zero", "format": "integer", "direction": "neutral", "tier": "detail", "priority": 31, "group": "Spend", "subDomains": ["campaigns"],
      "variants": [
        { "id": "with_spend", "label": "Distinct campaigns with spend", "expr": { "agg": "countDistinct", "of": "campaign", "where": { "field": "spend", "cmp": "gt", "value": 0 } } },
        { "id": "all", "label": "Distinct campaigns", "expr": { "agg": "countDistinct", "of": "campaign" }, "caveat": "No spend column, so every campaign listed counts." }
      ] },
    { "id": "mqls", "name": "MQLs", "definition": "Leads that reached marketing-qualified stage or beyond.", "formula": "Distinct leads with an MQL date (or now at MQL, SQL or customer)", "format": "integer", "direction": "higher", "tier": "hero", "priority": 3, "group": "Lead funnel", "subDomains": ["leads"],
      "variants": [
        { "id": "mql_date", "label": "Leads with an MQL date", "expr": { "agg": "countDistinct", "of": "lead_id", "where": { "field": "mql_date", "notNull": true } } },
        { "id": "stage", "label": "Leads now at MQL, SQL or customer", "expr": { "agg": "countDistinct", "of": "lead_id", "where": { "or": [{ "field": "lead_stage", "class": "mql" }, { "field": "lead_stage", "class": "sql" }, { "field": "lead_stage", "class": "customer" }] } }, "caveat": "Based on the current stage, so leads that qualified and were later lost are missed." }
      ] },
    { "id": "sqls", "name": "SQLs", "definition": "Leads that reached sales-qualified stage or beyond.", "formula": "Distinct leads with an SQL date (or now at SQL or customer)", "format": "integer", "direction": "higher", "tier": "hero", "priority": 4, "group": "Lead funnel", "subDomains": ["leads"],
      "variants": [
        { "id": "sql_date", "label": "Leads with an SQL date", "expr": { "agg": "countDistinct", "of": "lead_id", "where": { "field": "sql_date", "notNull": true } } },
        { "id": "stage", "label": "Leads now at SQL or customer", "expr": { "agg": "countDistinct", "of": "lead_id", "where": { "or": [{ "field": "lead_stage", "class": "sql" }, { "field": "lead_stage", "class": "customer" }] } }, "caveat": "Based on the current stage, so leads that qualified and were later lost are missed." }
      ] },
    { "id": "won_customers", "name": "Customers won", "definition": "Leads that became paying customers.", "formula": "Distinct leads at customer stage (or flagged as converted)", "format": "integer", "direction": "higher", "tier": "hero", "priority": 5, "group": "Lead funnel", "subDomains": ["leads"],
      "variants": [
        { "id": "stage", "label": "Leads at customer stage", "expr": { "agg": "countDistinct", "of": "lead_id", "where": { "field": "lead_stage", "class": "customer" } } },
        { "id": "flag", "label": "Leads flagged as converted", "expr": { "agg": "countDistinct", "of": "lead_id", "where": { "field": "is_converted", "isTrue": true } }, "caveat": "No lifecycle stage, so customers are leads flagged as converted." },
        { "id": "won_date", "label": "Leads with a customer date", "expr": { "agg": "countDistinct", "of": "lead_id", "where": { "field": "won_date", "notNull": true } }, "caveat": "No lifecycle stage or converted flag, so customers are leads with a customer date." }
      ] },
    { "id": "mql_to_sql_rate", "name": "MQL-to-SQL rate", "definition": "Share of marketing-qualified leads that sales accepted as qualified.", "formula": "SQLs ÷ MQLs", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 7, "group": "Lead funnel", "subDomains": ["leads"],
      "variants": [{ "id": "ratio", "label": "SQLs ÷ MQLs", "expr": { "op": "div", "args": [{ "ref": "sqls" }, { "ref": "mqls" }] } }] },
    { "id": "sql_to_won_rate", "name": "SQL-to-customer rate", "definition": "Share of sales-qualified leads that became customers.", "formula": "Customers won ÷ SQLs", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 8, "group": "Lead funnel", "subDomains": ["leads"],
      "variants": [{ "id": "ratio", "label": "Customers won ÷ SQLs", "expr": { "op": "div", "args": [{ "ref": "won_customers" }, { "ref": "sqls" }] } }] },
    { "id": "lead_to_customer_rate", "name": "Lead-to-customer rate", "definition": "Share of all leads that became customers.", "formula": "Customers won ÷ leads", "format": "percent", "direction": "higher", "tier": "hero", "priority": 6, "group": "Lead funnel", "subDomains": ["leads"],
      "variants": [{ "id": "ratio", "label": "Customers won ÷ leads", "expr": { "op": "div", "args": [{ "ref": "won_customers" }, { "ref": "leads_total" }] } }],
      "pitfalls": ["Rates are by lead-creation cohort: recent leads have not had time to progress, so the latest months always look worse."] }
  ],
  "charts": [
    { "id": "spend_trend", "title": "Spend over time", "kind": "area", "section": "trend", "x": { "time": "date" }, "measures": ["spend_total"], "reason": "One measure over a continuous time axis reads best as a line; the soft fill emphasises volume without hiding the shape.", "alternatives": ["line", "bar"], "size": { "w": 8, "h": 4 }, "priority": 1, "subDomains": ["campaigns"] },
    { "id": "roas_trend", "title": "ROAS over time", "kind": "line", "section": "trend", "x": { "time": "date" }, "measures": ["roas"], "reason": "ROAS is a ratio, so each period's value is recomputed from that period's revenue and spend and drawn as a line, never summed.", "alternatives": ["bar"], "size": { "w": 4, "h": 4 }, "priority": 2, "subDomains": ["campaigns"] },
    { "id": "spend_by_channel", "title": "Spend by channel", "kind": "donut", "section": "breakdown", "x": { "field": "channel" }, "measures": ["spend_total"], "topN": 6, "others": true, "reason": "Part-to-whole with a handful of channels: a donut shows the budget split at a glance.", "alternatives": ["hbar", "treemap"], "size": { "w": 4, "h": 4 }, "priority": 1, "subDomains": ["campaigns"] },
    { "id": "spend_by_campaign", "title": "Spend by campaign", "kind": "hbar", "section": "breakdown", "x": { "field": "campaign" }, "measures": ["spend_total"], "topN": 12, "others": true, "reason": "Where the budget goes: campaigns as sorted horizontal bars so long names stay readable, top 12 plus Others.", "alternatives": ["treemap", "bar"], "size": { "w": 8, "h": 5 }, "priority": 2, "subDomains": ["campaigns"] },
    { "id": "roas_by_channel", "title": "ROAS by channel", "kind": "bar", "section": "drivers", "x": { "field": "channel" }, "measures": ["roas"], "others": false, "minGroupRows": 20, "reason": "A ratio compared across a few channels: bars of the recomputed ROAS per channel; channels with under 20 rows are hidden as too thin.", "alternatives": ["hbar"], "size": { "w": 4, "h": 4 }, "priority": 1, "subDomains": ["campaigns"] },
    { "id": "cpa_by_campaign", "title": "Cost per acquisition by campaign", "kind": "hbar", "section": "drivers", "x": { "field": "campaign" }, "measures": ["cpa"], "topN": 12, "others": false, "minGroupRows": 20, "reason": "Which campaigns buy conversions most expensively: CPA recomputed per campaign and sorted; campaigns with under 20 rows are hidden.", "alternatives": ["bar"], "size": { "w": 4, "h": 5 }, "priority": 2, "subDomains": ["campaigns"] },
