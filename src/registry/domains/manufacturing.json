{
  "id": "manufacturing",
  "name": "Manufacturing",
  "tagline": "Output, yield, rejection, downtime, OEE and cost per unit across plants, lines, machines and shifts",
  "description": "MES and shift production reports, OEE logs, machine downtime registers and quality inspection records from discrete and process plants, including daily production reports with target, actual, OK and rejection quantities.",
  "icon": "factory",
  "entity": "production run",
  "goals": ["throughput", "quality", "cost"],
  "fields": [
    { "id": "production_date", "label": "Production date", "roles": ["datetime"], "synonyms": ["production date", "prod date", "shift date", "run date", "manufacturing date", "mfg date", "batch date", "posting date", "report date", "work date", "event date", "inspection date", "start time", "start date", "timestamp", "datetime", "date", "month", "period", "report month", "mis month"], "exclude": ["expiry", "exp", "due", "delivery", "ship", "order", "birth", "joining", "end", "finish", "stop", "invoice", "payment", "dispatch"], "weight": 3, "core": true },
    { "id": "shift", "label": "Shift", "roles": ["dimension"], "synonyms": ["shift", "shift name", "shift code", "shift no", "shift type", "work shift"], "exclude": ["date", "start", "end", "hours", "duration", "minutes", "time", "supervisor"], "valueHints": ["morning", "afternoon", "evening", "night", "general", "first shift", "second shift", "third shift", "shift a", "shift b", "shift c", "day shift", "night shift"], "weight": 1.5, "core": true },
    { "id": "plant", "label": "Plant / site", "roles": ["dimension", "geo"], "synonyms": ["plant", "factory", "site", "works", "mill", "facility", "manufacturing unit", "production unit", "location"], "exclude": ["type", "machine", "line", "product", "operator", "customer", "part"], "weight": 1 },
    { "id": "line", "label": "Line / work centre", "roles": ["dimension"], "synonyms": ["line", "production line", "assembly line", "work center", "work centre", "workcenter", "cell", "production cell"], "exclude": ["item", "total", "amount", "order", "invoice", "sales", "product", "batch", "lot"], "weight": 2, "core": true },
    { "id": "machine", "label": "Machine / equipment", "roles": ["dimension", "identifier"], "synonyms": ["machine", "machine no", "equipment", "asset", "press", "workstation", "station", "resource", "tool", "mould", "mold"], "exclude": ["type", "status", "hours", "time", "speed", "rate", "capacity", "operator", "cost"], "weight": 2, "core": true },
    { "id": "product", "label": "Product / part", "roles": ["dimension"], "synonyms": ["product", "part", "part number", "item", "sku", "material", "model", "variant", "article", "fg code", "component"], "exclude": ["family", "group", "category", "type", "cost", "price", "quantity", "line"], "weight": 1.5 },
    { "id": "product_family", "label": "Product family", "roles": ["dimension"], "synonyms": ["product family", "family", "product group", "product category", "category", "product line", "model family"], "weight": 0.8 },
    { "id": "process_step", "label": "Process / operation", "roles": ["dimension"], "synonyms": ["process", "operation", "process step", "operation name", "process stage", "stage", "routing step", "op no", "operation number"], "exclude": ["time", "cost", "status", "date", "hours"], "weight": 0.8 },
    { "id": "work_order", "label": "Work order / batch", "roles": ["identifier", "dimension"], "synonyms": ["work order", "work order number", "wo number", "wo no", "production order", "production order number", "job number", "job no", "job id", "job card", "batch", "batch number", "batch no", "batch id", "lot", "lot number", "lot no", "mo number", "run id", "run number"], "exclude": ["date", "size", "quantity", "status", "type", "cost"], "weight": 1.5 },
    { "id": "operator", "label": "Operator", "roles": ["dimension"], "synonyms": ["operator", "operator name", "operator id", "worker", "employee", "technician", "machinist", "operated by"], "exclude": ["hours", "count", "cost"], "weight": 0.6 },
    { "id": "planned_time", "label": "Planned production time", "roles": ["measure"], "synonyms": ["planned production time", "planned time", "planned minutes", "planned hours", "planned run time", "planned production minutes", "scheduled time", "scheduled minutes", "available time", "available minutes", "available hours", "shift duration", "shift time", "shift minutes", "loading time", "ppt", "net available time"], "exclude": ["down", "downtime", "idle", "lost", "actual", "break", "cycle"], "weight": 2, "core": true },
    { "id": "run_time", "label": "Run / operating time", "roles": ["measure"], "synonyms": ["run time", "runtime", "operating time", "running time", "run minutes", "run hours", "running hours", "operating hours", "operating minutes", "machine hours", "machine run time", "production time", "actual run time", "actual production time", "productive time", "uptime"], "exclude": ["planned", "scheduled", "available", "down", "downtime", "idle", "cycle", "ideal", "standard", "target"], "weight": 2, "core": true },
    { "id": "downtime", "label": "Downtime", "roles": ["measure"], "synonyms": ["downtime", "down time", "downtime minutes", "downtime mins", "downtime min", "downtime hours", "downtime duration", "stop time", "stoppage time", "stoppage minutes", "stoppage", "breakdown time", "breakdown minutes", "breakdown hours", "idle time", "lost time", "loss time", "stop duration", "duration minutes", "duration"], "exclude": ["reason", "code", "category", "cause", "type", "count", "shift", "cycle", "number"], "weight": 2, "core": true, "description": "Stoppage time in the same unit as run and planned time (minutes in most shift logs)." },
    { "id": "downtime_reason", "label": "Downtime reason", "roles": ["dimension", "text"], "synonyms": ["downtime reason", "downtime cause", "downtime category", "downtime code", "downtime type", "stop reason", "stoppage reason", "breakdown reason", "loss reason", "loss category", "reason", "reason code", "cause", "root cause", "fault", "fault code", "failure mode", "event type"], "exclude": ["reject", "rejection", "defect", "scrap", "quality"], "valueHints": ["breakdown", "changeover", "setup", "set up", "maintenance", "material shortage", "no material", "power failure", "power cut", "quality issue", "tool change", "cleaning", "lunch", "no operator", "waiting", "planned maintenance", "mechanical", "electrical"], "weight": 1.5 },
    { "id": "total_count", "label": "Total units produced", "roles": ["measure"], "synonyms": ["total count", "total units", "total quantity", "total qty", "total produced", "total output", "total pieces", "units produced", "quantity produced", "qty produced", "produced quantity", "produced qty", "production quantity", "production qty", "output", "output quantity", "output qty", "actual output", "actual production", "actual quantity", "actual qty", "production", "produced", "pieces produced", "quantity", "qty", "units", "count", "pieces"], "exclude": ["good", "ok", "reject", "rejected", "rejection", "scrap", "defect", "defective", "rework", "planned", "plan", "target", "ideal", "capacity", "order", "ordered", "inspected", "sample", "nok", "ng", "bad", "failed", "waste", "per", "rate", "hour", "standard", "energy", "power", "cost", "time", "minutes", "operator", "worker", "employee", "manpower", "lot"], "weight": 2.5, "core": true },
    { "id": "good_count", "label": "Good units", "roles": ["measure"], "synonyms": ["good count", "good units", "good quantity", "good qty", "good parts", "good pieces", "good output", "ok quantity", "ok qty", "ok pieces", "ok parts", "accepted quantity", "accepted qty", "accepted units", "passed quantity", "pass quantity", "first pass quantity", "saleable quantity", "net output", "good"], "exclude": ["not", "nok", "rate", "percent", "ratio"], "weight": 2, "core": true },
    { "id": "reject_count", "label": "Rejected units", "roles": ["measure"], "synonyms": ["rejects", "reject count", "reject qty", "reject quantity", "rejected quantity", "rejected qty", "rejected units", "rejection", "rejection qty", "rejection quantity", "defects", "defect count", "defective units", "defective quantity", "defective qty", "defective", "nok quantity", "nok qty", "ng quantity", "ng qty", "ng count", "bad count", "bad parts", "bad units", "failed units", "nonconforming units", "quality rejects"], "exclude": ["rate", "percent", "ratio", "reason", "type", "code", "category", "description", "rework", "scrap"], "weight": 2, "core": true },
    { "id": "scrap_count", "label": "Scrap quantity", "roles": ["measure"], "synonyms": ["scrap", "scrap qty", "scrap quantity", "scrap units", "scrap pieces", "scrap count", "scrapped", "scrapped units", "scrapped quantity", "waste", "waste quantity", "waste qty", "wastage", "wastage qty"], "exclude": ["rate", "percent", "ratio", "reason", "value", "cost", "amount", "weight", "kg"], "weight": 1.5 },
    { "id": "rework_count", "label": "Rework quantity", "roles": ["measure"], "synonyms": ["rework", "rework qty", "rework quantity", "rework units", "reworked units", "reworked quantity", "rework count", "repaired units"], "exclude": ["rate", "percent", "cost", "time", "hours", "reason"], "weight": 1 },
    { "id": "ideal_cycle_time", "label": "Ideal cycle time", "roles": ["measure"], "synonyms": ["ideal cycle time", "ideal ct", "standard cycle time", "std cycle time", "design cycle time", "rated cycle time", "target cycle time", "theoretical cycle time", "ideal cycle time sec", "ideal cycle time min", "standard time per unit", "standard time", "cycle time standard", "cycle time"], "exclude": ["actual", "average", "observed", "measured"], "weight": 1.5, "description": "Fastest possible time per unit, in the same time unit as run time." },
    { "id": "planned_qty", "label": "Planned / target quantity", "roles": ["measure"], "synonyms": ["planned quantity", "planned qty", "plan quantity", "plan qty", "planned output", "planned production", "target quantity", "target qty", "target output", "target production", "target", "plan", "scheduled quantity", "schedule qty", "standard output", "expected output"], "exclude": ["actual", "time", "minutes", "hours", "date", "cycle", "rate"], "weight": 1.2 },
    { "id": "capacity", "label": "Capacity (units)", "roles": ["measure"], "synonyms": ["capacity", "rated capacity", "installed capacity", "max capacity", "design capacity", "available capacity", "machine capacity", "line capacity", "capacity units", "capacity qty", "max output", "maximum output"], "exclude": ["utilisation", "utilization", "percent", "rate", "used"], "weight": 1 },
    { "id": "production_cost", "label": "Production cost", "roles": ["currency", "measure"], "synonyms": ["production cost", "manufacturing cost", "cost of production", "conversion cost", "batch cost", "run cost", "cogm", "total cost", "cost", "cost amount", "cost value"], "exclude": ["unit", "per", "standard", "price", "material", "labour", "labor", "energy", "power"], "weight": 1.5 },
    { "id": "energy_kwh", "label": "Energy (kWh)", "roles": ["measure"], "synonyms": ["energy", "energy kwh", "energy consumption", "energy consumed", "kwh", "power consumption", "power kwh", "electricity", "electricity consumption", "units consumed"], "exclude": ["cost", "amount", "per", "rate"], "weight": 0.8 },
    { "id": "labor_hours", "label": "Labour hours", "roles": ["measure"], "synonyms": ["labour hours", "labor hours", "man hours", "manhours", "man hrs", "worked hours", "direct labour hours", "direct labor hours", "operator hours", "labour time", "labor time"], "exclude": ["cost", "rate", "planned"], "weight": 0.8 },
    { "id": "defect_type", "label": "Defect type", "roles": ["dimension", "text"], "synonyms": ["defect type", "defect", "defect category", "defect code", "defect reason", "defect description", "rejection reason", "reject reason", "rejection category", "failure type", "nonconformance", "ncr type", "quality issue", "scrap reason"], "exclude": ["count", "qty", "quantity", "units", "rate", "percent"], "weight": 1.2 },
    { "id": "inspected_qty", "label": "Inspected quantity", "roles": ["measure"], "synonyms": ["inspected quantity", "inspected qty", "inspected units", "quantity inspected", "qty inspected", "units inspected", "inspection quantity", "inspection qty", "sample size", "sample qty", "checked quantity", "checked qty", "lot size"], "exclude": ["rejected", "defect", "date"], "weight": 1 },
    { "id": "inspection_result", "label": "Inspection result", "roles": ["dimension"], "synonyms": ["inspection result", "result", "qc result", "qc status", "quality status", "quality result", "test result", "inspection status", "pass fail", "pass or fail", "outcome", "verdict", "disposition", "status"], "exclude": ["machine", "order", "payment", "shift", "delivery"], "valueHints": ["pass", "fail", "passed", "failed", "accepted", "rejected", "nok", "hold", "conforming", "nonconforming"], "weight": 1.5 }
  ],
  "valueClasses": {
    "downtime_reason": [
      { "id": "breakdown", "label": "Breakdown / failure", "keywords": ["breakdown", "break down", "failure", "fault", "malfunction", "mechanical", "electrical", "hydraulic", "pneumatic", "jam", "repair", "machine failure", "equipment failure"] },
      { "id": "planned", "label": "Planned stop", "keywords": ["planned", "preventive", "scheduled maintenance", "pm", "lunch", "tea break", "rest break", "break time", "shift break", "meal", "meeting", "training", "no order", "no plan", "no schedule", "holiday"] }
    ],
    "inspection_result": [
      { "id": "fail", "label": "Fail / rejected", "keywords": ["fail", "failed", "reject", "nok", "not ok", "ng", "no good", "nonconforming", "non conforming", "defective", "scrap"] },
      { "id": "pass", "label": "Pass / accepted", "keywords": ["pass", "passed", "accept", "ok", "conforming", "good", "approved", "released", "cleared"] }
    ]
  },
  "subDomains": [
    { "id": "production", "name": "Production, shift & downtime reports", "description": "One row per machine, line or shift per day (or per stoppage) with produced, good and rejected quantities, downtime and its reason.", "signals": ["production_date", "shift", "line", "machine", "total_count", "good_count", "reject_count", "downtime", "downtime_reason"], "grain": "machine-shift, production run or stoppage" },
    { "id": "oee", "name": "OEE log", "description": "One row per machine or line per shift with planned time, run time, ideal cycle time and counts.", "signals": ["production_date", "machine", "shift", "planned_time", "run_time", "ideal_cycle_time", "total_count", "good_count"], "grain": "machine-shift" },
    { "id": "quality", "name": "Quality inspections", "description": "One row per inspection, lot or batch with inspected and rejected quantities and defect types.", "signals": ["production_date", "product", "work_order", "inspected_qty", "reject_count", "defect_type", "inspection_result"], "grain": "inspection or batch" },
    { "id": "plant_mis", "name": "Plant production MIS", "description": "One row per plant (or product) per day or month with output, capacity, scrap, energy and cost, typical of process industries.", "signals": ["production_date", "plant", "product", "total_count", "capacity", "scrap_count", "energy_kwh", "production_cost"], "grain": "plant-day" }
  ],
  "kpis": [
    { "id": "units_produced", "name": "Units produced", "short": "Output", "definition": "Total units made in the period, good and bad.", "formula": "Sum of total count", "format": "integer", "direction": "higher", "tier": "hero", "priority": 1, "group": "Output",
      "variants": [
        { "id": "total", "label": "Sum of total count", "expr": { "agg": "sum", "of": { "field": "total_count" } } },
        { "id": "good_plus_rejects", "label": "Good + rejected units", "expr": { "op": "add", "args": [{ "agg": "sum", "of": { "field": "good_count" } }, { "agg": "sum", "of": { "field": "reject_count" } }] }, "caveat": "No total count, so output = good + rejected units." }
      ] },
    { "id": "oee", "name": "Overall Equipment Effectiveness", "short": "OEE", "definition": "Share of planned production time that was truly productive: running, at full speed, making good units.", "formula": "Availability × Performance × Quality, each a ratio of sums over the period (never an average of row-level OEE)", "format": "percent", "direction": "higher", "tier": "hero", "priority": 2, "group": "OEE",
      "variants": [
        { "id": "factors", "label": "Availability × performance × quality", "expr": { "op": "mul", "args": [{ "op": "mul", "args": [{ "ref": "availability" }, { "ref": "performance" }] }, { "ref": "quality_rate" }] } },
        { "id": "direct", "label": "Good units × ideal cycle time ÷ planned time", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "mul", "args": [{ "field": "ideal_cycle_time" }, { "field": "good_count" }] } }, { "agg": "sum", "of": { "field": "planned_time" }, "where": { "and": [{ "field": "ideal_cycle_time", "notNull": true }, { "field": "good_count", "notNull": true }] } }] }, "caveat": "No run time or total count, so OEE is computed directly as good units × ideal cycle time ÷ planned production time." }
      ],
      "benchmark": { "low": 0.6, "high": 0.85, "note": "Indicative: about 85% is widely quoted as world-class OEE and about 60% as typical for discrete manufacturing." },
      "pitfalls": ["Each factor is a ratio of totals for the period, so OEE for a month is not the average of daily or machine OEE values.", "Plants disagree on whether breaks and planned maintenance count as downtime; compare OEE only under one definition."] },
    { "id": "first_pass_yield", "name": "First pass yield", "short": "FPY", "definition": "Share of units made right the first time, without rejection or rework; this is also OEE's quality factor.", "formula": "Σ good units ÷ Σ total units, on rows that have both", "format": "percent", "direction": "higher", "tier": "hero", "priority": 3, "group": "Quality",
      "variants": [
        { "id": "good_total", "label": "Good ÷ total units", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "good_count" }, "where": { "field": "total_count", "notNull": true } }, { "agg": "sum", "of": { "field": "total_count" }, "where": { "field": "good_count", "notNull": true } }] } },
        { "id": "net_of_rework", "label": "(Total − rejects − rework) ÷ total", "expr": { "op": "div", "args": [{ "op": "sub", "args": [{ "op": "sub", "args": [{ "agg": "sum", "of": { "field": "total_count" } }, { "agg": "sum", "of": { "field": "reject_count" } }] }, { "agg": "sum", "of": { "field": "rework_count" } }] }, { "agg": "sum", "of": { "field": "total_count" } }] }, "caveat": "No good-count column, so first-pass good = total − rejected − reworked units." },
        { "id": "net_of_rejects", "label": "(Total − rejects) ÷ total", "expr": { "op": "div", "args": [{ "op": "sub", "args": [{ "agg": "sum", "of": { "field": "total_count" } }, { "agg": "sum", "of": { "field": "reject_count" } }] }, { "agg": "sum", "of": { "field": "total_count" } }] }, "caveat": "No good-count or rework column, so reworked units count as first-pass good." },
        { "id": "inspected", "label": "(Inspected − rejects) ÷ inspected", "expr": { "op": "div", "args": [{ "op": "sub", "args": [{ "agg": "sum", "of": { "field": "inspected_qty" } }, { "agg": "sum", "of": { "field": "reject_count" } }] }, { "agg": "sum", "of": { "field": "inspected_qty" } }] }, "caveat": "No production counts, so yield is based on inspected units only." }
      ],
      "benchmark": { "high": 0.999, "note": "Indicative: 99.9% is often quoted as the world-class quality factor in OEE." },
      "pitfalls": ["If the good count includes units that passed after rework, first pass yield is overstated."] },
    { "id": "defect_rate", "name": "Defect / rejection rate", "short": "Rejection %", "definition": "Share of units rejected as defective.", "formula": "Σ rejected units ÷ Σ inspected units (or all units produced when every unit is inspected)", "format": "percent", "direction": "lower", "tier": "hero", "priority": 4, "group": "Quality",
      "variants": [
        { "id": "inspected", "label": "Rejected ÷ inspected units", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "reject_count" } }, { "agg": "sum", "of": { "field": "inspected_qty" } }] } },
        { "id": "produced", "label": "Rejected ÷ units produced", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "reject_count" } }, { "ref": "units_produced" }] }, "caveat": "No inspected-quantity column, so rejects are divided by all units produced (assumes every unit is inspected)." },
        { "id": "total_minus_good", "label": "(Total − good) ÷ total", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "sub", "args": [{ "field": "total_count" }, { "field": "good_count" }] } }, { "agg": "sum", "of": { "field": "total_count" }, "where": { "field": "good_count", "notNull": true } }] }, "caveat": "No reject column, so rejects = total − good units." }
      ],
      "pitfalls": ["A column of defects (not defective units) can count several defects on one unit, which overstates the rate.", "Product mix matters: a shift that ran harder parts rejects more without performing worse."] },
    { "id": "downtime_total", "name": "Downtime", "definition": "Total stoppage time in the period, in the unit of the downtime column (usually minutes).", "formula": "Sum of downtime", "format": "number", "direction": "lower", "tier": "hero", "priority": 5, "group": "Availability",
      "variants": [
        { "id": "sum", "label": "Sum of downtime", "expr": { "agg": "sum", "of": { "field": "downtime" } } },
        { "id": "planned_minus_run", "label": "Planned time − run time", "expr": { "agg": "sum", "of": { "op": "sub", "args": [{ "field": "planned_time" }, { "field": "run_time" }] } }, "caveat": "No downtime column, so downtime = planned time − run time." }
      ] },
    { "id": "cost_per_good_unit", "name": "Cost per good unit", "short": "Cost / unit", "definition": "Production cost spread over the good units made.", "formula": "Σ production cost ÷ Σ good units", "format": "currency", "direction": "lower", "tier": "hero", "priority": 6, "group": "Cost",
      "variants": [{ "id": "ratio", "label": "Production cost ÷ good units", "expr": { "op": "div", "args": [{ "ref": "production_cost_total" }, { "ref": "good_units" }] } }],
      "pitfalls": ["Scrap and rework raise cost per good unit even when spending is flat, because the cost of bad units is carried by the good ones."] },
    { "id": "good_units", "name": "Good units", "definition": "Units that passed quality in the period.", "formula": "Sum of good count", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 7, "group": "Output",
      "variants": [
        { "id": "good", "label": "Sum of good count", "expr": { "agg": "sum", "of": { "field": "good_count" } } },
        { "id": "total_minus_rejects", "label": "Total − rejected units", "expr": { "op": "sub", "args": [{ "agg": "sum", "of": { "field": "total_count" } }, { "agg": "sum", "of": { "field": "reject_count" } }] }, "caveat": "No good-count column, so good units = total − rejected units." }
      ] },
    { "id": "availability", "name": "Availability", "definition": "Share of planned production time the equipment was actually running.", "formula": "Σ run time ÷ Σ planned production time, on rows that have both", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 8, "group": "OEE",
      "variants": [
        { "id": "run_planned", "label": "Run time ÷ planned time", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "run_time" }, "where": { "field": "planned_time", "notNull": true } }, { "agg": "sum", "of": { "field": "planned_time" }, "where": { "field": "run_time", "notNull": true } }] } },
        { "id": "planned_minus_downtime", "label": "(Planned − downtime) ÷ planned", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "sub", "args": [{ "field": "planned_time" }, { "field": "downtime" }] } }, { "agg": "sum", "of": { "field": "planned_time" }, "where": { "field": "downtime", "notNull": true } }] }, "caveat": "No run-time column, so run time = planned time − downtime." }
      ],
      "benchmark": { "high": 0.9, "note": "Indicative: about 90% is often quoted as world-class availability." } },
    { "id": "performance", "name": "Performance", "definition": "How close the equipment ran to its ideal speed while it was running.", "formula": "Σ (ideal cycle time × total count) ÷ Σ run time, on rows with a cycle time and count", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 9, "group": "OEE",
      "variants": [
        { "id": "cycle_time", "label": "Ideal cycle time × count ÷ run time", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "mul", "args": [{ "field": "ideal_cycle_time" }, { "field": "total_count" }] } }, { "agg": "sum", "of": { "field": "run_time" }, "where": { "and": [{ "field": "ideal_cycle_time", "notNull": true }, { "field": "total_count", "notNull": true }] } }] } },
        { "id": "planned_minus_downtime", "label": "Ideal cycle time × count ÷ (planned − downtime)", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "mul", "args": [{ "field": "ideal_cycle_time" }, { "field": "total_count" }] } }, { "agg": "sum", "of": { "op": "sub", "args": [{ "field": "planned_time" }, { "field": "downtime" }] }, "where": { "and": [{ "field": "ideal_cycle_time", "notNull": true }, { "field": "total_count", "notNull": true }] } }] }, "caveat": "No run-time column, so run time = planned time − downtime." }
      ],
      "benchmark": { "high": 0.95, "note": "Indicative: about 95% is often quoted as world-class performance." },
      "pitfalls": ["Cycle time and run time must be in the same unit: seconds against minutes inflates performance 60-fold.", "Values above 100% mean the ideal cycle time is set too slow."] },
    { "id": "scrap_rate", "name": "Scrap rate", "definition": "Share of units produced that were scrapped.", "formula": "Σ scrap ÷ units produced", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 10, "group": "Quality",
      "variants": [{ "id": "ratio", "label": "Scrap ÷ units produced", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "scrap_count" } }, { "ref": "units_produced" }] } }],
      "pitfalls": ["Scrap recorded by weight cannot be divided by units counted; both must be in the same unit."] },
    { "id": "unplanned_downtime", "name": "Unplanned downtime", "definition": "Stoppage time not caused by planned stops such as breaks, meetings or preventive maintenance.", "formula": "Sum of downtime where the reason is not a planned stop", "format": "number", "direction": "lower", "tier": "supporting", "priority": 11, "group": "Availability",
      "variants": [{ "id": "reason", "label": "Downtime excluding planned reasons", "expr": { "agg": "sum", "of": { "field": "downtime" }, "where": { "field": "downtime_reason", "notClass": "planned" } } }],
      "pitfalls": ["Stops with no reason recorded are counted as unplanned."] },
    { "id": "capacity_utilisation", "name": "Capacity utilisation", "short": "Utilisation", "definition": "Share of available capacity that was used for output.", "formula": "Σ units produced ÷ Σ capacity, on rows that have both", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 12, "group": "Output",
      "variants": [{ "id": "ratio", "label": "Units produced ÷ capacity", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "total_count" }, "where": { "field": "capacity", "notNull": true } }, { "agg": "sum", "of": { "field": "capacity" }, "where": { "field": "total_count", "notNull": true } }] } }] },
    { "id": "plan_attainment", "name": "Plan attainment", "definition": "Output achieved against the planned or target quantity.", "formula": "Σ units produced ÷ Σ planned quantity, on rows that have both", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 13, "group": "Output",
      "variants": [{ "id": "ratio", "label": "Units produced ÷ planned quantity", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "total_count" }, "where": { "field": "planned_qty", "notNull": true } }, { "agg": "sum", "of": { "field": "planned_qty" }, "where": { "field": "total_count", "notNull": true } }] } }],
      "pitfalls": ["Over-producing one product can hide shortfalls on another; check attainment by product."] },
    { "id": "inspection_pass_rate", "name": "Inspection pass rate", "short": "Pass rate", "definition": "Share of inspections, lots or batches that passed quality inspection.", "formula": "Inspections with a pass result ÷ inspections with a result", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 14, "group": "Quality",
      "variants": [{ "id": "rows", "label": "Passed ÷ inspected", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "inspection_result", "class": "pass" } }, { "agg": "count", "where": { "field": "inspection_result", "notNull": true } }] } }],
      "pitfalls": ["Results on hold or under review count against the pass rate until they are released."] },
    { "id": "rework_rate", "name": "Rework rate", "definition": "Share of units produced that needed rework.", "formula": "Σ rework ÷ units produced", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 15, "group": "Quality",
      "variants": [{ "id": "ratio", "label": "Rework ÷ units produced", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "rework_count" } }, { "ref": "units_produced" }] } }] },
    { "id": "production_cost_total", "name": "Production cost", "definition": "Total cost of production recorded in the period.", "formula": "Sum of production cost", "format": "currency", "direction": "lower", "tier": "supporting", "priority": 16, "group": "Cost",
      "variants": [{ "id": "sum", "label": "Sum of production cost", "expr": { "agg": "sum", "of": { "field": "production_cost" } } }] },
    { "id": "mttr", "name": "Mean time to repair", "short": "MTTR", "definition": "Average stoppage time per breakdown, in the unit of the downtime column.", "formula": "Σ breakdown downtime ÷ number of breakdowns", "format": "number", "direction": "lower", "tier": "supporting", "priority": 17, "group": "Maintenance",
      "variants": [{ "id": "breakdowns", "label": "Breakdown downtime ÷ breakdowns", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "downtime" }, "where": { "field": "downtime_reason", "class": "breakdown" } }, { "agg": "count", "where": { "field": "downtime_reason", "class": "breakdown" } }] } }],
      "pitfalls": ["Counts each breakdown row as one failure; in a shift summary that lists one main reason per shift, several failures may share a row."] },
    { "id": "quality_rate", "name": "Quality (OEE factor)", "definition": "OEE's quality factor: good units as a share of total units.", "formula": "Same as first pass yield", "format": "percent", "direction": "higher", "tier": "detail", "priority": 40, "group": "OEE", "hidden": true,
      "variants": [{ "id": "fpy", "label": "First pass yield", "expr": { "ref": "first_pass_yield" } }] },
    { "id": "rejected_units", "name": "Rejected units", "definition": "Units rejected as defective in the period.", "formula": "Sum of rejected units", "format": "integer", "direction": "lower", "tier": "detail", "priority": 41, "group": "Quality",
      "variants": [
        { "id": "sum", "label": "Sum of rejected units", "expr": { "agg": "sum", "of": { "field": "reject_count" } } },
        { "id": "total_minus_good", "label": "Total − good units", "expr": { "agg": "sum", "of": { "op": "sub", "args": [{ "field": "total_count" }, { "field": "good_count" }] } }, "caveat": "No reject column, so rejected units = total − good units." }
      ] },
    { "id": "mtbf", "name": "Mean time between failures", "short": "MTBF", "definition": "Average running time between breakdowns, in the unit of the run-time column.", "formula": "Σ run time ÷ number of breakdowns", "format": "number", "direction": "higher", "tier": "detail", "priority": 42, "group": "Maintenance",
      "variants": [
        { "id": "run_time", "label": "Run time ÷ breakdowns", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "run_time" } }, { "agg": "count", "where": { "field": "downtime_reason", "class": "breakdown" } }] } },
        { "id": "planned_minus_downtime", "label": "(Planned − downtime) ÷ breakdowns", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "sub", "args": [{ "field": "planned_time" }, { "field": "downtime" }] } }, { "agg": "count", "where": { "field": "downtime_reason", "class": "breakdown" } }] }, "caveat": "No run-time column, so run time = planned time − downtime." }
      ],
      "pitfalls": ["Needs run time and breakdown reasons in the same file; a downtime-only log cannot give MTBF."] },
    { "id": "stoppages", "name": "Stoppages", "definition": "Number of rows that recorded any downtime.", "formula": "Count of rows with downtime > 0", "format": "integer", "direction": "lower", "tier": "detail", "priority": 43, "group": "Availability",
      "variants": [{ "id": "rows", "label": "Rows with downtime", "expr": { "agg": "count", "where": { "field": "downtime", "cmp": "gt", "value": 0 } } }] },
    { "id": "labour_productivity", "name": "Labour productivity", "definition": "Good units made per labour hour.", "formula": "Good units ÷ Σ labour hours", "format": "decimal", "direction": "higher", "tier": "detail", "priority": 44, "group": "Cost",
      "variants": [{ "id": "ratio", "label": "Good units ÷ labour hours", "expr": { "op": "div", "args": [{ "ref": "good_units" }, { "agg": "sum", "of": { "field": "labor_hours" } }] } }] },
    { "id": "energy_per_unit", "name": "Energy per good unit", "short": "kWh / unit", "definition": "Energy consumed per good unit made.", "formula": "Σ energy ÷ good units", "format": "decimal", "direction": "lower", "tier": "detail", "priority": 45, "group": "Cost",
      "variants": [{ "id": "ratio", "label": "Energy ÷ good units", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "energy_kwh" } }, { "ref": "good_units" }] } }] }
  ],
