    { "id": "good_vs_rejected_trend", "title": "Good vs rejected units", "kind": "stackedBar", "section": "trend", "x": { "time": "production_date" }, "measures": ["good_units", "rejected_units"], "reason": "Good and rejected units are two parts of total output per period: stacked columns show both the volume and the quality mix.", "alternatives": ["bar", "area"], "size": { "w": 8, "h": 4 }, "priority": 1 },
    { "id": "oee_trend", "title": "OEE over time", "kind": "line", "section": "trend", "x": { "time": "production_date" }, "measures": ["oee"], "reason": "OEE is a ratio recomputed from totals in each period, so it is drawn as a line and never summed.", "alternatives": ["bar"], "size": { "w": 4, "h": 4 }, "priority": 2 },
    { "id": "oee_factors_trend", "title": "Availability, performance and quality", "kind": "line", "section": "trend", "x": { "time": "production_date" }, "measures": ["availability", "performance", "quality_rate"], "reason": "Three rates on the same 0–100% scale share one axis, so the factor dragging OEE down stands out without a second axis.", "alternatives": ["bar"], "size": { "w": 12, "h": 4 }, "priority": 3 },
    { "id": "output_by_line", "title": "Output by line", "kind": "hbar", "section": "breakdown", "x": { "field": "line" }, "measures": ["units_produced"], "topN": 10, "others": true, "drill": ["line", "machine"], "reason": "One total compared across named lines: sorted horizontal bars keep labels readable. Top 10 plus Others.", "alternatives": ["bar", "treemap"], "size": { "w": 6, "h": 5 }, "priority": 1 },
