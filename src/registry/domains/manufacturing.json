    { "id": "oee_by_machine", "title": "OEE by machine", "kind": "hbar", "section": "drivers", "x": { "field": "machine" }, "measures": ["oee"], "topN": 15, "others": false, "minGroupRows": 20, "reason": "A rate compared across machines: sorted bars of OEE recomputed per machine, with machines under 20 rows hidden as too small.", "alternatives": ["bar"], "size": { "w": 6, "h": 5 }, "priority": 1 },
    { "id": "downtime_pareto", "title": "Downtime by reason (Pareto)", "kind": "pareto", "section": "drivers", "x": { "field": "downtime_reason" }, "measures": ["downtime_total"], "analysis": "pareto", "reason": "A few reasons usually cause most lost time: columns per reason with the cumulative share as a line on the same 0–100% axis show what to fix first.", "alternatives": ["hbar"], "size": { "w": 6, "h": 5 }, "priority": 2 },
