    { "id": "machine_scorecard", "title": "Machine scorecard", "kind": "table", "section": "detail", "x": { "field": "machine" }, "measures": ["units_produced", "oee", "availability", "performance", "first_pass_yield", "downtime_total"], "topN": 25, "others": false, "reason": "Several output, OEE and quality measures per machine side by side: a sortable table carries more than any single chart.", "alternatives": ["hbar"], "size": { "w": 12, "h": 6 }, "priority": 1 }
