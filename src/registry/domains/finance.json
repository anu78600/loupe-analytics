{
  "id": "finance",
  "name": "Finance & Accounting",
  "tagline": "P&L, margins and budget variance by month, account and cost centre, plus receivables and payables",
  "description": "Trial-balance and P&L extracts, management accounts and budget files from Tally, Zoho Books, QuickBooks, Xero, SAP and Excel, plus invoice-level receivables and payables listings.",
  "icon": "landmark",
  "entity": "ledger line",
  "goals": ["profit", "efficiency", "cash"],
  "fields": [
    { "id": "period", "label": "Period / month", "roles": ["datetime"], "synonyms": ["month", "period", "posting date", "date", "fiscal period", "fiscal month", "accounting period", "gl date", "transaction date", "entry date", "journal date", "voucher date", "period end", "month end", "reporting period", "as of date"], "exclude": ["due", "invoice", "bill", "paid", "payment", "received", "receipt", "settlement", "cleared", "birth", "created", "issue", "document"], "weight": 3, "core": true },
    { "id": "account", "label": "GL account", "roles": ["dimension", "text"], "synonyms": ["account", "account name", "gl account", "gl account name", "ledger", "ledger name", "ledger account", "account head", "head of account", "nominal account", "account description", "line item", "particulars", "gl name", "expense head"], "exclude": ["type", "class", "category", "group", "code", "number", "id", "nature", "manager", "owner"], "weight": 2.5, "core": true },
    { "id": "account_code", "label": "Account code", "roles": ["identifier", "dimension"], "synonyms": ["account code", "account number", "account no", "account id", "gl code", "gl account number", "gl account code", "gl number", "ledger code", "nominal code", "coa code"], "weight": 0.8 },
    { "id": "account_type", "label": "Account type", "description": "P&L classification of the line: revenue, cost of sales, operating expense, other income, interest, tax or depreciation.", "roles": ["dimension"], "synonyms": ["account type", "type", "account class", "account category", "account group", "category", "classification", "p&l category", "pl category", "p&l head", "line type", "statement line", "financial category", "group", "primary group", "nature", "fs line", "report line"], "valueHints": ["revenue", "sales", "income", "cogs", "cost of sales", "cost of goods sold", "operating expense", "opex", "expense", "other income", "tax", "interest", "depreciation"], "weight": 2.5, "core": true },
    { "id": "cost_center", "label": "Cost centre", "roles": ["dimension"], "synonyms": ["cost center", "cost centre", "cost center name", "cost centre name", "profit center", "profit centre", "department", "dept", "business unit", "bu", "division", "function", "responsibility center", "segment", "team"], "weight": 2 },
    { "id": "entity", "label": "Entity / company", "roles": ["dimension"], "synonyms": ["entity", "legal entity", "company", "company code", "subsidiary", "branch", "unit", "plant", "location"], "weight": 0.8 },
    { "id": "amount", "label": "Actual amount", "description": "Actual (posted) amount in report sign, revenue and costs both positive: a P&L line's actual, or an invoice or bill amount in receivables and payables files.", "roles": ["currency", "measure"], "synonyms": ["actual", "actuals", "actual amount", "amount", "net amount", "value", "posted amount", "transaction amount", "net change", "period amount", "mtd actual", "current month", "invoice amount", "invoice value", "invoice total", "bill amount", "document amount", "total amount", "gross amount", "total"], "exclude": ["budget", "budgeted", "forecast", "plan", "target", "variance", "prior", "previous", "last", "ly", "ytd", "py", "outstanding", "due", "balance", "paid", "open", "pending", "received", "tax", "discount"], "weight": 3, "core": true },
    { "id": "budget", "label": "Budget", "roles": ["currency", "measure"], "synonyms": ["budget", "budget amount", "budgeted", "budgeted amount", "budget value", "plan", "plan amount", "planned", "planned amount", "target", "approved budget", "bgt"], "exclude": ["actual", "variance", "ytd", "remaining", "utilised", "utilized", "balance", "forecast"], "weight": 2.5, "core": true },
    { "id": "document_id", "label": "Invoice / bill number", "roles": ["identifier", "dimension"], "synonyms": ["invoice number", "invoice no", "invoice id", "invoice", "bill number", "bill no", "bill id", "document number", "document no", "doc no", "reference number", "reference", "voucher number", "voucher no", "transaction id"], "exclude": ["date", "amount", "type", "status", "value", "total"], "weight": 2 },
    { "id": "party", "label": "Customer / vendor", "roles": ["dimension", "identifier"], "synonyms": ["customer", "customer name", "vendor", "vendor name", "supplier", "supplier name", "party", "party name", "client", "client name", "payee", "payer", "debtor", "creditor", "counterparty", "bill to", "contact", "contact name"], "exclude": ["type", "group", "category"], "weight": 1.5 },
    { "id": "invoice_date", "label": "Invoice date", "roles": ["datetime"], "synonyms": ["invoice date", "bill date", "document date", "issue date", "billing date", "inv date", "date of invoice", "invoice issue date"], "exclude": ["due", "paid", "payment", "received", "receipt", "settlement"], "weight": 2 },
    { "id": "due_date", "label": "Due date", "roles": ["datetime"], "synonyms": ["due date", "payment due date", "due on", "due by", "invoice due date", "maturity date", "net due date"], "exclude": ["bill", "document", "issue", "posting", "created", "paid", "settlement", "receipt", "cleared"], "weight": 2 },
    { "id": "paid_date", "label": "Paid date", "roles": ["datetime"], "synonyms": ["paid date", "payment date", "date paid", "paid on", "settlement date", "settled on", "cleared date", "clearing date", "receipt date", "collection date", "date received", "payment received date", "last payment date"], "exclude": ["due", "invoice", "bill", "document", "issue", "posting", "created"], "weight": 2 },
    { "id": "outstanding", "atMost": "amount", "label": "Outstanding amount", "roles": ["currency", "measure"], "synonyms": ["outstanding", "outstanding amount", "amount outstanding", "balance due", "amount due", "open amount", "open balance", "unpaid amount", "pending amount", "remaining balance", "balance", "dues"], "exclude": ["days", "age", "aging", "ageing", "bucket"], "weight": 1.5 },
    { "id": "payment_status", "label": "Payment status", "roles": ["dimension"], "synonyms": ["status", "payment status", "invoice status", "bill status", "paid status", "settlement status", "collection status"], "valueHints": ["paid", "unpaid", "partially paid", "overdue", "open", "closed", "pending"], "weight": 1 }
  ],
  "valueClasses": {
    "account_type": [
      { "id": "cogs", "label": "Cost of sales (COGS)", "keywords": ["cogs", "cost of goods sold", "cost of sales", "cost of revenue", "cost of goods", "cost of services", "direct cost", "direct costs", "direct expense", "direct expenses", "purchases", "purchase", "material cost", "materials", "direct material", "direct labour", "direct labor", "cos"] },
      { "id": "depreciation", "label": "Depreciation & amortisation", "keywords": ["depreciation", "amortisation", "amortization", "d&a", "depreciation and amortisation", "depreciation and amortization", "impairment"] },
      { "id": "other_income", "label": "Other income", "keywords": ["other income", "non-operating income", "non operating income", "interest income", "dividend income", "finance income", "investment income", "miscellaneous income", "misc income", "indirect income", "other operating income", "gain", "gains"] },
      { "id": "interest", "label": "Interest & finance costs", "keywords": ["interest", "interest expense", "finance cost", "finance costs", "finance charges", "borrowing costs", "interest paid", "bank interest"] },
      { "id": "tax", "label": "Income tax", "keywords": ["tax", "taxes", "income tax", "tax expense", "taxation", "provision for tax", "current tax", "deferred tax", "corporate tax"] },
      { "id": "opex", "label": "Operating expense", "keywords": ["operating expense", "operating expenses", "opex", "expense", "expenses", "sg&a", "sga", "selling", "marketing", "advertising", "commission", "general and administrative", "g&a", "administrative", "admin", "overhead", "overheads", "payroll", "salary", "salaries", "wages", "employee", "staff", "rent", "utilities", "r&d", "research", "travel", "professional fees", "insurance", "repairs", "indirect expense", "indirect expenses"] },
      { "id": "revenue", "label": "Revenue", "keywords": ["revenue", "rates fees and charges", "operating grants", "grants operating", "revenues", "sales", "income", "turnover", "net sales", "operating revenue", "service revenue", "fee income", "subscription revenue", "sales accounts"] },
      { "id": "non_pnl", "label": "Not income or expense (transfers, investments, balances, capital)", "keywords": ["transfer", "transfers", "trade", "savings", "shares", "stocks", "investments", "investment purchase", "cash at beginning", "cash at end", "cash at the beginning", "cash at the end", "opening balance", "closing balance", "balance brought forward", "balance carried forward", "brought forward", "carried forward", "net cash", "net increase in cash", "net decrease in cash", "proceeds from sale", "property plant", "property infrastructure", "plant and equipment", "capital expenditure", "capex", "asset purchase", "fixed asset", "assets", "asset", "loan repayment", "loan principal", "repayment", "repayments", "drawings", "owner contribution", "capital contribution", "grants capital", "capital grant", "capital grants", "contra", "suspense"] }
    ],
    "payment_status": [
      { "id": "open", "label": "Unpaid / open", "keywords": ["unpaid", "open", "pending", "partially paid", "partial", "outstanding", "overdue", "due", "not paid", "awaiting payment"] },
      { "id": "paid", "label": "Paid", "keywords": ["paid", "settled", "closed", "cleared", "received", "fully paid", "complete", "completed"] }
    ]
  },
  "subDomains": [
    { "id": "pnl", "name": "P&L: actual vs budget", "description": "Ledger or management-report lines per month and account with actual and budget amounts.", "signals": ["period", "account", "account_type", "cost_center", "amount", "budget"], "grain": "account month" },
    { "id": "ar_ap", "name": "Receivables & payables", "description": "One row per invoice or bill with dates, amount and payment status.", "signals": ["document_id", "party", "invoice_date", "due_date", "paid_date", "amount", "outstanding"], "grain": "invoice" }
  ],
  "kpis": [
    { "id": "revenue", "name": "Revenue", "aliases": ["Turnover", "Revenue from operations", "Total revenue", "Total income", "Top line", "Operating revenue"], "definition": "Income from the core business: lines classified as revenue.", "formula": "Sum of actual where account type = revenue", "format": "currency", "direction": "higher", "tier": "hero", "priority": 1, "group": "Income statement", "subDomains": ["pnl"],
      "variants": [{ "id": "class", "label": "Actual on revenue lines", "expr": { "calc": { "agg": "sum", "of": { "field": "amount" } }, "where": { "field": "account_type", "class": "revenue" } } }],
      "pitfalls": ["Revenue stored as negative credits (raw ledger sign) shows up negative; flip the sign before upload."] },
    { "id": "cogs", "name": "Cost of sales", "short": "COGS", "aliases": ["Cost of goods sold", "Cost of revenue", "Direct costs", "Cost of materials consumed"], "definition": "Direct cost of the goods or services sold.", "formula": "Sum of actual where account type = cost of sales", "format": "currency", "direction": "lower", "tier": "supporting", "priority": 10, "group": "Income statement", "limits": { "min": 0 }, "subDomains": ["pnl"],
      "variants": [{ "id": "class", "label": "Actual on cost-of-sales lines", "expr": { "calc": { "agg": "sum", "of": { "field": "amount" } }, "where": { "field": "account_type", "class": "cogs" } } }] },
    { "id": "gross_profit", "name": "Gross profit", "aliases": ["GP", "Gross profit amount"], "definition": "Revenue minus the cost of sales.", "formula": "Revenue − COGS", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 9, "group": "Income statement", "subDomains": ["pnl"],
      "variants": [
        { "id": "diff", "label": "Revenue − COGS", "expr": { "op": "sub", "args": [{ "ref": "revenue" }, { "ref": "cogs" }] } },
        { "id": "no_cogs", "label": "Revenue (no cost-of-sales lines)", "expr": { "ref": "revenue" }, "caveat": "No cost-of-sales lines were found, so gross profit equals revenue (typical for pure service businesses)." }
      ] },
    { "id": "gross_margin", "name": "Gross margin %", "aliases": ["GP %", "GP margin", "Gross margin", "Gross profit margin", "GM %"], "definition": "Share of revenue left after the cost of sales.", "formula": "Gross profit ÷ revenue", "format": "percent", "direction": "higher", "tier": "hero", "priority": 3, "group": "Margins", "subDomains": ["pnl"],
      "variants": [{ "id": "ratio", "label": "Gross profit ÷ revenue", "expr": { "op": "div", "args": [{ "ref": "gross_profit" }, { "ref": "revenue" }] } }] },
    { "id": "opex", "name": "Operating expenses", "short": "Opex", "aliases": ["Operating costs", "Overheads", "SG&A", "Indirect expenses"], "definition": "Running costs of the business outside cost of sales: payroll, rent, marketing, admin and similar.", "formula": "Sum of actual where account type = operating expense", "format": "currency", "direction": "lower", "tier": "supporting", "priority": 11, "group": "Income statement", "limits": { "min": 0 }, "subDomains": ["pnl"],
      "variants": [{ "id": "class", "label": "Actual on operating-expense lines", "expr": { "calc": { "agg": "sum", "of": { "field": "amount" } }, "where": { "field": "account_type", "class": "opex" } } }] },
    { "id": "operating_income", "name": "Operating income", "short": "EBIT", "aliases": ["Operating profit", "PBIT", "Profit before interest and tax"], "definition": "Profit from operations before interest, other income and tax.", "formula": "Revenue − COGS − operating expenses − depreciation", "format": "currency", "direction": "higher", "tier": "hero", "priority": 2, "group": "Income statement", "subDomains": ["pnl"],
      "variants": [
        { "id": "with_da", "label": "Gross profit − opex − depreciation", "expr": { "op": "sub", "args": [{ "op": "sub", "args": [{ "ref": "gross_profit" }, { "ref": "opex" }] }, { "calc": { "agg": "sum", "of": { "field": "amount" } }, "where": { "field": "account_type", "class": "depreciation" } }] } },
        { "id": "no_da", "label": "Gross profit − opex", "expr": { "op": "sub", "args": [{ "ref": "gross_profit" }, { "ref": "opex" }] }, "caveat": "No separate depreciation lines: if D&A is booked inside operating expenses this is EBIT, otherwise it is closer to EBITDA." }
      ] },
    { "id": "operating_margin", "name": "Operating margin %", "aliases": ["EBIT margin", "EBIT %", "Operating profit margin", "OPM"], "definition": "Share of revenue left as operating income.", "formula": "Operating income ÷ revenue", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 7, "group": "Margins", "subDomains": ["pnl"],
      "variants": [{ "id": "ratio", "label": "Operating income ÷ revenue", "expr": { "op": "div", "args": [{ "ref": "operating_income" }, { "ref": "revenue" }] } }] },
    { "id": "total_expenses", "name": "Total expenses", "aliases": ["Total costs", "Total expenditure", "Total expense"], "definition": "Every cost line (cost of sales, operating expenses, depreciation, interest and tax), including any line whose type is not recognised as income.", "formula": "Sum of actual on lines not classified as revenue or other income", "format": "currency", "direction": "lower", "tier": "detail", "priority": 42, "group": "Income statement", "subDomains": ["pnl"],
      "variants": [{ "id": "non_income", "label": "Actual on all non-income lines", "expr": { "calc": { "agg": "sum", "of": { "field": "amount" } }, "where": { "and": [{ "field": "account_type", "notClass": "revenue" }, { "field": "account_type", "notClass": "other_income" }, { "field": "account_type", "notClass": "non_pnl" }, { "field": "account_type", "notNull": true }] } } }] },
    { "id": "net_income", "name": "Net income", "aliases": ["Net profit", "PAT", "Profit after tax", "Net earnings", "Bottom line"], "definition": "Profit after every expense, interest and tax: revenue plus other income minus all expense lines.", "formula": "Revenue + other income − total expenses", "format": "currency", "direction": "higher", "tier": "hero", "priority": 4, "group": "Income statement", "subDomains": ["pnl"],
      "variants": [
        { "id": "full", "label": "Revenue + other income − total expenses", "expr": { "op": "sub", "args": [{ "op": "add", "args": [{ "ref": "revenue" }, { "calc": { "agg": "sum", "of": { "field": "amount" } }, "where": { "field": "account_type", "class": "other_income" } }] }, { "ref": "total_expenses" }] } },
        { "id": "no_other_income", "label": "Revenue − total expenses", "expr": { "op": "sub", "args": [{ "ref": "revenue" }, { "ref": "total_expenses" }] }, "caveat": "No other-income lines were recognised, so every line that is not revenue counts as an expense." }
      ],
      "pitfalls": ["Without tax or interest lines this is profit before tax or interest; check which account types are present."] },
    { "id": "net_margin", "name": "Net margin %", "aliases": ["Net profit margin", "PAT margin", "PAT %", "NPM"], "definition": "Share of revenue left as net income.", "formula": "Net income ÷ revenue", "format": "percent", "direction": "higher", "tier": "hero", "priority": 5, "group": "Margins", "subDomains": ["pnl"],
      "variants": [{ "id": "ratio", "label": "Net income ÷ revenue", "expr": { "op": "div", "args": [{ "ref": "net_income" }, { "ref": "revenue" }] } }] },
    { "id": "opex_ratio", "name": "Opex ratio", "aliases": ["Opex %", "Opex to revenue", "Opex to sales"], "definition": "Operating expenses as a share of revenue.", "formula": "Operating expenses ÷ revenue", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 8, "group": "Margins", "subDomains": ["pnl"],
      "variants": [{ "id": "ratio", "label": "Opex ÷ revenue", "expr": { "op": "div", "args": [{ "ref": "opex" }, { "ref": "revenue" }] } }] },
    { "id": "actual_total", "name": "Actual", "definition": "Sum of actual amounts on the lines in view; meaningful within one account or account type.", "formula": "Sum of actual", "format": "currency", "direction": "neutral", "tier": "detail", "priority": 43, "group": "Budget", "subDomains": ["pnl"], "hidden": true,
      "variants": [{ "id": "sum", "label": "Sum of actual", "expr": { "agg": "sum", "of": { "field": "amount" } } }] },
    { "id": "budget_total", "name": "Budget", "aliases": ["Budget amount", "Budgeted amount"], "definition": "Sum of budgeted amounts on the lines in view; read it within one account type, because income and cost budgets add together.", "formula": "Sum of budget", "format": "currency", "direction": "neutral", "tier": "supporting", "priority": 12, "group": "Budget", "subDomains": ["pnl"],
      "variants": [{ "id": "sum", "label": "Sum of budget", "expr": { "agg": "sum", "of": { "field": "budget" } } }] },
    { "id": "budget_variance", "name": "Budget variance", "aliases": ["Variance vs budget", "Variance to budget", "Budget var"], "definition": "Actual minus budget on the lines in view, where a positive value means actual came in above budget: favourable for revenue lines, unfavourable for cost lines.", "formula": "Σ actual − Σ budget", "format": "currency", "direction": "neutral", "tier": "supporting", "priority": 13, "group": "Budget", "subDomains": ["pnl"],
      "variants": [{ "id": "diff", "label": "Actual − budget", "expr": { "op": "sub", "args": [{ "ref": "actual_total" }, { "ref": "budget_total" }] } }],
      "pitfalls": ["Across revenue and cost lines together the sign is meaningless; filter to an account type, or use Revenue vs budget and Cost vs budget."] },
    { "id": "budget_variance_pct", "name": "Budget variance %", "aliases": ["Variance to budget %", "Budget variance %"], "definition": "Budget variance as a share of budget: for cost lines a positive value is an overspend (lower is better), for revenue lines a beat.", "formula": "(Σ actual − Σ budget) ÷ Σ budget", "format": "percent", "direction": "neutral", "tier": "supporting", "priority": 14, "group": "Budget", "subDomains": ["pnl"],
      "variants": [{ "id": "ratio", "label": "Budget variance ÷ budget", "expr": { "op": "div", "args": [{ "ref": "budget_variance" }, { "ref": "budget_total" }] } }] },
    { "id": "revenue_budget", "name": "Revenue budget", "aliases": ["Budgeted revenue", "Revenue plan"], "definition": "Budgeted revenue for the lines in view.", "formula": "Sum of budget where account type = revenue", "format": "currency", "direction": "neutral", "tier": "detail", "priority": 44, "group": "Budget", "subDomains": ["pnl"],
      "variants": [{ "id": "class", "label": "Budget on revenue lines", "expr": { "calc": { "agg": "sum", "of": { "field": "budget" } }, "where": { "field": "account_type", "class": "revenue" } } }] },
    { "id": "revenue_vs_budget", "name": "Revenue vs budget", "definition": "How far revenue is above (+) or below (−) its budget.", "formula": "Revenue ÷ revenue budget − 1", "format": "percent", "direction": "higher", "tier": "hero", "priority": 6, "group": "Budget", "subDomains": ["pnl"],
      "variants": [{ "id": "ratio", "label": "Revenue ÷ revenue budget − 1", "expr": { "op": "sub", "args": [{ "op": "div", "args": [{ "ref": "revenue" }, { "ref": "revenue_budget" }] }, { "num": 1 }] } }] },
    { "id": "expense_vs_budget", "name": "Cost vs budget", "aliases": ["Budget utilisation", "Budget utilization", "Spend vs budget", "Budget consumed %"], "definition": "How far total expenses are above (+, overspend) or below (−, underspend) their budget; lower is better.", "formula": "(Total expenses − expense budget) ÷ expense budget", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 15, "group": "Budget", "subDomains": ["pnl"],
      "variants": [{ "id": "ratio", "label": "(Expenses − expense budget) ÷ expense budget", "expr": { "op": "div", "args": [{ "op": "sub", "args": [{ "ref": "total_expenses" }, { "calc": { "agg": "sum", "of": { "field": "budget" } }, "where": { "and": [{ "field": "account_type", "notClass": "revenue" }, { "field": "account_type", "notClass": "other_income" }, { "field": "account_type", "notClass": "non_pnl" }, { "field": "account_type", "notNull": true }] } }] }, { "calc": { "agg": "sum", "of": { "field": "budget" } }, "where": { "and": [{ "field": "account_type", "notClass": "revenue" }, { "field": "account_type", "notClass": "other_income" }, { "field": "account_type", "notClass": "non_pnl" }, { "field": "account_type", "notNull": true }] } }] } }] },
    { "id": "invoiced_amount", "name": "Invoiced amount", "aliases": ["Invoice value", "Billed amount", "Amount invoiced"], "definition": "Total value of the invoices or bills raised in the period.", "formula": "Sum of invoice amount", "format": "currency", "direction": "higher", "tier": "hero", "priority": 1, "group": "Receivables & payables", "subDomains": ["ar_ap"],
      "variants": [{ "id": "sum", "label": "Sum of invoice amount", "expr": { "agg": "sum", "of": { "field": "amount" } } }] },
    { "id": "outstanding_amount", "name": "Outstanding", "aliases": ["Receivables", "Accounts receivable", "AR outstanding", "Debtors", "Amount outstanding"], "definition": "Value still unpaid on the invoices or bills in view, as of the export date.", "formula": "Sum of outstanding balance", "format": "currency", "direction": "neutral", "tier": "hero", "priority": 2, "group": "Receivables & payables", "subDomains": ["ar_ap"],
      "variants": [
        { "id": "balance_col", "label": "Outstanding balance column", "expr": { "agg": "sum", "of": { "field": "outstanding" } } },
        { "id": "unpaid_by_date", "label": "Invoice amount with no paid date", "expr": { "calc": { "agg": "sum", "of": { "field": "amount" } }, "where": { "field": "paid_date", "isNull": true } }, "caveat": "Unpaid invoices are counted at full value; part-payments are not netted off." },
        { "id": "unpaid_by_status", "label": "Invoice amount with an unpaid status", "expr": { "calc": { "agg": "sum", "of": { "field": "amount" } }, "where": { "field": "payment_status", "class": "open" } }, "caveat": "Unpaid and part-paid invoices are counted at full value." }
      ],
      "pitfalls": ["Outstanding is a snapshot of the export date; it is not comparable with a file exported on another day."] },
    { "id": "avg_days_to_pay", "name": "Average days to pay", "aliases": ["DSO", "Days sales outstanding", "Debtor days", "Average collection period"], "definition": "Calendar days from invoice date to payment, weighted by invoice amount (a DSO-style measure for settled invoices).", "formula": "Σ (amount × days from invoice to payment) ÷ Σ amount, over paid invoices", "format": "days", "direction": "lower", "tier": "hero", "priority": 3, "group": "Receivables & payables", "subDomains": ["ar_ap"],
      "variants": [
        { "id": "amount_weighted", "label": "Amount-weighted days to pay", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "op": "mul", "args": [{ "field": "amount" }, { "daysBetween": ["invoice_date", "paid_date"] }] } }, { "agg": "sum", "of": { "field": "amount" }, "where": { "and": [{ "field": "paid_date", "notNull": true }, { "field": "invoice_date", "notNull": true }] } }] } },
