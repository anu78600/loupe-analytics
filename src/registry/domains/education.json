{
  "id": "education",
  "name": "Education",
  "tagline": "Students, enrolments, scores, pass rates, attendance, completion and fee collection",
  "description": "School ERP and student information system exports, marks registers and result sheets, attendance registers, LMS and online-course enrolment logs and fee ledgers for schools, colleges, coaching institutes and online academies, including Indian fields such as roll number, USN, PRN and class-section.",
  "icon": "graduation-cap",
  "entity": "student",
  "goals": ["learning outcomes", "retention", "fee collection"],
  "fields": [
    { "id": "student_id", "label": "Student ID", "roles": ["identifier", "dimension"], "synonyms": ["student id", "student number", "student no", "student code", "roll number", "roll no", "roll", "admission number", "admission no", "enrollment number", "enrolment number", "enrollment no", "enrolment no", "registration number", "registration no", "scholar number", "sr number", "gr number", "usn", "prn", "learner id", "pupil id", "candidate id", "user id", "student"], "exclude": ["name", "class", "grade", "section", "teacher", "course", "parent", "guardian", "father", "mother", "age", "gender", "fee", "fees", "subject", "exam"], "weight": 3, "core": true, "description": "Identifies each student; repeats once per subject, exam, session or payment." },
    { "id": "student_name", "label": "Student name", "roles": ["dimension", "text"], "synonyms": ["student name", "name of student", "learner name", "pupil name", "candidate name", "full name", "name"], "exclude": ["teacher", "parent", "guardian", "father", "mother", "course", "subject", "school", "class", "college", "institute", "exam", "program", "faculty", "instructor"], "weight": 0.3 },
    { "id": "activity_date", "label": "Exam / attendance date", "roles": ["datetime"], "synonyms": ["date", "exam date", "test date", "assessment date", "attendance date", "class date", "session date", "lecture date", "activity date", "date of exam", "examination date", "attempt date", "submission date", "result date", "event date", "payment date", "receipt date", "transaction date", "fee date", "timestamp"], "exclude": ["birth", "dob", "birthdate", "admission", "enrolment", "enrollment", "joining", "registration", "due", "completion", "completed", "leaving", "dropout", "withdrawal", "graduation", "start", "end"], "weight": 2.5, "core": true },
    { "id": "enrolment_date", "label": "Enrolment date", "roles": ["datetime"], "synonyms": ["enrolment date", "enrollment date", "enrolled on", "enrolled at", "enrolled date", "date of enrolment", "date of enrollment", "enrollment datetime", "admission date", "date of admission", "joining date", "date of joining", "doj", "registration date", "course start date", "start date", "signup date"], "exclude": ["birth", "exam", "attendance", "completion", "end", "payment", "due", "leaving"], "weight": 2 },
    { "id": "completion_date", "label": "Completion / exit date", "roles": ["datetime"], "synonyms": ["completion date", "completed on", "completed at", "date of completion", "graduation date", "course end date", "end date", "certificate date", "certification date", "passing out date", "leaving date", "date of leaving", "exit date", "dropout date"], "exclude": ["start", "enrolment", "enrollment", "admission", "due", "expected", "planned", "birth"], "weight": 1 },
    { "id": "teacher_id", "label": "Teacher", "roles": ["identifier", "dimension"], "synonyms": ["teacher", "faculty", "instructor", "tutor", "mentor", "class teacher", "trainer", "lecturer", "professor", "educator", "teaching staff"], "exclude": ["student", "parent", "count", "ratio", "per", "subject"], "weight": 1.5 },
    { "id": "course", "label": "Course / subject", "roles": ["dimension"], "synonyms": ["course", "course name", "course title", "course code", "subject", "subject name", "subject code", "paper", "paper code", "module", "class subject"], "exclude": ["fee", "fees", "teacher", "faculty", "student", "start", "end", "date", "status", "type", "duration", "category", "completion", "progress", "enrollment", "enrolment", "preparation"], "weight": 2.5, "core": true },
    { "id": "program", "label": "Program / stream", "roles": ["dimension"], "synonyms": ["program", "programme", "degree", "stream", "major", "specialization", "specialisation", "department", "dept", "discipline", "course of study", "branch"], "exclude": ["fee", "fees", "head", "teacher", "subject", "code"], "weight": 1.5 },
    { "id": "grade_level", "label": "Class / grade", "roles": ["dimension"], "synonyms": ["class", "grade", "standard", "std", "year level", "grade level", "class level", "level", "form", "year of study", "current class", "year"], "exclude": ["section", "teacher", "subject", "letter", "point", "points", "obtained", "awarded", "final", "academic", "fee", "fees", "size", "strength", "rank", "attended", "held", "date", "education", "difficulty", "parental", "parent", "income", "risk", "birth"], "valueHints": ["grade 1", "grade 10", "class 10", "class x", "std 10", "first year", "second year", "nursery", "lkg", "ukg", "kindergarten", "freshman", "sophomore"], "weight": 1.5 },
    { "id": "section", "label": "Section / batch", "roles": ["dimension"], "synonyms": ["section", "class section", "division", "div", "batch", "group", "homeroom", "class group", "batch name"], "exclude": ["blood", "age", "income", "risk", "ethnicity", "race"], "weight": 1 },
    { "id": "term", "label": "Term / exam", "roles": ["dimension"], "synonyms": ["term", "exam", "examination", "assessment", "test", "semester", "sem", "quarter", "unit test", "evaluation", "exam term"], "exclude": ["date", "score", "marks", "result", "fee", "fees", "preparation", "prep", "course", "status"], "valueHints": ["term 1", "term 2", "midterm", "mid term", "final", "finals", "unit test", "quarterly", "half yearly", "annual", "semester 1", "sem 1", "periodic test", "pre board", "end term"], "weight": 1.5 },
    { "id": "academic_year", "label": "Academic year", "roles": ["dimension"], "synonyms": ["academic year", "session", "academic session", "school year", "ay", "batch year", "cohort", "intake", "admission year", "year of admission"], "exclude": ["semester", "term", "class", "attended", "held"], "weight": 1 },
    { "id": "score", "label": "Marks / score", "roles": ["measure", "rate"], "synonyms": ["marks", "marks obtained", "obtained marks", "marks scored", "mark", "score", "score obtained", "total marks obtained", "total score", "raw score", "test score", "exam score", "points", "points earned", "points scored", "math score", "total", "total marks scored"], "exclude": ["max", "maximum", "full", "out", "pass", "passing", "min", "minimum", "cut", "cutoff", "percent", "rank", "attendance", "credit", "possible", "satisfaction", "internal", "external", "theory", "practical", "assignment", "lab", "viva", "project", "sessional"], "weight": 2.5, "core": true },
    { "id": "max_score", "label": "Maximum marks", "roles": ["measure"], "synonyms": ["max marks", "maximum marks", "max score", "maximum score", "full marks", "total marks", "out of", "marks out of", "max points", "points possible", "possible points", "maximum points", "max mark"], "exclude": ["obtained", "scored", "earned", "pass", "passing", "min", "minimum", "internal", "external", "theory", "practical", "assignment", "lab", "viva", "project", "sessional", "midterm"], "weight": 2 },
    { "id": "pass_mark", "label": "Pass mark", "roles": ["measure"], "synonyms": ["pass marks", "passing marks", "pass mark", "min marks", "minimum marks", "pass score", "passing score", "cut off", "cutoff", "cut off marks", "qualifying marks", "minimum passing marks"], "exclude": ["obtained", "scored", "max", "maximum", "percent", "internal", "external", "theory", "practical", "assignment", "lab", "viva", "project", "sessional", "total"], "weight": 1 },
    { "id": "percentage", "label": "Score %", "roles": ["percentage", "rate"], "synonyms": ["percentage", "percent", "marks percentage", "percentage marks", "aggregate percentage", "overall percentage", "%"], "exclude": ["attendance", "fee", "fees", "progress", "completion", "scholarship", "discount", "concession", "reading", "writing", "math"], "weight": 0.8 },
    { "id": "result", "label": "Result", "roles": ["dimension"], "synonyms": ["result", "pass fail", "pass or fail", "pass status", "outcome", "result status", "exam result", "final result", "overall result", "remarks"], "exclude": ["date", "declaration", "attendance", "enrolment", "enrollment", "course", "fee", "payment"], "valueHints": ["pass", "fail", "passed", "failed", "promoted", "detained", "compartment", "supplementary", "distinction", "first class", "absent", "withheld", "atkt", "re-appear"], "weight": 2 },
    { "id": "enrolment_status", "label": "Enrolment status", "roles": ["dimension"], "synonyms": ["enrolment status", "enrollment status", "student status", "course status", "completion status", "progress status", "academic status", "current status", "learner status"], "exclude": ["fee", "fees", "payment", "result", "attendance", "marital", "employment", "exam", "preparation", "test"], "valueHints": ["enrolled", "active", "completed", "graduated", "dropped", "dropped out", "withdrawn", "in progress", "transferred", "passed out", "alumni", "deferred", "discontinued"], "weight": 2 },
    { "id": "attended_sessions", "label": "Sessions attended", "roles": ["measure"], "synonyms": ["sessions attended", "classes attended", "lectures attended", "periods attended", "days attended", "attended", "attended sessions", "attended classes", "days present", "present days", "no of days present", "present count", "attendance count", "attendance days"], "exclude": ["total", "held", "conducted", "scheduled", "percent", "rate", "absent"], "weight": 1.5 },
    { "id": "total_sessions", "label": "Total sessions", "roles": ["measure"], "synonyms": ["total sessions", "total classes", "classes held", "sessions held", "lectures held", "periods held", "total lectures", "total periods", "working days", "total working days", "total days", "classes conducted", "sessions conducted", "scheduled sessions"], "exclude": ["attended", "present", "absent", "percent", "rate"], "weight": 1.5 },
    { "id": "attendance_status", "label": "Attendance mark", "roles": ["dimension"], "synonyms": ["attendance", "attendance status", "attendance mark", "presence", "present absent", "present or absent", "attendance code"], "exclude": ["percent", "rate", "count", "days", "date", "sessions", "ratio"], "valueHints": ["present", "absent", "late", "leave", "holiday", "excused", "unexcused", "half day", "tardy"], "weight": 1.2 },
    { "id": "attendance_pct", "label": "Attendance %", "roles": ["percentage", "rate"], "synonyms": ["attendance percentage", "attendance percent", "attendance %", "attendance rate", "percentage attendance", "percent attendance", "attendance ratio"], "exclude": ["progress", "completion", "score", "marks", "fee", "fees"], "weight": 0.8 },
    { "id": "fees_due", "label": "Fees due", "roles": ["currency", "measure"], "synonyms": ["fees due", "fee due", "total fees", "total fee", "fee amount", "fees amount", "fees payable", "fee payable", "net fees", "net fee", "tuition fee", "tuition fees", "course fee", "course fees", "fees", "fee", "fees charged", "fee demand", "amount due", "due amount", "annual fee"], "exclude": ["paid", "received", "collected", "balance", "pending", "outstanding", "concession", "discount", "waiver", "scholarship", "fine", "late", "refund", "type", "head", "category", "date", "mode", "status", "receipt", "marks", "score", "credit"], "weight": 2 },
    { "id": "fees_paid", "label": "Fees paid", "roles": ["currency", "measure"], "synonyms": ["fees paid", "fee paid", "amount paid", "paid amount", "fees received", "fee received", "amount received", "received amount", "fees collected", "fee collected", "amount collected", "collection", "paid", "payment amount", "receipt amount", "fees deposited", "deposit amount"], "exclude": ["due", "payable", "balance", "pending", "outstanding", "date", "mode", "status", "method", "type", "refund"], "weight": 2 },
    { "id": "scholarship_amount", "label": "Scholarship / concession", "roles": ["currency", "measure"], "synonyms": ["scholarship", "scholarship amount", "concession", "fee concession", "concession amount", "discount", "fee discount", "waiver", "fee waiver", "financial aid", "aid amount", "bursary", "freeship"], "exclude": ["type", "name", "scheme", "status", "percent", "category"], "weight": 0.8 },
    { "id": "fee_head", "label": "Fee head", "roles": ["dimension"], "synonyms": ["fee head", "fee type", "fee category", "fee component", "fee particulars", "particulars", "fee description", "head of account"], "exclude": ["amount", "paid", "due", "date", "mode"], "weight": 0.8 },
    { "id": "gender", "label": "Gender", "roles": ["dimension"], "synonyms": ["gender", "sex", "student gender"], "valueHints": ["male", "female", "boy", "girl", "transgender"], "weight": 0.5 },
    { "id": "campus", "label": "School / campus", "roles": ["dimension"], "synonyms": ["campus", "school", "college", "institute", "institution", "centre", "center"], "exclude": ["type", "board", "previous", "last", "fee", "fees", "cost"], "weight": 1 },
    { "id": "completed_flag", "label": "Completed", "roles": ["boolean"], "synonyms": ["completed", "completion", "certified", "certificate earned", "course completed", "course completion", "finished", "passed course", "certificate issued"], "exclude": ["date", "percent", "status"], "weight": 1.2 }
  ],
  "valueClasses": {
    "result": [
      { "id": "absent", "label": "Absent / withheld", "keywords": ["absent", "ab", "did not appear", "not appeared", "withheld", "rw"] },
      { "id": "fail", "label": "Fail", "keywords": ["fail", "failed", "detained", "not passed", "compartment", "supplementary", "re appear", "reappear", "atkt", "kt", "f", "ungraded"] },
      { "id": "pass", "label": "Pass", "keywords": ["pass", "passed", "promoted", "distinction", "first class", "second class", "third class", "merit", "qualified", "cleared", "p"] }
    ],
    "enrolment_status": [
      { "id": "dropped", "label": "Dropped / withdrawn", "keywords": ["dropped", "dropout", "drop out", "dropped out", "withdrawn", "withdrew", "discontinued", "left", "terminated", "expelled", "struck off", "cancelled"] },
      { "id": "transferred", "label": "Transferred", "keywords": ["transferred", "transfer", "tc issued", "migrated"] },
      { "id": "completed", "label": "Completed", "keywords": ["completed", "complete", "graduated", "passed out", "pass out", "certified", "finished", "alumni", "awarded"] },
      { "id": "enrolled", "label": "Enrolled / in progress", "keywords": ["enrolled", "active", "in progress", "ongoing", "studying", "current", "registered", "admitted", "continuing", "pursuing", "started"] }
    ],
    "attendance_status": [
      { "id": "absent", "label": "Absent", "keywords": ["absent", "absence", "a", "ab", "unexcused", "missed", "not present"] },
      { "id": "present", "label": "Present", "keywords": ["present", "p", "attended", "late", "tardy", "half day", "on time"] }
    ]
  },
  "subDomains": [
    { "id": "assessments", "name": "Marks & assessments", "description": "One row per student per subject per exam with marks, maximum marks and result.", "signals": ["student_id", "course", "grade_level", "term", "score", "max_score", "result", "teacher_id", "activity_date"], "grain": "student × subject × exam" },
    { "id": "enrolments", "name": "Enrolments & completion", "description": "One row per student per course or programme with enrolment status and dates.", "signals": ["student_id", "course", "program", "enrolment_date", "enrolment_status", "completion_date", "completed_flag", "fees_due"], "grain": "enrolment" },
    { "id": "attendance", "name": "Attendance", "description": "One row per student per day or session (present or absent), or per student per term with sessions attended and held.", "signals": ["student_id", "activity_date", "grade_level", "section", "attendance_status", "attended_sessions", "total_sessions", "attendance_pct"], "grain": "student-day or student-term" },
    { "id": "fees", "name": "Fees & collections", "description": "One row per student fee demand or payment with amounts due, paid and concessions.", "signals": ["student_id", "fees_due", "fees_paid", "scholarship_amount", "program", "grade_level", "activity_date"], "grain": "student fee record" }
  ],
  "kpis": [
    { "id": "students", "name": "Students", "definition": "Distinct students in the period.", "formula": "Count of distinct student IDs", "format": "integer", "direction": "neutral", "tier": "hero", "priority": 1, "group": "Students",
      "variants": [
        { "id": "distinct", "label": "Distinct student IDs", "expr": { "agg": "countDistinct", "of": "student_id" } },
        { "id": "names", "label": "Distinct student names", "expr": { "agg": "countDistinct", "of": "student_name" }, "caveat": "No student ID, so students are counted by name: namesakes merge and spelling variants split." }
      ] },
    { "id": "avg_score_pct", "name": "Average score %", "short": "Avg score", "definition": "Marks obtained as a share of the maximum marks available.", "formula": "Σ marks obtained ÷ Σ maximum marks, on rows that have both (never an average of percentages)", "format": "percent", "direction": "higher", "tier": "hero", "priority": 2, "group": "Learning outcomes",
      "variants": [{ "id": "ratio", "label": "Marks ÷ maximum marks", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "score" }, "where": { "field": "max_score", "notNull": true } }, { "agg": "sum", "of": { "field": "max_score" }, "where": { "field": "score", "notNull": true } }] } }],
      "pitfalls": ["Averaging row percentages would weight a 10-mark quiz the same as a 100-mark exam; this KPI is a ratio of totals.", "Papers differ in difficulty: compare a class with itself across terms, or classes on the same paper."] },
    { "id": "pass_rate", "name": "Pass rate", "definition": "Share of results that were a pass, among students who appeared.", "formula": "Pass results ÷ results with an outcome (absent and withheld excluded)", "format": "percent", "direction": "higher", "tier": "hero", "priority": 3, "group": "Learning outcomes",
      "variants": [
        { "id": "result", "label": "Passes ÷ results (absent excluded)", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "result", "class": "pass" } }, { "agg": "count", "where": { "and": [{ "field": "result", "notNull": true }, { "field": "result", "notClass": "absent" }] } }] } },
        { "id": "pass_mark", "label": "Marks ≥ pass mark", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "score", "cmpField": "gte", "other": "pass_mark" } }, { "agg": "count", "where": { "and": [{ "field": "score", "notNull": true }, { "field": "pass_mark", "notNull": true }] } }] }, "caveat": "No result column, so a pass is marks at or above the pass mark on each row." }
      ],
      "pitfalls": ["Counted per result row: in a subject-wise file a student who fails one of five papers counts as four passes and one fail.", "Grace marks and re-tests change results after the first declaration; make sure the file holds final results."] },
    { "id": "attendance_rate", "name": "Attendance rate", "definition": "Share of scheduled sessions that students attended.", "formula": "Σ sessions attended ÷ Σ sessions held, on rows that have both", "format": "percent", "direction": "higher", "tier": "hero", "priority": 4, "group": "Engagement",
      "variants": [
        { "id": "sessions", "label": "Attended ÷ held sessions", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "attended_sessions" }, "where": { "field": "total_sessions", "notNull": true } }, { "agg": "sum", "of": { "field": "total_sessions" }, "where": { "field": "attended_sessions", "notNull": true } }] } },
        { "id": "marks", "label": "Present ÷ present-or-absent marks", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "attendance_status", "class": "present" } }, { "agg": "count", "where": { "or": [{ "field": "attendance_status", "class": "present" }, { "field": "attendance_status", "class": "absent" }] } }] }, "caveat": "No session counts, so each present or absent mark in the register is one session; leave and holiday marks are left out." }
      ],
      "pitfalls": ["Whether authorised leave counts as absence differs between schools; compare only under one rule."] },
    { "id": "completion_rate", "name": "Completion rate", "definition": "Share of enrolments that were completed.", "formula": "Completed enrolments ÷ enrolments with a status (one per student and course)", "format": "percent", "direction": "higher", "tier": "hero", "priority": 5, "group": "Retention",
      "variants": [
        { "id": "enrolments", "label": "Completed ÷ enrolments (student × course)", "expr": { "op": "div", "args": [{ "per": "student_id", "inner": { "agg": "countDistinct", "of": "course", "where": { "field": "enrolment_status", "class": "completed" } }, "reduce": "sum" }, { "per": "student_id", "inner": { "agg": "countDistinct", "of": "course", "where": { "field": "enrolment_status", "notNull": true } }, "reduce": "sum" }] } },
        { "id": "students", "label": "Completed ÷ students", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "student_id", "where": { "field": "enrolment_status", "class": "completed" } }, { "agg": "countDistinct", "of": "student_id", "where": { "field": "enrolment_status", "notNull": true } }] }, "caveat": "No course column, so each student counts as one enrolment." },
        { "id": "rows", "label": "Completed rows ÷ rows", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "enrolment_status", "class": "completed" } }, { "agg": "count", "where": { "field": "enrolment_status", "notNull": true } }] }, "caveat": "No student ID, so each row is one enrolment." },
        { "id": "flag", "label": "Completion flag ÷ students", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "student_id", "where": { "field": "completed_flag", "isTrue": true } }, { "agg": "countDistinct", "of": "student_id", "where": { "field": "completed_flag", "notNull": true } }] }, "caveat": "No status column, so the completion flag is used per student; learners still in progress count as not completed." }
      ],
      "pitfalls": ["Recent cohorts are still in progress, so their completion looks low until they finish (right-censoring); compare cohorts after the same time."] },
    { "id": "fee_collection_rate", "name": "Fee collection rate", "short": "Collection %", "definition": "Share of fees due that has been collected.", "formula": "Σ fees paid ÷ Σ fees due", "format": "percent", "direction": "higher", "tier": "hero", "priority": 6, "group": "Finance", "subDomains": ["fees", "enrolments"],
      "variants": [{ "id": "ratio", "label": "Fees paid ÷ fees due", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "fees_paid" } }, { "agg": "sum", "of": { "field": "fees_due" } }] } }],
      "pitfalls": ["If fees due are recorded before concessions, scholarships look like unpaid fees; check whether the due amount is gross or net."] },
    { "id": "dropout_rate", "name": "Dropout rate", "definition": "Share of enrolments that ended with the student dropping out or withdrawing.", "formula": "Dropped or withdrawn enrolments ÷ enrolments with a status (one per student and course)", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 7, "group": "Retention",
      "variants": [
        { "id": "enrolments", "label": "Dropped ÷ enrolments (student × course)", "expr": { "op": "div", "args": [{ "per": "student_id", "inner": { "agg": "countDistinct", "of": "course", "where": { "field": "enrolment_status", "class": "dropped" } }, "reduce": "sum" }, { "per": "student_id", "inner": { "agg": "countDistinct", "of": "course", "where": { "field": "enrolment_status", "notNull": true } }, "reduce": "sum" }] } },
        { "id": "students", "label": "Dropped ÷ students", "expr": { "op": "div", "args": [{ "agg": "countDistinct", "of": "student_id", "where": { "field": "enrolment_status", "class": "dropped" } }, { "agg": "countDistinct", "of": "student_id", "where": { "field": "enrolment_status", "notNull": true } }] }, "caveat": "No course column, so each student counts as one enrolment." },
        { "id": "rows", "label": "Dropped rows ÷ rows", "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "enrolment_status", "class": "dropped" } }, { "agg": "count", "where": { "field": "enrolment_status", "notNull": true } }] }, "caveat": "No student ID, so each row is one enrolment." }
      ],
      "pitfalls": ["Transfers to another school are not dropouts; they are kept out of the numerator here.", "Grows with the length of the period, so compare like-for-like time windows."] },
    { "id": "enrolments", "name": "Enrolments", "definition": "Distinct student and course (or subject) combinations in the period.", "formula": "Σ over students of distinct courses", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 8, "group": "Students",
      "variants": [
        { "id": "student_course", "label": "Distinct student × course pairs", "expr": { "per": "student_id", "inner": { "agg": "countDistinct", "of": "course" }, "reduce": "sum" } },
        { "id": "status_rows", "label": "Rows with an enrolment status", "expr": { "agg": "count", "where": { "field": "enrolment_status", "notNull": true } }, "caveat": "No student or course column, so each row with a status is one enrolment." }
      ] },
    { "id": "avg_marks", "name": "Average marks", "definition": "Average raw marks per result, on whatever scale each paper uses.", "formula": "Average of marks obtained", "format": "decimal", "direction": "higher", "tier": "supporting", "priority": 9, "group": "Learning outcomes",
      "variants": [{ "id": "avg", "label": "Average marks", "expr": { "agg": "avg", "of": { "field": "score" } } }],
      "pitfalls": ["Mixes papers marked out of different totals; prefer average score % when maximum marks are available."] },
    { "id": "teachers", "name": "Teachers", "definition": "Distinct teachers or instructors in the period.", "formula": "Count of distinct teachers", "format": "integer", "direction": "neutral", "tier": "detail", "priority": 44, "group": "Staffing",
      "variants": [{ "id": "distinct", "label": "Distinct teachers", "expr": { "agg": "countDistinct", "of": "teacher_id" } }] },
    { "id": "students_per_teacher", "name": "Students per teacher", "short": "PTR", "definition": "Distinct students for each distinct teacher (pupil-teacher ratio).", "formula": "Students ÷ teachers (distinct counts)", "format": "decimal", "direction": "lower", "tier": "supporting", "priority": 10, "group": "Staffing",
      "variants": [{ "id": "ratio", "label": "Students ÷ teachers", "expr": { "op": "div", "args": [{ "ref": "students" }, { "ref": "teachers" }] } }],
      "benchmark": { "high": 30, "note": "Indicative: India's RTE norm is at most 30 pupils per teacher in primary and 35 in upper primary." },
      "pitfalls": ["Only teachers who appear in this file are counted, so a marks file for a few subjects overstates the ratio."] },
    { "id": "fees_collected", "name": "Fees collected", "definition": "Fees received in the period.", "formula": "Sum of fees paid", "format": "currency", "direction": "higher", "tier": "supporting", "priority": 11, "group": "Finance", "subDomains": ["fees", "enrolments"],
      "variants": [{ "id": "sum", "label": "Sum of fees paid", "expr": { "agg": "sum", "of": { "field": "fees_paid" } } }] },
    { "id": "fees_outstanding", "name": "Fees outstanding", "definition": "Fees due that have not yet been paid.", "formula": "Σ fees due − Σ fees paid", "format": "currency", "direction": "lower", "tier": "supporting", "priority": 12, "group": "Finance", "subDomains": ["fees", "enrolments"],
      "variants": [{ "id": "diff", "label": "Fees due − fees paid", "expr": { "op": "sub", "args": [{ "agg": "sum", "of": { "field": "fees_due" } }, { "agg": "sum", "of": { "field": "fees_paid" } }] } }],
      "pitfalls": ["Advance payments for later terms reduce the figure and can even make it negative."] },
    { "id": "new_students", "name": "New students", "definition": "Students whose first activity in the file falls in the period.", "formula": "Students with first exam, attendance or payment date ≥ period start", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 13, "group": "Students",
      "variants": [{ "id": "first_activity", "label": "First activity in period", "expr": { "newEntities": "student_id", "date": "activity_date" } }],
      "pitfalls": ["Students whose first activity predates this file look new. The longer the history, the more accurate this is."] },
    { "id": "low_attendance_students", "name": "Students below 75% attendance", "short": "Below 75%", "definition": "Students whose attendance is under 75%, the minimum many Indian boards and universities require to sit exams.", "formula": "Students with Σ attended ÷ Σ held < 75%", "format": "integer", "direction": "lower", "tier": "supporting", "priority": 14, "group": "Engagement",
      "variants": [
        { "id": "sessions", "label": "Per-student attended ÷ held < 75%", "expr": { "calc": { "per": "student_id", "inner": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "attended_sessions" } }, { "agg": "sum", "of": { "field": "total_sessions" } }] }, "reduce": "count", "having": { "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "attended_sessions" } }, { "agg": "sum", "of": { "field": "total_sessions" } }] }, "cmp": "lt", "value": 0.75 } }, "where": { "and": [{ "field": "attended_sessions", "notNull": true }, { "field": "total_sessions", "notNull": true }] } } },
        { "id": "marks", "label": "Per-student present ÷ marked < 75%", "expr": { "calc": { "per": "student_id", "inner": { "op": "div", "args": [{ "agg": "count", "where": { "field": "attendance_status", "class": "present" } }, { "agg": "count" }] }, "reduce": "count", "having": { "expr": { "op": "div", "args": [{ "agg": "count", "where": { "field": "attendance_status", "class": "present" } }, { "agg": "count" }] }, "cmp": "lt", "value": 0.75 } }, "where": { "or": [{ "field": "attendance_status", "class": "present" }, { "field": "attendance_status", "class": "absent" }] } }, "caveat": "No session counts, so each present or absent mark in the register is one session." }
      ],
      "pitfalls": ["The 75% rule is a common Indian requirement, not a universal one; schools elsewhere often flag chronic absence below 90%."] },
    { "id": "failing_students", "name": "Students with a fail", "definition": "Students with at least one failed result in the period.", "formula": "Students with ≥ 1 fail result", "format": "integer", "direction": "lower", "tier": "detail", "priority": 40, "group": "Learning outcomes",
      "variants": [
        { "id": "result", "label": "Students with a fail result", "expr": { "per": "student_id", "inner": { "agg": "count", "where": { "field": "result", "class": "fail" } }, "reduce": "count", "having": { "expr": { "agg": "count", "where": { "field": "result", "class": "fail" } }, "cmp": "gte", "value": 1 } } },
        { "id": "pass_mark", "label": "Students below the pass mark", "expr": { "per": "student_id", "inner": { "agg": "count", "where": { "field": "score", "cmpField": "lt", "other": "pass_mark" } }, "reduce": "count", "having": { "expr": { "agg": "count", "where": { "field": "score", "cmpField": "lt", "other": "pass_mark" } }, "cmp": "gte", "value": 1 } }, "caveat": "No result column, so a fail is marks below the pass mark." }
      ] },
    { "id": "scholarship_share", "name": "Scholarship & concession share", "short": "Concession %", "definition": "Scholarships, waivers and concessions as a share of fees due.", "formula": "Σ scholarship ÷ Σ fees due", "format": "percent", "direction": "neutral", "tier": "detail", "priority": 41, "group": "Finance", "subDomains": ["fees", "enrolments"],
      "variants": [{ "id": "ratio", "label": "Scholarship ÷ fees due", "expr": { "op": "div", "args": [{ "agg": "sum", "of": { "field": "scholarship_amount" } }, { "agg": "sum", "of": { "field": "fees_due" } }] } }] },
    { "id": "avg_days_to_complete", "name": "Average time to complete", "short": "Days to complete", "definition": "Average calendar days from enrolment to completion, for completed enrolments.", "formula": "Average of (completion date − enrolment date) where status = completed", "format": "days", "direction": "lower", "tier": "detail", "priority": 42, "group": "Retention",
      "variants": [
        { "id": "completed", "label": "Completed enrolments", "expr": { "agg": "avg", "of": { "daysBetween": ["enrolment_date", "completion_date"] }, "where": { "field": "enrolment_status", "class": "completed" } } },
        { "id": "all", "label": "All with an exit date", "expr": { "agg": "avg", "of": { "daysBetween": ["enrolment_date", "completion_date"] } }, "caveat": "No completed status, so every enrolment with an end date counts, including dropouts." }
      ] },
    { "id": "courses", "name": "Courses / subjects", "definition": "Distinct courses or subjects in the period.", "formula": "Count of distinct courses", "format": "integer", "direction": "neutral", "tier": "detail", "priority": 43, "group": "Students",
      "variants": [{ "id": "distinct", "label": "Distinct courses", "expr": { "agg": "countDistinct", "of": "course" } }] },
    { "id": "assessments_count", "name": "Results recorded", "definition": "Number of marks or result entries in the period.", "formula": "Count of rows with marks (or a result)", "format": "integer", "direction": "neutral", "tier": "detail", "priority": 45, "group": "Learning outcomes",
      "variants": [
        { "id": "marks", "label": "Rows with marks", "expr": { "agg": "count", "where": { "field": "score", "notNull": true } } },
        { "id": "results", "label": "Rows with a result", "expr": { "agg": "count", "where": { "field": "result", "notNull": true } }, "caveat": "No marks column, so rows with a result are counted." }
      ] }
  ],
  "charts": [
    { "id": "score_trend", "title": "Average score % over time", "kind": "line", "section": "trend", "x": { "time": "activity_date" }, "measures": ["avg_score_pct"], "reason": "A ratio of marks to maximum marks recomputed per period, drawn as a line and never summed.", "alternatives": ["bar"], "size": { "w": 8, "h": 4 }, "priority": 1 },
    { "id": "attendance_trend", "title": "Attendance rate over time", "kind": "line", "section": "trend", "x": { "time": "activity_date" }, "measures": ["attendance_rate"], "reason": "A rate over time is recomputed from sessions in each period and drawn as a line.", "alternatives": ["bar"], "size": { "w": 4, "h": 4 }, "priority": 2 },
    { "id": "enrolment_trend", "title": "Enrolments over time", "kind": "bar", "section": "trend", "x": { "time": "enrolment_date" }, "measures": ["enrolments"], "reason": "Enrolments per period are discrete counts, so columns from a zero baseline compare them honestly.", "alternatives": ["line", "area"], "size": { "w": 6, "h": 4 }, "priority": 3 },
    { "id": "score_by_course", "title": "Average score % by course", "kind": "hbar", "section": "breakdown", "x": { "field": "course" }, "measures": ["avg_score_pct"], "topN": 15, "others": false, "minGroupRows": 20, "drill": ["course", "grade_level", "section"], "reason": "A ratio compared across named courses: sorted horizontal bars of the recomputed score %, with courses under 20 results hidden as too small.", "alternatives": ["bar"], "size": { "w": 6, "h": 5 }, "priority": 1 },
    { "id": "students_by_grade", "title": "Students by class", "kind": "hbar", "section": "breakdown", "x": { "field": "grade_level" }, "measures": ["students"], "topN": 15, "others": true, "reason": "One distinct count compared across classes or years: sorted bars, top 15 plus Others.", "alternatives": ["bar", "treemap"], "size": { "w": 6, "h": 5 }, "priority": 2 },
    { "id": "enrolment_status_mix", "title": "Enrolments by status", "kind": "donut", "section": "breakdown", "x": { "field": "enrolment_status" }, "measures": ["enrolments"], "topN": 6, "others": true, "reason": "Part-to-whole across a handful of statuses (enrolled, completed, dropped): a donut of at most six slices.", "alternatives": ["hbar", "bar"], "size": { "w": 4, "h": 4 }, "priority": 3 },
    { "id": "pass_rate_by_course", "title": "Pass rate by course", "kind": "hbar", "section": "drivers", "x": { "field": "course" }, "measures": ["pass_rate"], "topN": 15, "others": false, "minGroupRows": 20, "reason": "Which subjects students fail most: the recomputed pass rate per course, sorted, with courses under 20 results hidden.", "alternatives": ["bar"], "size": { "w": 6, "h": 5 }, "priority": 1 },
    { "id": "attendance_vs_score", "title": "Attendance vs score by student", "kind": "scatter", "section": "drivers", "x": { "field": "student_id" }, "measures": ["attendance_rate", "avg_score_pct"], "reason": "Two measures per student: a scatter shows whether students who attend more also score more, without a dual axis.", "alternatives": ["table"], "size": { "w": 6, "h": 5 }, "priority": 2 },
