    { "id": "dropout_by_program", "title": "Dropout rate by programme", "kind": "hbar", "section": "drivers", "x": { "field": "program" }, "measures": ["dropout_rate"], "topN": 12, "others": false, "minGroupRows": 20, "reason": "A rate compared across programmes: sorted bars of the recomputed dropout rate, with programmes under 20 enrolments hidden.", "alternatives": ["bar"], "size": { "w": 6, "h": 5 }, "priority": 4 },
    { "id": "fee_collection_by_grade", "title": "Fee collection rate by class", "kind": "hbar", "section": "drivers", "x": { "field": "grade_level" }, "measures": ["fee_collection_rate"], "topN": 15, "others": false, "minGroupRows": 20, "reason": "Where fees are slow to come in: the recomputed collection rate per class, sorted, with classes under 20 records hidden.", "alternatives": ["bar"], "size": { "w": 6, "h": 5 }, "priority": 5, "subDomains": ["fees", "enrolments"] },
    { "id": "course_scorecard", "title": "Course scorecard", "kind": "table", "section": "detail", "x": { "field": "course" }, "measures": ["students", "avg_score_pct", "pass_rate", "attendance_rate", "completion_rate"], "topN": 25, "others": false, "reason": "Outcomes, attendance and completion per course side by side: a sortable table carries more than any single chart.", "alternatives": ["hbar"], "size": { "w": 12, "h": 6 }, "priority": 1 }
  ],
  "pitfalls": [
    "Average score must be total marks ÷ total maximum marks; averaging percentages treats a 10-mark quiz like a 100-mark exam.",
    "Marks registers list each student once per subject and exam: count students with DISTINCT IDs, never by counting rows.",
    "Classes, sections and teachers start from different intakes: compare like with like (same class, subject and exam) before ranking (Simpson's paradox).",
    "Completion and dropout depend on how long a cohort has had: recent enrolments are still in progress, so their completion looks low (right-censoring).",
    "Small classes and courses swing wildly; treat rates from fewer than about 20 students as noise.",
    "Pass marks, grading scales and attendance rules differ between boards, universities and courses; compare only within one scheme."
  ]
}
