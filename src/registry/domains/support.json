{
  "id": "support",
  "name": "Customer Support",
  "tagline": "Ticket volume, response and resolution times, SLA, CSAT, first-contact resolution and agent workload for helpdesks",
  "description": "Ticket exports from helpdesk tools (Zendesk, Freshdesk, Jira Service Management, ServiceNow, Zoho Desk, Intercom, HubSpot, Salesforce Service Cloud), ticket-metric and SLA reports, and CSAT survey responses.",
  "icon": "headset",
  "entity": "ticket",
  "goals": ["experience", "efficiency", "quality", "retention"],
  "fields": [
    { "id": "ticket_id", "label": "Ticket ID", "roles": ["identifier", "dimension"], "synonyms": ["ticket id", "ticket number", "ticket no", "ticket", "case id", "case number", "case no", "incident id", "incident number", "request id", "request number", "issue id", "issue key", "conversation id", "interaction id", "sr number", "service request id", "complaint id", "ticket ref"], "exclude": ["status", "type", "priority", "channel", "subject", "description", "category", "created", "count", "owner"], "weight": 3, "core": true, "description": "Identifies each ticket; repeats when the file has one row per reply or event." },
    { "id": "created_at", "label": "Created at", "roles": ["datetime"], "synonyms": ["created at", "created", "created date", "created time", "creation date", "ticket created", "ticket created at", "opened at", "opened", "open date", "date opened", "date created", "submitted at", "submitted date", "logged date", "logged at", "reported at", "raised on", "request date", "received at", "created on"], "exclude": ["resolved", "closed", "solved", "response", "first", "updated", "due", "purchase", "assigned", "last", "reply", "survey"], "weight": 3, "core": true },
    { "id": "first_response_at", "label": "First response at", "roles": ["datetime"], "synonyms": ["first response at", "first response time", "first response date", "first reply at", "first replied at", "first reply time", "first responded at", "responded at", "first agent reply at", "acknowledged at", "first contact at", "initial response time", "initial response at", "initial response date"], "exclude": ["created", "resolved", "closed", "due", "updated", "modified", "assigned", "last"], "weight": 1.5 },
    { "id": "resolved_at", "label": "Resolved at", "roles": ["datetime"], "synonyms": ["resolved at", "resolved", "resolved date", "resolution date", "resolved on", "solved at", "solved date", "closed at", "closed date", "close date", "date closed", "closed on", "completed at", "date resolved", "time to resolution", "resolution time"], "exclude": ["created", "opened", "due", "first", "response", "updated", "modified", "assigned", "last"], "weight": 2 },
    { "id": "due_at", "label": "SLA due at", "roles": ["datetime"], "synonyms": ["due date", "due at", "due by", "sla due", "sla due date", "resolution due", "resolution due by", "sla deadline", "target date", "deadline", "resolve by"], "exclude": ["first", "response", "created", "purchase", "order", "birth", "invoice", "payment"], "weight": 0.8 },
    { "id": "ticket_status", "label": "Status", "roles": ["dimension"], "synonyms": ["status", "ticket status", "state", "case status", "incident state", "request status", "issue status", "current status"], "exclude": ["sla", "payment", "survey", "satisfaction", "resolution"], "valueHints": ["open", "pending", "resolved", "closed", "solved", "new", "on hold", "in progress", "waiting on customer", "escalated", "reopened", "pending customer response"], "weight": 2 },
    { "id": "priority", "label": "Priority", "roles": ["dimension"], "synonyms": ["priority", "ticket priority", "severity", "urgency", "priority level", "impact", "case priority", "sev"], "exclude": ["id", "incident", "claim", "vehicle", "injury"], "valueHints": ["low", "medium", "high", "urgent", "critical", "p1", "p2", "p3", "p4", "normal", "sev1", "sev2", "blocker", "major", "minor"], "weight": 1.5 },
    { "id": "channel", "label": "Channel", "roles": ["dimension"], "synonyms": ["channel", "ticket channel", "source", "via", "contact channel", "medium", "origin", "case origin", "submission channel", "inbound channel", "contact type", "ticket source", "contact method"], "exclude": ["id", "sla"], "valueHints": ["email", "chat", "phone", "web", "social media", "whatsapp", "twitter", "facebook", "portal", "web form", "live chat", "voice", "api", "messenger", "in app", "instagram", "sms"], "weight": 1.5 },
    { "id": "category", "label": "Category / topic", "roles": ["dimension"], "synonyms": ["category", "ticket category", "issue type", "topic", "ticket type", "type", "reason", "contact reason", "disposition", "problem type", "request type", "issue category", "case reason", "ticket subject", "subject category", "tags", "tag", "query type"], "exclude": ["priority", "channel", "status", "customer", "survey", "collision", "vehicle", "claim", "policy", "insured", "payment", "device", "account", "plan"], "weight": 1.5 },
    { "id": "agent", "label": "Agent", "roles": ["dimension"], "synonyms": ["agent", "agent name", "assignee", "assigned to", "owner", "handled by", "resolver", "support agent", "representative", "csr", "assigned agent", "case owner", "analyst", "agent email", "agent id", "resolved by", "rep"], "exclude": ["team", "group", "queue"], "weight": 1.5 },
    { "id": "team", "label": "Team / group", "roles": ["dimension"], "synonyms": ["team", "group", "queue", "support group", "assignment group", "department", "support team", "tier", "level", "pod", "skill group", "brand"], "exclude": ["agent", "priority", "escalation"], "weight": 1 },
    { "id": "customer_id", "label": "Customer", "roles": ["identifier", "dimension"], "synonyms": ["customer id", "customer", "requester", "requester id", "requester email", "customer email", "contact id", "account id", "user id", "email", "customer name", "requester name", "client id", "account name", "organization"], "exclude": ["age", "gender", "type", "segment", "satisfaction", "rating", "since"], "weight": 1 },
    { "id": "product", "label": "Product / area", "roles": ["dimension"], "synonyms": ["product", "product name", "product purchased", "product area", "module", "component", "service", "feature", "platform", "app", "application"], "exclude": ["id", "date", "type"], "weight": 0.8 },
    { "id": "csat_score", "label": "CSAT score", "roles": ["rate", "measure"], "synonyms": ["csat", "csat score", "satisfaction score", "customer satisfaction", "customer satisfaction rating", "customer satisfaction score", "rating", "satisfaction rating", "survey score", "survey rating", "feedback rating", "feedback score", "happiness rating", "score"], "exclude": ["comment", "date", "count", "offered", "nps"], "weight": 2, "description": "Survey score per ticket, usually on a 1–5 scale." },
    { "id": "satisfaction_label", "label": "Satisfaction (good / bad)", "roles": ["dimension"], "synonyms": ["satisfaction", "satisfaction rating", "csat rating", "survey response", "survey result", "feedback", "rating label", "satisfaction label", "csat result"], "exclude": ["comment", "date", "reason"], "valueHints": ["good", "bad", "satisfied", "unsatisfied", "dissatisfied", "offered", "unoffered", "positive", "negative", "neutral", "happy", "unhappy"], "weight": 1 },
    { "id": "frt_minutes", "label": "First response time (minutes)", "roles": ["measure"], "synonyms": ["first response time", "first response minutes", "first response time minutes", "first response time in minutes", "first reply time", "first reply time in minutes", "frt", "frt minutes", "time to first response", "response time", "first response mins", "reply time", "first response min"], "exclude": ["hrs", "hr", "second", "sec", "due", "sla", "status", "breach"], "weight": 2 },
    { "id": "frt_hours", "label": "First response time (hours)", "roles": ["measure"], "synonyms": ["first response time hours", "first response time hrs", "first response time in hrs", "first response time in hours", "first response hours", "frt hours", "frt hrs", "first reply time hours", "response time hours", "response time hrs"], "exclude": ["minute", "min", "mins", "due", "sla"], "weight": 1.5 },
    { "id": "resolution_hours", "label": "Resolution time (hours)", "roles": ["measure"], "synonyms": ["resolution time hours", "resolution time hrs", "resolution time in hrs", "resolution time in hours", "resolution hours", "time to resolve hours", "hours to resolve", "resolution time", "time to resolution", "time to resolve", "handling time hours", "ttr"], "exclude": ["minute", "min", "mins", "days", "due", "sla", "first"], "weight": 2 },
    { "id": "resolution_minutes", "label": "Resolution time (minutes)", "roles": ["measure"], "synonyms": ["resolution time minutes", "resolution time in minutes", "resolution minutes", "full resolution time", "full resolution time in minutes", "time to resolve minutes", "minutes to resolve", "resolution mins", "handle time minutes"], "exclude": ["hrs", "hr", "days", "due", "sla", "first"], "weight": 1.5 },
    { "id": "sla_breached", "label": "SLA breached flag", "roles": ["boolean"], "synonyms": ["sla breached", "sla breach", "breached", "sla violated", "sla missed", "is breached", "breach", "overdue", "is overdue", "sla failed", "resolution sla breached"], "exclude": ["met", "achieved", "within", "compliance", "compliant", "date", "reason"], "weight": 1.5 },
    { "id": "sla_status", "label": "SLA status", "roles": ["dimension"], "synonyms": ["sla status", "sla", "resolution status", "sla result", "sla outcome", "sla compliance", "resolution sla", "sla met"], "exclude": ["first", "response", "date", "due"], "valueHints": ["within sla", "sla violated", "violated", "breached", "met", "missed", "achieved", "on time", "overdue"], "weight": 1 },
    { "id": "reopened", "label": "Reopened flag", "roles": ["boolean"], "synonyms": ["reopened", "is reopened", "reopen", "reopen flag", "was reopened", "reopened flag", "ticket reopened"], "exclude": ["count", "date", "number"], "weight": 1 },
    { "id": "reopen_count", "label": "Reopens", "roles": ["measure"], "synonyms": ["reopens", "reopen count", "number of reopens", "times reopened", "reopened count", "no of reopens"], "weight": 0.8 },
    { "id": "escalated", "label": "Escalated flag", "roles": ["boolean"], "synonyms": ["escalated", "is escalated", "escalation", "escalation flag", "escalated flag", "was escalated"], "exclude": ["date", "reason", "level", "count"], "weight": 1 },
    { "id": "contacts", "label": "Contacts / replies per ticket", "roles": ["measure"], "synonyms": ["contacts", "number of contacts", "contact count", "interactions", "number of interactions", "replies", "agent replies", "reply count", "touches", "touchpoints", "messages", "message count", "agent interactions", "responses"], "exclude": ["first", "time", "minutes", "hours"], "weight": 1 },
    { "id": "fcr_flag", "label": "First contact resolution flag", "roles": ["boolean"], "synonyms": ["fcr", "first contact resolution", "resolved on first contact", "one touch", "one touch resolution", "first call resolution", "is fcr", "fcr flag", "single touch"], "weight": 1 },
    { "id": "region", "label": "Region / country", "roles": ["geo", "dimension"], "synonyms": ["region", "country", "location", "state", "market", "site", "geo"], "exclude": ["gender", "age", "name", "email"], "weight": 0.5 }
  ],
  "valueClasses": {
    "ticket_status": [
      { "id": "resolved", "label": "Resolved / solved", "keywords": ["resolved", "solved", "fixed", "done", "completed", "resolution provided", "answered"] },
      { "id": "closed", "label": "Closed", "keywords": ["closed", "archived", "auto closed", "auto-closed", "cancelled", "canceled", "duplicate", "spam", "merged"] },
      { "id": "pending", "label": "Pending / on hold", "keywords": ["pending", "on hold", "hold", "waiting", "waiting on customer", "waiting for customer", "awaiting", "awaiting customer", "snoozed", "pending customer response"] },
      { "id": "open", "label": "Open", "keywords": ["open", "new", "in progress", "assigned", "unassigned", "working", "reopened", "escalated", "triage", "investigating", "acknowledged", "active", "work in progress", "unresolved", "to do"] }
    ],
    "priority": [
      { "id": "urgent", "label": "Urgent / high", "keywords": ["urgent", "critical", "high", "highest", "p1", "p2", "sev1", "sev 1", "sev2", "sev 2", "blocker", "emergency", "severity 1", "severity 2"] }
    ],
    "satisfaction_label": [
      { "id": "bad", "label": "Dissatisfied", "keywords": ["bad", "unsatisfied", "dissatisfied", "not satisfied", "not good", "negative", "poor", "very poor", "unhappy", "very dissatisfied"] },
      { "id": "unrated", "label": "Survey not answered", "keywords": ["offered", "unoffered", "not offered", "no response", "unanswered", "not rated", "pending"] },
      { "id": "good", "label": "Satisfied", "keywords": ["good", "satisfied", "very satisfied", "positive", "happy", "great", "excellent", "very good"] }
    ],
    "sla_status": [
      { "id": "breached", "label": "Breached", "keywords": ["violated", "sla violated", "breached", "breach", "missed", "overdue", "failed", "not met", "outside sla", "late"] },
      { "id": "met", "label": "Met", "keywords": ["within sla", "met", "achieved", "on time", "sla met", "compliant", "in sla", "within"] }
    ]
  },
  "subDomains": [
    { "id": "tickets", "name": "Helpdesk tickets", "description": "One row per ticket with created, first-response and resolved timestamps, status, priority, channel, category and agent.", "signals": ["ticket_id", "created_at", "resolved_at", "first_response_at", "ticket_status", "priority", "channel", "category", "agent"], "grain": "ticket" },
    { "id": "ticket_metrics", "name": "Ticket metrics & SLA", "description": "One row per ticket with measured response and resolution times, SLA outcome, satisfaction and reopen or escalation flags.", "signals": ["ticket_id", "frt_minutes", "resolution_hours", "sla_breached", "csat_score", "reopened", "escalated", "contacts"], "grain": "ticket" },
    { "id": "csat", "name": "CSAT survey responses", "description": "One row per survey response with the ticket, score or good/bad answer, agent and date.", "signals": ["ticket_id", "csat_score", "satisfaction_label", "agent", "channel"], "grain": "survey response" }
  ],
  "kpis": [
    { "id": "tickets", "name": "Tickets", "definition": "Number of distinct tickets created in the period.", "formula": "Count of distinct ticket IDs", "format": "integer", "direction": "neutral", "tier": "hero", "priority": 1, "group": "Volume",
      "variants": [
        { "id": "distinct", "label": "Distinct ticket IDs", "expr": { "agg": "countDistinct", "of": "ticket_id" } },
        { "id": "rows", "label": "Row count (no ticket ID)", "expr": { "agg": "count" }, "caveat": "No ticket ID column, so every row is counted as one ticket. Check the grain." }
      ] },
    { "id": "avg_first_response", "name": "Avg first response time (minutes)", "short": "FRT", "definition": "Average minutes from ticket creation to the first agent reply.", "formula": "Average first-response time in minutes, over tickets that received a reply", "format": "number", "direction": "lower", "tier": "hero", "priority": 2, "group": "Speed",
      "variants": [
        { "id": "minutes", "label": "First-response minutes column", "expr": { "agg": "avg", "of": { "field": "frt_minutes" } } },
        { "id": "hours", "label": "First-response hours column × 60", "expr": { "op": "mul", "args": [{ "agg": "avg", "of": { "field": "frt_hours" } }, { "num": 60 }] } },
        { "id": "timestamps", "label": "First response − created (calendar days × 1,440)", "expr": { "op": "mul", "args": [{ "agg": "avg", "of": { "daysBetween": ["created_at", "first_response_at"] } }, { "num": 1440 }] }, "caveat": "Only calendar dates are compared, so a same-day reply counts as 0 minutes; map a first-response time column for precision." }
      ],
      "pitfalls": ["Business-hours and calendar-hours timers give very different numbers; keep to one basis when comparing teams."] },
    { "id": "avg_resolution_time", "name": "Avg resolution time", "definition": "Average days from ticket creation to resolution, for resolved tickets.", "formula": "Average resolution time in days (resolution hours ÷ 24)", "format": "days", "direction": "lower", "tier": "hero", "priority": 3, "group": "Speed",
      "variants": [
        { "id": "hours", "label": "Resolution hours column ÷ 24", "expr": { "op": "div", "args": [{ "agg": "avg", "of": { "field": "resolution_hours" } }, { "num": 24 }] } },
        { "id": "minutes", "label": "Resolution minutes column ÷ 1,440", "expr": { "op": "div", "args": [{ "agg": "avg", "of": { "field": "resolution_minutes" } }, { "num": 1440 }] } },
        { "id": "dates", "label": "Resolved − created date", "expr": { "agg": "avg", "of": { "daysBetween": ["created_at", "resolved_at"] } }, "caveat": "Calendar days between the created and resolved dates, so a ticket solved the same day counts as 0." }
      ],
      "pitfalls": ["Open tickets enter the average only once they resolve, so recent periods look faster than they are."] },
    { "id": "csat_pct", "name": "CSAT %", "definition": "Share of rated tickets where the customer was satisfied (4 or 5 on a 5-point scale).", "formula": "Ratings of 4 or 5 ÷ all ratings", "format": "percent", "direction": "higher", "tier": "hero", "priority": 4, "group": "Quality",
      "variants": [
        { "id": "score", "label": "Scores of 4–5 ÷ rated tickets", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "csat_score", "cmp": "gte", "value": 4 } }, { "calc": { "ref": "tickets" }, "where": { "field": "csat_score", "notNull": true } }] } },
        { "id": "label", "label": "Good answers ÷ answered surveys", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "satisfaction_label", "class": "good" } }, { "calc": { "ref": "tickets" }, "where": { "and": [{ "field": "satisfaction_label", "notNull": true }, { "field": "satisfaction_label", "notClass": "unrated" }] } }] }, "caveat": "Uses good/bad survey answers; surveys sent but not answered are left out." }
      ],
      "benchmark": { "low": 0.75, "high": 0.9, "note": "Indicative for support teams; varies by channel and industry." },
      "pitfalls": ["Assumes a 1–5 scale; on a 1–10 scale count 9–10 as satisfied instead."] },
    { "id": "sla_breach_rate", "name": "SLA breach rate", "definition": "Share of tickets that missed their SLA target.", "formula": "Tickets with an SLA breach ÷ tickets with an SLA outcome", "format": "percent", "direction": "lower", "tier": "hero", "priority": 5, "group": "Speed",
      "variants": [
        { "id": "flag", "label": "Breached flag", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "sla_breached", "isTrue": true } }, { "calc": { "ref": "tickets" }, "where": { "field": "sla_breached", "notNull": true } }] } },
        { "id": "status", "label": "SLA status", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "sla_status", "class": "breached" } }, { "calc": { "ref": "tickets" }, "where": { "field": "sla_status", "notNull": true } }] } },
        { "id": "due", "label": "Resolved after the due date", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "resolved_at", "cmpField": "gt", "other": "due_at" } }, { "calc": { "ref": "tickets" }, "where": { "and": [{ "field": "resolved_at", "notNull": true }, { "field": "due_at", "notNull": true }] } }] }, "caveat": "Measured on resolved tickets only: resolving after the due time counts as a breach, while open overdue tickets are not yet counted." }
      ] },
    { "id": "backlog", "name": "Backlog", "definition": "Tickets created in the period that are still open or pending.", "formula": "Distinct tickets whose current status is not resolved or closed", "format": "integer", "direction": "lower", "tier": "hero", "priority": 6, "group": "Volume",
      "variants": [
        { "id": "status", "label": "Status not resolved or closed", "expr": { "calc": { "ref": "tickets" }, "where": { "and": [{ "field": "ticket_status", "notClass": "resolved" }, { "field": "ticket_status", "notClass": "closed" }, { "field": "ticket_status", "notNull": true }] } } },
        { "id": "no_resolution", "label": "No resolved date", "expr": { "calc": { "ref": "tickets" }, "where": { "field": "resolved_at", "isNull": true } }, "caveat": "No status column, so tickets without a resolved date count as open." }
      ],
      "pitfalls": ["Backlog uses each ticket's current status, so it shows today's open work from tickets created in the period."] },
    { "id": "resolution_rate", "name": "Resolved %", "definition": "Share of tickets created in the period that are resolved or closed.", "formula": "Resolved tickets ÷ tickets", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 7, "group": "Volume",
      "variants": [{ "id": "ratio", "label": "Resolved ÷ tickets", "expr": { "op": "div", "args": [{ "ref": "resolved_tickets" }, { "ref": "tickets" }] } }] },
    { "id": "resolved_tickets", "name": "Resolved tickets", "definition": "Tickets created in the period that are now resolved or closed.", "formula": "Distinct tickets with a resolved or closed status", "format": "integer", "direction": "higher", "tier": "supporting", "priority": 8, "group": "Volume",
      "variants": [
        { "id": "both", "label": "Resolved or closed status", "expr": { "calc": { "ref": "tickets" }, "where": { "or": [{ "field": "ticket_status", "class": "resolved" }, { "field": "ticket_status", "class": "closed" }] } } },
        { "id": "resolved", "label": "Resolved status", "expr": { "calc": { "ref": "tickets" }, "where": { "field": "ticket_status", "class": "resolved" } } },
        { "id": "closed", "label": "Closed status", "expr": { "calc": { "ref": "tickets" }, "where": { "field": "ticket_status", "class": "closed" } } },
        { "id": "dates", "label": "Has a resolved date", "expr": { "calc": { "ref": "tickets" }, "where": { "field": "resolved_at", "notNull": true } }, "caveat": "No status column, so tickets with a resolved date count as resolved." }
      ] },
    { "id": "fcr_rate", "name": "First contact resolution", "short": "FCR", "definition": "Share of resolved tickets solved in a single contact.", "formula": "Tickets resolved with one contact ÷ resolved tickets", "format": "percent", "direction": "higher", "tier": "supporting", "priority": 9, "group": "Quality",
      "variants": [
        { "id": "flag", "label": "FCR flag", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "fcr_flag", "isTrue": true } }, { "calc": { "ref": "tickets" }, "where": { "field": "fcr_flag", "notNull": true } }] } },
        { "id": "contacts", "label": "One contact, among resolved tickets", "expr": { "op": "div", "args": [{ "calc": { "ref": "resolved_tickets" }, "where": { "field": "contacts", "cmp": "eq", "value": 1 } }, { "calc": { "ref": "resolved_tickets" }, "where": { "field": "contacts", "notNull": true } }] } },
        { "id": "contacts_all", "label": "One contact, all tickets", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "contacts", "cmp": "eq", "value": 1 } }, { "calc": { "ref": "tickets" }, "where": { "field": "contacts", "notNull": true } }] }, "caveat": "No status column, so every ticket with a contact count is included, resolved or not." }
      ],
      "benchmark": { "low": 0.7, "high": 0.79, "note": "Indicative: contact-centre studies commonly put average FCR at about 70–79%." } },
    { "id": "csat_avg", "name": "Average CSAT score", "definition": "Average satisfaction score across rated tickets.", "formula": "Average of CSAT score over rated tickets", "format": "decimal", "direction": "higher", "tier": "supporting", "priority": 10, "group": "Quality",
      "variants": [{ "id": "avg", "label": "Average score", "expr": { "agg": "avg", "of": { "field": "csat_score" } } }] },
    { "id": "reopen_rate", "name": "Reopen rate", "definition": "Share of tickets reopened at least once after being solved.", "formula": "Reopened tickets ÷ tickets", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 11, "group": "Quality",
      "variants": [
        { "id": "flag", "label": "Reopened flag ÷ tickets", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "reopened", "isTrue": true } }, { "ref": "tickets" }] } },
        { "id": "count", "label": "Reopen count above zero ÷ tickets", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "reopen_count", "cmp": "gt", "value": 0 } }, { "ref": "tickets" }] } }
      ] },
    { "id": "escalation_rate", "name": "Escalation rate", "definition": "Share of tickets escalated to a higher tier or another team.", "formula": "Escalated tickets ÷ tickets", "format": "percent", "direction": "lower", "tier": "supporting", "priority": 12, "group": "Quality",
      "variants": [{ "id": "flag", "label": "Escalated flag ÷ tickets", "expr": { "op": "div", "args": [{ "calc": { "ref": "tickets" }, "where": { "field": "escalated", "isTrue": true } }, { "ref": "tickets" }] } }] },
    { "id": "tickets_per_agent", "name": "Tickets per agent", "definition": "Tickets handled per agent active in the period.", "formula": "Tickets ÷ distinct agents", "format": "decimal", "direction": "neutral", "tier": "supporting", "priority": 13, "group": "Workload",
